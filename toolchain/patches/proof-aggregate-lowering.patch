+
+    #[test]
+    fn shader_typed_private_materialized_param_lowers_without_compound_range_panic() {
+        let source = r#"
+struct Wrapper {
+    lanes: [u32; 4],
+    valid: bool,
+}
+
+fn restore(mut _ lanes: own [u32; 4], _ index: usize, _ value: u32) -> Wrapper {
+    if index < 4 {
+        lanes[index] = value
+    }
+    Wrapper { lanes: lanes, valid: index < 4 }
+}
+
+pub fn kernel(k: u32) -> u32 {
+    let wrapped = restore([1, 2, 3, 4], (k & 3) as usize, k)
+    if wrapped.valid {
+        wrapped.lanes[(k & 3) as usize]
+    } else {
+        0
+    }
+}
+"#;
+        let mut db = DriverDataBase::default();
+        let url = Url::parse("file:///shader_typed_private_materialized_param.fe").unwrap();
+        db.workspace()
+            .touch(&mut db, url.clone(), Some(source.to_string()));
+        let file = db.workspace().get(&db, &url).unwrap();
+        let top_mod = db.top_mod(file);
+        let diagnostics = db.run_on_top_mod(top_mod).format_diags(&db);
+        assert!(diagnostics.is_empty(), "diags:\n{diagnostics}");
+        let package = mir::build_wasm_runtime_package_for_entry(&db, top_mod, "kernel")
+            .expect("shader materialized-param fixture should lower to Runtime MIR");
+        let (module, entries) = compile_runtime_package_shader_ir(&db, &package)
+            .expect("shader IR lowering should succeed for typed-private materialized params");
+        assert_eq!(entries.len(), 1);
+        let funcs = module.funcs();
+        for &func_ref in &funcs {
+            module.func_store.view(func_ref, |function| {
+                for inst_id in function
+                    .layout
+                    .iter_block()
+                    .flat_map(|b| function.layout.iter_inst(b))
+                {
+                    if sonatina_ir::inst::downcast::<&Add>(
+                        function.inst_set(),
+                        function.dfg.inst(inst_id),
+                    )
+                    .is_some()
+                    {
+                        for value_id in function.dfg.inst_results(inst_id) {
+                            let ty = function.dfg.value_ty(*value_id);
+                            assert!(
+                                !ty.is_compound(),
+                                "Add result {value_id:?} in shader function {func_ref:?} has compound type {ty:?}",
+                            );
+                        }
+                    }
+                }
+            });
+        }
+        sonatina_codegen::optim::run_function_passes_on(
+            &module,
+            &funcs,
+            &[
+                sonatina_codegen::optim::Pass::CfgCleanup,
+                sonatina_codegen::optim::Pass::RangeBranchSimplify,
+            ],
+        );
+    }
