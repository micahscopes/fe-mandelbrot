//! OKLCH construction, OKLab blending and compact storage, and sRGB display.
//! Hue uses degrees. Out-of-gamut RGB channels are clipped at display.
use core::default::Default
use core::marker::Copy
use core::ops::{Add, Div, Eq, Mul, Sub}
use algebra::{DirectExecution, Vec3, VectorExecution, interpolate}
use fmath::{cos, from_i32, sin, sqrt, to_i32}

extern {
    const fn __bitcast<From, To>(_: From) -> To
}

fn clamp(_ value: f32, _ low: f32, _ high: f32) -> f32 {
    if value < low {
        low
    } else if value > high { high } else { value }
}

/// Polar OKLCH: lightness L, non-negative chroma C, and hue in degrees.
#[derive(Eq)]
pub struct Oklch { pub l: f32, pub chroma: f32, pub hue: f32 }

impl Copy for Oklch {}

/// Cartesian OKLab: lightness L and signed chromatic axes a/b.
#[derive(Eq, Default)]
pub struct Color { pub l: f32, pub a: f32, pub b: f32 }

impl Copy for Color {}

impl Color {
    /// View Cartesian OKLab coordinates `(l, a, b)` as `Vec3<f32>`.
    pub fn to_vec(self) -> Vec3<f32> {
        Vec3 { x: self.l, y: self.a, z: self.b }
    }

    /// Construct Cartesian OKLab from a 3D coordinate vector `(l, a, b)`.
    pub fn from_vec(_ v: Vec3<f32>) -> Self {
        Self { l: v.x, a: v.y, b: v.z }
    }
}

impl Add for Color {
    type Output = Color

    fn add(own self, _ other: own Self) -> Self {
        Self::from_vec(self.to_vec() + other.to_vec())
    }
}

impl Sub for Color {
    type Output = Color

    fn sub(own self, _ other: own Self) -> Self {
        Self::from_vec(self.to_vec() - other.to_vec())
    }
}

impl Mul<f32> for Color {
    type Output = Color

    fn mul(own self, _ rhs: own f32) -> Self {
        Self::from_vec(self.to_vec() * rhs)
    }
}

impl Div<f32> for Color {
    type Output = Color

    fn div(own self, _ rhs: own f32) -> Self {
        Self::from_vec(self.to_vec() / rhs)
    }
}

/// Signed finite-angle remainder, with magnitude below one turn.
/// Large binary32 values are integers: reduce their exact significand, then
/// apply the exponent using bounded modular doubling instead of cancellation.
fn hue_remainder(_ value: f32) -> f32 {
    let bits: u32 = __bitcast<f32, u32>(value)
    let magnitude: u32 = bits & 2147483647
    if magnitude < 1135869952 {
        // 360.0, including signed zero
        return value
    }
    let exponent: u32 = (magnitude >> 23) & 255
    if exponent == 255 {
        return value // Nonfinite input is outside the finite-angle contract.
    }
    let positive: f32 = if value < 0.0 { -value } else { value }
    let reduced: f32 = if exponent < 150 {
        // Here the integer part is below 2^23 and converts exactly.
        let integer: i32 = to_i32(positive)
        let remainder: u32 = __bitcast<i32, u32>(integer) % 360
        from_i32(__bitcast<u32, i32>(remainder)) + (positive - from_i32(integer))
    } else {
        let significand: u32 = (magnitude & 8388607) | 8388608
        let mut remainder: u32 = significand % 360
        let mut shift: u32 = exponent - 150
        while shift > 0 {
            remainder = (remainder * 2) % 360
            shift = shift - 1
        }
        from_i32(__bitcast<u32, i32>(remainder))
    }
    if value < 0.0 { -reduced } else { reduced }
}

impl Oklch {
    /// Convert polar OKLCH coordinates (hue in degrees) to Cartesian OKLab.
    pub fn to_color(self) -> Color {
        let radians: f32 = self.hue * 0.017453292519943295
        Color { l: self.l, a: self.chroma * cos(radians), b: self.chroma * sin(radians) }
    }

    /// Shortest-arc interpolation in polar OKLCH coordinates.
    /// Endpoints and their difference in `[-540, 540]` retain their exact
    /// single-turn arithmetic and signed half-turn ties. Other finite endpoints use equivalent
    /// near-zero hue representatives, avoiding overflow and cancellation.
    pub fn interpolate(_ start: Oklch, _ end: Oklch, _ t: f32) -> Oklch {
        let delta: f32 = end.hue - start.hue
        let ordinary: bool = start.hue >= -540.0
            && start.hue <= 540.0
            && end.hue >= -540.0
            && end.hue <= 540.0
            && delta >= -540.0
            && delta <= 540.0
        let origin: f32 = if ordinary {
            start.hue
        } else {
            hue_remainder(start.hue)
        }
        let mut arc: f32 = if ordinary {
            delta
        } else {
            hue_remainder(end.hue) - origin
        }
        if arc > 180.0 {
            arc = arc - 360.0
        } else if arc < -180.0 {
            arc = arc + 360.0
        }
        if !ordinary {
            // Signed endpoint remainders can differ by almost two turns.
            if arc > 180.0 {
                arc = arc - 360.0
            } else if arc < -180.0 {
                arc = arc + 360.0
            }
            // Compare finite endpoints without overflowing their difference.
            if arc == -180.0 && end.hue > start.hue {
                arc = 180.0
            } else if arc == 180.0 && end.hue < start.hue {
                arc = -180.0
            }
        }
        Oklch {
            l: start.l + (end.l - start.l) * t,
            chroma: start.chroma + (end.chroma - start.chroma) * t,
            hue: origin + arc * t,
        }
    }
}

/// Construct Cartesian OKLab from lightness, chroma and hue in degrees.
pub fn oklch(_ lightness: f32, _ chroma: f32, _ hue: f32) -> Color {
    Oklch { l: lightness, chroma: chroma, hue: hue }.to_color()
}

/// Internal pixels pack L:12, a:10, b:10. They are not sRGB bytes.
/// Signed chroma spans [-0.25, 0.2495], with an exactly representable neutral.
pub fn unpack_lab(_ bits: u32) -> Color {
    Color {
        l: from_i32(__bitcast<u32, i32>(bits & 4095)) / 4095.0,
        a: (from_i32(__bitcast<u32, i32>((bits >> 12) & 1023)) - 512.0) / 2048.0,
        b: (from_i32(__bitcast<u32, i32>((bits >> 22) & 1023)) - 512.0) / 2048.0,
    }
}

pub fn pack_lab(_ c: Color) -> u32 {
    let l: u32 = __bitcast<i32, u32>(to_i32(clamp(c.l, 0.0, 1.0) * 4095.0 + 0.5))
    let a: u32 = __bitcast<i32, u32>(to_i32(clamp(c.a * 2048.0 + 512.0, 0.0, 1023.0) + 0.5))
    let b: u32 = __bitcast<i32, u32>(to_i32(clamp(c.b * 2048.0 + 512.0, 0.0, 1023.0) + 0.5))
    (l & 4095) | ((a & 1023) << 12) | ((b & 1023) << 22)
}

pub fn color(_ bits: u32) -> Color {
    unpack_lab(bits)
}

pub fn packed(_ c: Color) -> u32 {
    pack_lab(c)
}

// Ian Taylor's square-root sRGB approximation, with the exact linear toe.
// Keeps transfer work at presentation, outside orbit and Gaussian loops.
fn srgb(_ linear: f32) -> f32 {
    let x: f32 = clamp(linear, 0.0, 1.0)
    if x <= 0.0031308 {
        return 12.92 * x
    }
    let s1: f32 = sqrt(x)
    let s2: f32 = sqrt(s1)
    let s3: f32 = sqrt(s2)
    clamp(
        0.662002687 * s1 + 0.684122060 * s2 - 0.323583601 * s3 - 0.022541147 * x,
        0.0,
        1.0,
    )
}

/// Bjorn Ottosson's OKLab -> linear sRGB matrix, then display transfer.
pub fn display_rgba(_ c: Color) -> i32 {
    let lp: f32 = c.l + 0.3963377774 * c.a + 0.2158037573 * c.b
    let mp: f32 = c.l - 0.1055613458 * c.a - 0.0638541728 * c.b
    let sp: f32 = c.l - 0.0894841775 * c.a - 1.2914855480 * c.b
    let l: f32 = lp * lp * lp
    let m: f32 = mp * mp * mp
    let s: f32 = sp * sp * sp
    let r: u32 = __bitcast<i32, u32>(
        to_i32(
            srgb(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s) * 255.0 + 0.5,
        ),
    )
    let g: u32 = __bitcast<i32, u32>(
        to_i32(
            srgb(-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s) * 255.0 + 0.5,
        ),
    )
    let b: u32 = __bitcast<i32, u32>(
        to_i32(
            srgb(-0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s) * 255.0 + 0.5,
        ),
    )
    __bitcast<u32, i32>(
        (r & 255) | ((g & 255) << 8) | ((b & 255) << 16) | 4278190080,
    )
}

pub fn rgba(_ c: Color) -> i32 {
    display_rgba(c)
}

pub fn blend(_ a: Color, _ b: Color, _ t: f32) -> Color {
    let coordinates = with (VectorExecution<Vec3<f32>, f32> = DirectExecution {}) {
        interpolate(a.to_vec(), b.to_vec(), t)
    }
    Color::from_vec(coordinates)
}
