/// Pass 23: Divide the 4 AIR constraint numerator families by their trace-domain
/// zerofiers on the coset LDE domain.
pub fn project_air_composition_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
)
where TRACE > 0, TRACE > 1, { (TRACE & (TRACE - 1)) == 0 }
{
    let evaluation = invocation.global.x
    if evaluation >= LDE.downcast_truncate() { return }
    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let challenge = load_ext4_at(proof, layout.composition_challenge)
    let fold708 = load_composition_fold_at<708, FRI_SCRATCH_WORDS>(
        scratch,
        scratch_layout.composition_fold,
        challenge,
        evaluation,
    )
    let checkpoint = restore_constraint_numerator_checkpoint(
        fold708,
        load_composition_family_at(
            scratch,
            scratch_layout.composition_all_rows,
            evaluation,
        ),
        load_composition_family_at(
            scratch,
            scratch_layout.composition_pair_rows,
            evaluation,
        ),
        load_composition_family_at(
            scratch,
            scratch_layout.composition_first_row,
            evaluation,
        ),
    )
    let point = BabyBear::from_u32(7)
        * BabyBear::two_adic_root(FRI_ROUNDS.downcast_truncate()).pow_u32(evaluation)
    let composed: CompositionValue<BabyBearExt4> =
        composition_value<BabyBearExt4, TRACE>(
            BabyBearExt4::from_base(point),
            constraint_numerators_from_checkpoint(checkpoint),
        )
    store_ext4_at(
        proof,
        layout.composition_values
            + evaluation * EXTENSION_WORDS.downcast_truncate(),
        composed.value,
    )
    let fold_valid =
        scratch.load(index: scratch_layout.composition_fold_valid + evaluation) == 1
    proof.store(
        index: layout.composition_value_valid + evaluation,
        value: if composed.valid && fold_valid { 1 } else { 0 },
    )
}

/// Pass 24: Commit all `LDE` quartic composition evaluations into `composition_tree`
/// leaf `row` and reset `tree_progress`.
pub fn commit_composition_leaves_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let row = invocation.global.x
    let lde_width: u32 = LDE.downcast_truncate()
    if row >= lde_width { return }

    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    scratch.store(index: scratch_layout.tree_progress + row, value: 0)

    let value = load_ext4_at(
        proof,
        layout.composition_values + row * EXTENSION_WORDS.downcast_truncate(),
    )
    let input_valid = proof.load(index: layout.composition_value_valid + row) == 1
    let mut sponge = Poseidon2FieldSponge::begin_tag(composition_row_domain_tag(), 4)
    let block = [
        value.coefficient_0(),
        value.coefficient_1(),
        value.coefficient_2(),
        value.coefficient_3(),
        BabyBear::zero(),
        BabyBear::zero(),
        BabyBear::zero(),
        BabyBear::zero(),
    ]
    sponge.absorb_scheduled_block(ref block, 4, true)
    let committed = sponge.finish_scheduled().require(input_valid)
    let stride_nodes = chunk_tree_stride_nodes(LDE).downcast_truncate()
    let node = tree_node_index(stride_nodes, 0, 0, row)
    store_tree_digest_at(
        scratch,
        scratch_layout.tree_digests,
        node,
        committed.digest(),
    )
    scratch.store(
        index: scratch_layout.tree_valid + node,
        value: if committed.is_valid() { 1 } else { 0 },
    )
}

/// Pass 25: Reduce `composition_tree` across `Repeat<..., LDE_LOG>` and store
/// `composition_root`.
pub fn reduce_composition_tree_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let parent = invocation.global.x
    let lde_width: u32 = LDE.downcast_truncate()
    if parent >= lde_width / 2 { return }

    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let level = scratch.load(index: scratch_layout.tree_progress + parent)
    if level >= FRI_ROUNDS.downcast_truncate() { return }

    let child_width = lde_width >> level
    let parent_width = child_width / 2
    if parent < parent_width {
        let child_offset = tree_level_offset(lde_width, level)
        let parent_offset = child_offset + child_width
        let stride_nodes = chunk_tree_stride_nodes(LDE).downcast_truncate()
        let left = tree_node_index(stride_nodes, 0, 0, child_offset + 2 * parent)
        let right = left + 1
        let node = tree_node_index(stride_nodes, 0, 0, parent_offset + parent)
        let valid = scratch.load(index: scratch_layout.tree_valid + left) == 1
            && scratch.load(index: scratch_layout.tree_valid + right) == 1
        let digest = if valid {
            compress(
                load_tree_digest_at(scratch, scratch_layout.tree_digests, left),
                load_tree_digest_at(scratch, scratch_layout.tree_digests, right),
            )
        } else {
            Poseidon2Digest::zero()
        }
        let valid_word: u32 = if valid { 1 } else { 0 }
        store_tree_digest_at(scratch, scratch_layout.tree_digests, node, digest)
        scratch.store(index: scratch_layout.tree_valid + node, value: valid_word)

        if level + 1 == FRI_ROUNDS.downcast_truncate() {
            store_digest_at(proof, layout.composition_root, digest)
            proof.store(index: layout.composition_valid + 1, value: valid_word)
        }
    }

    scratch.store(index: scratch_layout.tree_progress + parent, value: level + 1)
}

/// Pass 26: Bind `(air_transcript, composition_root)` into `composition_transcript`,
/// seed `fri_transcripts[variant, 0]`, reset `round_cursor = 0`, and materialize
/// all `FRI_ROUNDS` round placements into `fri_scratch`.
pub fn initialize_fri_schedule_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
    Schedule: FriSchedulePlacement,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.global.x
    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)

    if lane < FRI_ROUNDS.downcast_truncate() {
        store_fri_round_placement_at(
            scratch,
            scratch_layout.round_placements,
            lane,
            <Schedule as FriSchedulePlacement>::fri_round_placement(lane),
        )
    }

    if lane != 0 { return }

    let left = load_digest_at(proof, layout.air_transcript)
    let right = load_digest_at(proof, layout.composition_root)
    let input_valid = proof.load(index: layout.air_transcript_valid) == 1
        && proof.load(index: layout.composition_valid + 1) == 1
    let mut sponge = Poseidon2FieldSponge::begin_tag(
        composition_transcript_domain_tag(),
        16,
    )
    let mut block_step: u32 = 0
    while block_step < 3 {
        let count: u32 = if block_step == 0 { 6 } else if block_step == 1 { 8 } else { 2 }
        let final_block = block_step == 2
        let block = if block_step == 0 {
            [
                left.field(0),
                left.field(1),
                left.field(2),
                left.field(3),
                left.field(4),
                left.field(5),
                BabyBear::zero(),
                BabyBear::zero(),
            ]
        } else if block_step == 1 {
            [
                left.field(6),
                left.field(7),
                right.field(0),
                right.field(1),
                right.field(2),
                right.field(3),
                right.field(4),
                right.field(5),
            ]
        } else {
            [
                right.field(6),
                right.field(7),
                BabyBear::zero(),
                BabyBear::zero(),
                BabyBear::zero(),
                BabyBear::zero(),
                BabyBear::zero(),
                BabyBear::zero(),
            ]
        }
        sponge.absorb_scheduled_block(ref block, count, final_block)
        block_step = block_step + 1
    }
    let committed = sponge.finish_scheduled().require(input_valid)
    let digest = committed.digest()
    let valid_word: u32 = if committed.is_valid() { 1 } else { 0 }
    store_digest_at(proof, layout.composition_transcript, digest)
    proof.store(index: layout.composition_valid + 2, value: valid_word)

    let transcripts_per_variant: u32 = (FRI_ROUNDS + 1).downcast_truncate()
    let mut variant: u32 = 0
    while variant < FRI_VARIANTS.downcast_truncate() {
        let transcript_index = variant * transcripts_per_variant
        store_digest_at(
            proof,
            layout.fri_transcripts
                + transcript_index * DIGEST_FIELDS.downcast_truncate(),
            digest,
        )
        proof.store(
            index: layout.fri_transcript_valid + transcript_index,
            value: valid_word,
        )
        variant = variant + 1
    }

    scratch.store(index: scratch_layout.round_cursor, value: 0)
}

#[inline(always)]
fn fri_shift(_ round_index: u32) -> BabyBear {
    let mut shift = BabyBear::from_u32(7)
    let mut index: u32 = 0
    while index < round_index {
        shift = shift * shift
        index = index + 1
    }
    shift
}

#[inline(always)]
fn fri_placement_is_valid(
    _ placement: FriRoundPlacement,
    _ round_index: u32,
    _ lde: usize,
    _ fri_rounds: usize,
) -> bool {
    placement.valid
        && placement.index == round_index
        && placement.round == round_index + 1
        && placement.output_width > 0
        && placement.input_width == 2 * placement.output_width
        && placement.output_offset + placement.output_width
            <= chunk_folded_evaluations(lde).downcast_truncate()
        && placement.tree_nodes == 2 * placement.output_width - 1
        && placement.tree_offset + placement.tree_nodes
            <= chunk_layer_tree_nodes(lde, fri_rounds).downcast_truncate()
}

/// Pass 27 (Cycled): Squeeze `fri_challenges[variant, round_index]` from
/// `fri_transcripts[variant, round_index]` for both variants.
pub fn fri_squeeze_challenge_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
) {
    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let round_index = scratch.load(index: scratch_layout.round_cursor)
    if round_index >= FRI_ROUNDS.downcast_truncate() { return }

    let placement = load_fri_round_placement_at(
        scratch,
        scratch_layout.round_placements,
        round_index,
    )
    let schedule_valid = fri_placement_is_valid(
        placement,
        round_index,
        LDE,
        FRI_ROUNDS,
    )
    let rounds_per_variant: u32 = FRI_ROUNDS.downcast_truncate()
    let transcripts_per_variant: u32 = (FRI_ROUNDS + 1).downcast_truncate()

    let mut variant: u32 = 0
    while variant < FRI_VARIANTS.downcast_truncate() {
        let transcript_index = variant * transcripts_per_variant + round_index
        let transcript = load_digest_at(
            proof,
            layout.fri_transcripts
                + transcript_index * DIGEST_FIELDS.downcast_truncate(),
        )
        let input_valid = schedule_valid
            && proof.load(index: layout.fri_transcript_valid + transcript_index) == 1
        let mut sponge = Poseidon2FieldSponge::begin_tag(
            fri_fold_domain_tag(placement.round),
            DIGEST_FIELDS.downcast_truncate(),
        )
        let mut block_step: u32 = 0
        while block_step < 2 {
            let count: u32 = if block_step == 0 { 6 } else { 2 }
            let final_block = block_step == 1
            let block = if block_step == 0 {
                [
                    transcript.field(0),
                    transcript.field(1),
                    transcript.field(2),
                    transcript.field(3),
                    transcript.field(4),
                    transcript.field(5),
                    BabyBear::zero(),
                    BabyBear::zero(),
                ]
            } else {
                [
                    transcript.field(6),
                    transcript.field(7),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                ]
            }
            sponge.absorb_scheduled_block(ref block, count, final_block)
            block_step = block_step + 1
        }
        let committed = sponge.finish_scheduled().require(input_valid)
        let digest = committed.digest()
        let round_value_index = variant * rounds_per_variant + round_index
        let challenge_base = layout.fri_challenges
            + round_value_index * EXTENSION_WORDS.downcast_truncate()
        let mut c: u32 = 0
        while c < EXTENSION_WORDS.downcast_truncate() {
            proof.store(
                index: challenge_base + c,
                value: digest.field(c).to_u32(),
            )
            c = c + 1
        }
        proof.store(
            index: layout.fri_challenge_valid + round_value_index,
            value: if committed.is_valid() { 1 } else { 0 },
        )
        variant = variant + 1
    }
}

/// Pass 28 (Cycled + Tapered): Fold `(positive, negative)` pairs for both
/// variants in parallel, commit each folded quartic value into its layer Merkle
/// tree leaf, and reset `tree_progress`.
pub fn fri_fold_and_commit_leaves_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ tamper: f32,
    _ invocation: ComputeInvocation,
) {
    fri_fold_and_commit_leaves_at_layout(
        proof, scratch, tamper, invocation,
        LDE, FRI_ROUNDS,
        proof_chunk_layout(TRACE, LDE, FRI_ROUNDS),
        fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS),
    )
}

// Canonical layouts are shape data. Compute them once during Fe compilation,
// then select values without re-running checked layout arithmetic on every lane.
const SHARED_FRI_PROOF_LAYOUT_16: ProofChunkLayout = proof_chunk_layout(16, 64, 6)
const SHARED_FRI_PROOF_LAYOUT_64: ProofChunkLayout = proof_chunk_layout(64, 256, 8)
const SHARED_FRI_SCRATCH_LAYOUT_16: FriScratchChunkLayout = fri_scratch_chunk_layout(16, 64, 6)
const SHARED_FRI_SCRATCH_LAYOUT_64: FriScratchChunkLayout = fri_scratch_chunk_layout(64, 256, 8)

/// Experimental cross-shape entry seam. Only the two validated experiment
/// shapes are accepted; canonical offsets are derived by Fe, never supplied by
/// the host. Both shapes use the same physical buffer capacities and grid.
/// Unsupported shapes/capacities produce no writes and return false.
/// True means shape/capacity accepted; schedule/challenge validity remains in
/// the existing per-value channels. Scratch placements must be Fe-produced.
pub fn fri_fold_and_commit_leaves_shared_shape<
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ trace: u32,
    _ tamper: f32,
    _ invocation: ComputeInvocation,
) -> bool {
    if trace != 16 && trace != 64 { return false }
    let lde: usize = if trace == 16 { 64 } else { 256 }
    let fri_rounds: usize = if trace == 16 { 6 } else { 8 }
    let layout = if trace == 16 { SHARED_FRI_PROOF_LAYOUT_16 } else { SHARED_FRI_PROOF_LAYOUT_64 }
    let scratch_layout = if trace == 16 { SHARED_FRI_SCRATCH_LAYOUT_16 } else { SHARED_FRI_SCRATCH_LAYOUT_64 }
    if layout.total_words > PROOF_WORDS.downcast_truncate()
        || scratch_layout.total_words > FRI_SCRATCH_WORDS.downcast_truncate() {
        return false
    }
    fri_fold_and_commit_leaves_at_layout(
        proof, scratch, tamper, invocation, lde, fri_rounds, layout, scratch_layout,
    )
    true
}

fn fri_fold_and_commit_leaves_at_layout<
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ tamper: f32,
    _ invocation: ComputeInvocation,
    _ lde: usize,
    _ fri_rounds: usize,
    _ layout: ProofChunkLayout,
    _ scratch_layout: FriScratchChunkLayout,
) {
    let global_lane = invocation.global.x
    let round_index = scratch.load(index: scratch_layout.round_cursor)
    if round_index >= fri_rounds.downcast_truncate() { return }

    let placement = load_fri_round_placement_at(
        scratch,
        scratch_layout.round_placements,
        round_index,
    )
    let output_width = placement.output_width
    if global_lane >= 2 * output_width { return }

    scratch.store(index: scratch_layout.tree_progress + global_lane, value: 0)

    let schedule_valid = fri_placement_is_valid(
        placement,
        round_index,
        lde,
        fri_rounds,
    )
    let variant = global_lane / output_width
    let pair = global_lane % output_width
    let dest_base = if variant == 0 {
        layout.fri_clean
    } else {
        layout.fri_observed
    }
    let mut positive = BabyBearExt4::zero()
    let mut negative = BabyBearExt4::zero()
    if round_index == 0 {
        positive = load_ext4_at(
            proof,
            layout.composition_values
                + pair * EXTENSION_WORDS.downcast_truncate(),
        )
        negative = load_ext4_at(
            proof,
            layout.composition_values
                + (pair + output_width) * EXTENSION_WORDS.downcast_truncate(),
        )
        if variant == 1 && tamper >= 0.5 && pair == 1 {
            positive = BabyBearExt4::from_coordinate_fields(
                positive.coefficient_0(),
                positive.coefficient_1() + BabyBear::one(),
                positive.coefficient_2(),
                positive.coefficient_3(),
            )
        }
    } else {
        let previous = placement.output_offset - placement.input_width
        positive = load_ext4_at(
            proof,
            dest_base + (previous + pair) * EXTENSION_WORDS.downcast_truncate(),
        )
        negative = load_ext4_at(
            proof,
            dest_base
                + (previous + pair + output_width)
                    * EXTENSION_WORDS.downcast_truncate(),
        )
    }

    let rounds_per_variant: u32 = fri_rounds.downcast_truncate()
    let round_value_index = variant * rounds_per_variant + round_index
    let challenge = load_ext4_at(
        proof,
        layout.fri_challenges
            + round_value_index * EXTENSION_WORDS.downcast_truncate(),
    )
    let value_valid = schedule_valid
        && proof.load(index: layout.fri_challenge_valid + round_value_index) == 1
    let folded = if value_valid {
        let root = BabyBear::two_adic_root(placement.input_log)
        fold_fri_pair_value_at_point(
            positive,
            negative,
            challenge,
            fri_shift(round_index) * root.pow_u32(pair),
        )
    } else {
        BabyBearExt4::zero()
    }
    store_ext4_at(
        proof,
        dest_base
            + (placement.output_offset + pair)
                * EXTENSION_WORDS.downcast_truncate(),
        folded,
    )

    let mut sponge = Poseidon2FieldSponge::begin_tag(
        fri_layer_row_domain_tag(placement.round),
        4,
    )
    let block = [
        folded.coefficient_0(),
        folded.coefficient_1(),
        folded.coefficient_2(),
        folded.coefficient_3(),
        BabyBear::zero(),
        BabyBear::zero(),
        BabyBear::zero(),
        BabyBear::zero(),
    ]
    sponge.absorb_scheduled_block(ref block, 4, true)
    let committed = sponge.finish_scheduled().require(value_valid)
    let stride_nodes = chunk_tree_stride_nodes(lde).downcast_truncate()
    let node = tree_node_index(stride_nodes, variant, placement.tree_offset, pair)
    store_tree_digest_at(
        scratch,
        scratch_layout.tree_digests,
        node,
        committed.digest(),
    )
    scratch.store(
        index: scratch_layout.tree_valid + node,
        value: if committed.is_valid() { 1 } else { 0 },
    )
}

/// Pass 29 (Cycled + Tapered Repeat): Reduce the current FRI round's Merkle
/// trees for both variants across `placement.pair_depth + 1` levels.
pub fn fri_reduce_layer_tree_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let task = invocation.global.x
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let round_index = scratch.load(index: scratch_layout.round_cursor)
    if round_index >= FRI_ROUNDS.downcast_truncate() { return }

    let placement = load_fri_round_placement_at(
        scratch,
        scratch_layout.round_placements,
        round_index,
    )
    let output_width = placement.output_width
    if output_width <= 1 || task >= output_width { return }

    let tree_depth = placement.pair_depth + 1
    let level = scratch.load(index: scratch_layout.tree_progress + task)
    if level >= tree_depth { return }

    let child_width = output_width >> level
    let parent_width = child_width / 2
    if task < 2 * parent_width {
        let variant = task / parent_width
        let parent = task % parent_width
        let child_offset = tree_level_offset(output_width, level)
        let parent_offset = child_offset + child_width
        let stride_nodes = chunk_tree_stride_nodes(LDE).downcast_truncate()
        let left = tree_node_index(
            stride_nodes,
            variant,
            placement.tree_offset,
            child_offset + 2 * parent,
        )
        let right = left + 1
        let node = tree_node_index(
            stride_nodes,
            variant,
            placement.tree_offset,
            parent_offset + parent,
        )
        let valid = scratch.load(index: scratch_layout.tree_valid + left) == 1
            && scratch.load(index: scratch_layout.tree_valid + right) == 1
        let digest = if valid {
            compress(
                load_tree_digest_at(scratch, scratch_layout.tree_digests, left),
                load_tree_digest_at(scratch, scratch_layout.tree_digests, right),
            )
        } else {
            Poseidon2Digest::zero()
        }
        store_tree_digest_at(scratch, scratch_layout.tree_digests, node, digest)
        scratch.store(
            index: scratch_layout.tree_valid + node,
            value: if valid { 1 } else { 0 },
        )
    }

    scratch.store(index: scratch_layout.tree_progress + task, value: level + 1)
}

/// Pass 30 (Cycled): Record the current FRI round's Merkle root from the top
/// tree node, bind `(fri_transcripts[variant, round_index], root)` into
/// `fri_transcripts[variant, round_index + 1]`, and advance `round_cursor`.
pub fn fri_bind_round_transcript_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
) {
    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let round_index = scratch.load(index: scratch_layout.round_cursor)
    if round_index >= FRI_ROUNDS.downcast_truncate() { return }

    let placement = load_fri_round_placement_at(
        scratch,
        scratch_layout.round_placements,
        round_index,
    )
    let schedule_valid = fri_placement_is_valid(
        placement,
        round_index,
        LDE,
        FRI_ROUNDS,
    )
    let stride_nodes = chunk_tree_stride_nodes(LDE).downcast_truncate()
    let rounds_per_variant: u32 = FRI_ROUNDS.downcast_truncate()
    let transcripts_per_variant: u32 = (FRI_ROUNDS + 1).downcast_truncate()

    let mut variant: u32 = 0
    while variant < FRI_VARIANTS.downcast_truncate() {
        let root_node = tree_node_index(
            stride_nodes,
            variant,
            placement.tree_offset,
            placement.tree_nodes - 1,
        )
        let root = load_tree_digest_at(
            scratch,
            scratch_layout.tree_digests,
            root_node,
        )
        let root_valid = schedule_valid
            && scratch.load(index: scratch_layout.tree_valid + root_node) == 1
        let round_value_index = variant * rounds_per_variant + round_index
        store_digest_at(
            proof,
            layout.fri_roots
                + round_value_index * DIGEST_FIELDS.downcast_truncate(),
            root,
        )
        proof.store(
            index: layout.fri_root_valid + round_value_index,
            value: if root_valid { 1 } else { 0 },
        )

        let transcript_index = variant * transcripts_per_variant + round_index
        let transcript = load_digest_at(
            proof,
            layout.fri_transcripts
                + transcript_index * DIGEST_FIELDS.downcast_truncate(),
        )
        let input_valid = root_valid
            && proof.load(index: layout.fri_transcript_valid + transcript_index) == 1
        let mut sponge = Poseidon2FieldSponge::begin_tag(
            fri_layer_transcript_domain_tag(placement.round),
            16,
        )
        let mut block_step: u32 = 0
        while block_step < 3 {
            let count: u32 = if block_step == 0 {
                6
            } else if block_step == 1 {
                8
            } else {
                2
            }
            let final_block = block_step == 2
            let block = if block_step == 0 {
                [
                    transcript.field(0),
                    transcript.field(1),
                    transcript.field(2),
                    transcript.field(3),
                    transcript.field(4),
                    transcript.field(5),
                    BabyBear::zero(),
                    BabyBear::zero(),
                ]
            } else if block_step == 1 {
                [
                    transcript.field(6),
                    transcript.field(7),
                    root.field(0),
                    root.field(1),
                    root.field(2),
                    root.field(3),
                    root.field(4),
                    root.field(5),
                ]
            } else {
                [
                    root.field(6),
                    root.field(7),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                ]
            }
            sponge.absorb_scheduled_block(ref block, count, final_block)
            block_step = block_step + 1
        }
        let committed = sponge.finish_scheduled().require(input_valid)
        let next_transcript = transcript_index + 1
        let valid_word: u32 = if committed.is_valid() { 1 } else { 0 }
        store_digest_at(
            proof,
            layout.fri_transcripts
                + next_transcript * DIGEST_FIELDS.downcast_truncate(),
            committed.digest(),
        )
        proof.store(
            index: layout.fri_transcript_valid + next_transcript,
            value: valid_word,
        )
        proof.store(
            index: layout.fri_round_valid + round_value_index,
            value: valid_word,
        )
        variant = variant + 1
    }

    scratch.store(index: scratch_layout.round_cursor, value: round_index + 1)
}

/// Pass 31: Sample the Fiat-Shamir query index (`query_identity = 1`) from the
/// final FRI transcript for both variants.
pub fn sample_fri_queries_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
) {
    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let transcripts_per_variant: u32 = (FRI_ROUNDS + 1).downcast_truncate()
    let half_mask: u32 = (LDE / 2 - 1).downcast_truncate()

    let mut variant: u32 = 0
    while variant < FRI_VARIANTS.downcast_truncate() {
        let transcript_index =
            variant * transcripts_per_variant + FRI_ROUNDS.downcast_truncate()
        let transcript = load_digest_at(
            proof,
            layout.fri_transcripts
                + transcript_index * DIGEST_FIELDS.downcast_truncate(),
        )
        let input_valid =
            proof.load(index: layout.fri_transcript_valid + transcript_index) == 1
        let mut sponge = Poseidon2FieldSponge::begin_tag(
            fri_query_domain_tag(),
            (DIGEST_FIELDS + 1).downcast_truncate(),
        )
        let mut block_step: u32 = 0
        while block_step < 2 {
            let count: u32 = if block_step == 0 { 6 } else { 3 }
            let final_block = block_step == 1
            let block = if block_step == 0 {
                [
                    transcript.field(0),
                    transcript.field(1),
                    transcript.field(2),
                    transcript.field(3),
                    transcript.field(4),
                    transcript.field(5),
                    BabyBear::zero(),
                    BabyBear::zero(),
                ]
            } else {
                [
                    transcript.field(6),
                    transcript.field(7),
                    BabyBear::from_u32(1),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                ]
            }
            sponge.absorb_scheduled_block(ref block, count, final_block)
            block_step = block_step + 1
        }
        let committed = sponge.finish_scheduled().require(input_valid)
        let query_index = committed.digest().field(0).to_u32() & half_mask
        proof.store(index: layout.fri_query_indices + variant, value: query_index)
        proof.store(
            index: layout.fri_query_index_valid + variant,
            value: if committed.is_valid() { 1 } else { 0 },
        )
        variant = variant + 1
    }
}

/// Pass 32: Extract all opened evaluations (`2 * FRI_ROUNDS - 1` per variant)
/// and authentication siblings (`(FRI_ROUNDS - 2) * (FRI_ROUNDS - 1)` per variant)
/// across all `FRI_ROUNDS` layers.
pub fn extract_fri_queries_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.global.x
    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let query_evals: u32 = chunk_query_evaluations(FRI_ROUNDS).downcast_truncate()
    let query_siblings: u32 = chunk_query_path_siblings(FRI_ROUNDS).downcast_truncate()
    let eval_words_per_variant: u32 = query_evals * EXTENSION_WORDS.downcast_truncate()
    let sibling_words_per_variant: u32 = query_siblings * DIGEST_FIELDS.downcast_truncate()
    let variants: u32 = FRI_VARIANTS.downcast_truncate()
    let evaluation_words: u32 = variants * eval_words_per_variant
    let sibling_words: u32 = variants * sibling_words_per_variant

    if lane < evaluation_words {
        let variant = lane / eval_words_per_variant
        let local = lane % eval_words_per_variant
        let opening = local / EXTENSION_WORDS.downcast_truncate()
        let coefficient = local % EXTENSION_WORDS.downcast_truncate()
        let query = proof.load(index: layout.fri_query_indices + variant)
        let mut cursor = begin_fri_query_evaluation_cursor(opening, query)
        let mut r: u32 = 0
        while r < FRI_ROUNDS.downcast_truncate() {
            cursor = advance_fri_query_evaluation_cursor(
                cursor,
                load_fri_round_placement_at(
                    scratch,
                    scratch_layout.round_placements,
                    r,
                ),
            )
            r = r + 1
        }
        let placement = finish_fri_query_evaluation_cursor(cursor)
        let source_base = if variant == 0 {
            layout.fri_clean
        } else {
            layout.fri_observed
        }
        let folded_evals: u32 = chunk_folded_evaluations(LDE).downcast_truncate()
        let placement_valid =
            placement.valid && placement.evaluation_index < folded_evals
        let value = if placement_valid {
            proof.load(
                index: source_base
                    + placement.evaluation_index * EXTENSION_WORDS.downcast_truncate()
                    + coefficient,
            )
        } else {
            0
        }
        proof.store(index: layout.fri_query_evaluations + lane, value: value)
        scratch.store(
            index: scratch_layout.query_copy_valid + lane,
            value: if placement_valid && value < BABY_BEAR_MODULUS { 1 } else { 0 },
        )
    } else if lane < evaluation_words + sibling_words {
        let sibling_lane = lane - evaluation_words
        let variant = sibling_lane / sibling_words_per_variant
        let local = sibling_lane % sibling_words_per_variant
        let sibling = local / DIGEST_FIELDS.downcast_truncate()
        let field = local % DIGEST_FIELDS.downcast_truncate()
        let query = proof.load(index: layout.fri_query_indices + variant)
        let mut cursor = begin_fri_query_sibling_cursor(sibling, query)
        let mut r: u32 = 0
        while r < FRI_ROUNDS.downcast_truncate() {
            cursor = advance_fri_query_sibling_cursor(
                cursor,
                load_fri_round_placement_at(
                    scratch,
                    scratch_layout.round_placements,
                    r,
                ),
            )
            r = r + 1
        }
        let placement = finish_fri_query_sibling_cursor(cursor)
        let layer_nodes: u32 =
            chunk_layer_tree_nodes(LDE, FRI_ROUNDS).downcast_truncate()
        let stride_nodes = chunk_tree_stride_nodes(LDE).downcast_truncate()
        let node = tree_node_index(stride_nodes, variant, 0, placement.tree_node)
        let placement_valid = placement.valid
            && placement.tree_node < layer_nodes
            && scratch.load(index: scratch_layout.tree_valid + node) == 1
        let value = if placement_valid {
            scratch.load(
                index: scratch_layout.tree_digests
                    + node * DIGEST_FIELDS.downcast_truncate() + field,
            )
        } else {
            0
        }
        proof.store(index: layout.fri_query_siblings + sibling_lane, value: value)
        scratch.store(
            index: scratch_layout.query_copy_valid + lane,
            value: if placement_valid && value < BABY_BEAR_MODULUS { 1 } else { 0 },
        )
    }
}

#[inline(always)]
fn packed_rgba(_ red: u32, _ green: u32, _ blue: u32) -> i32 {
    (4278190080 | (blue << 16) | (green << 8) | red).downcast_truncate()
}

#[inline(always)]
fn status_word(_ ok: bool, _ tampered: bool) -> u32 {
    if !ok {
        packed_rgba(236, 92, 112).downcast_truncate()
    } else if tampered {
        packed_rgba(255, 176, 222).downcast_truncate()
    } else {
        packed_rgba(87, 117, 226).downcast_truncate()
    }
}

/// Pass 33: Validate all stage flags and write status/display words.
pub fn finalize_proof_status_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ tamper: f32,
) {
    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let tampered = tamper >= 0.5

    let mut trace_valid = proof.load(index: layout.trace_valid) == 1
    let mut row: u32 = 0
    while row < TRACE.downcast_truncate() {
        if scratch.load(index: scratch_layout.row_aux_valid + row) != 1 {
            trace_valid = false
        }
        row = row + 1
    }

    let mut lde_valid = true
    let mut col: u32 = 0
    while col < AIR_COLUMN_COUNT.downcast_truncate() {
        if proof.load(index: layout.air_lde_valid + col) != 1 {
            lde_valid = false
        }
        col = col + 1
    }

    let public_digest = load_digest_at(proof, layout.public_digest)
    let main_trace_root = load_digest_at(proof, layout.main_trace_root)
    let aux_trace_root = load_digest_at(proof, layout.auxiliary_trace_root)
    let main_lde_root = load_digest_at(proof, layout.main_lde_root)
    let aux_lde_root = load_digest_at(proof, layout.auxiliary_lde_root)
    let air_transcript = load_digest_at(proof, layout.air_transcript)
    let composition_root = load_digest_at(proof, layout.composition_root)
    let composition_transcript = load_digest_at(proof, layout.composition_transcript)

    let production_trace_valid =
        proof.load(index: layout.production_trace_digest_valid) == 1
            && proof.load(index: layout.production_trace_digest_valid + 1) == 1
            && proof.load(index: layout.production_trace_digest_valid + 2) == 1
            && !public_digest.equals(Poseidon2Digest::zero())
            && !main_trace_root.equals(Poseidon2Digest::zero())
            && !aux_trace_root.equals(Poseidon2Digest::zero())

    let air_roots_valid =
        proof.load(index: layout.air_lde_root_valid) == 1
            && proof.load(index: layout.air_lde_root_valid + 1) == 1
            && !main_lde_root.equals(Poseidon2Digest::zero())
            && !aux_lde_root.equals(Poseidon2Digest::zero())

    let production_transcript_valid =
        proof.load(index: layout.air_transcript_valid) == 1
            && !air_transcript.equals(Poseidon2Digest::zero())

    let mut composition_valid =
        proof.load(index: layout.composition_valid) == 1
            && proof.load(index: layout.composition_valid + 1) == 1
            && proof.load(index: layout.composition_valid + 2) == 1
            && !composition_root.equals(Poseidon2Digest::zero())
            && !composition_transcript.equals(Poseidon2Digest::zero())
    let mut eval_idx: u32 = 0
    while eval_idx < LDE.downcast_truncate() {
        if proof.load(index: layout.composition_value_valid + eval_idx) != 1 {
            composition_valid = false
        }
        eval_idx = eval_idx + 1
    }

    let root_nonzero = production_trace_valid
        && air_roots_valid
        && production_transcript_valid
        && composition_valid

    let mut fri_valid = scratch.load(index: scratch_layout.round_cursor)
        == FRI_ROUNDS.downcast_truncate()
    let total_valid_rounds: u32 = (FRI_VARIANTS * FRI_ROUNDS).downcast_truncate()
    let mut r_idx: u32 = 0
    while r_idx < total_valid_rounds {
        if proof.load(index: layout.fri_challenge_valid + r_idx) != 1
            || proof.load(index: layout.fri_root_valid + r_idx) != 1
            || proof.load(index: layout.fri_round_valid + r_idx) != 1
        {
            fri_valid = false
        }
        r_idx = r_idx + 1
    }
    let total_valid_transcripts: u32 =
        (FRI_VARIANTS * (FRI_ROUNDS + 1)).downcast_truncate()
    let mut t_idx: u32 = 0
    while t_idx < total_valid_transcripts {
        if proof.load(index: layout.fri_transcript_valid + t_idx) != 1 {
            fri_valid = false
        }
        t_idx = t_idx + 1
    }
    let layer_nodes: u32 =
        chunk_layer_tree_nodes(LDE, FRI_ROUNDS).downcast_truncate()
    let stride_nodes = chunk_tree_stride_nodes(LDE).downcast_truncate()
    let mut variant: u32 = 0
    while variant < FRI_VARIANTS.downcast_truncate() {
        let mut n_idx: u32 = 0
        while n_idx < layer_nodes {
            let node = tree_node_index(stride_nodes, variant, 0, n_idx)
            if scratch.load(index: scratch_layout.tree_valid + node) != 1 {
                fri_valid = false
            }
            n_idx = n_idx + 1
        }
        variant = variant + 1
    }

    let folded_eval_words: u32 =
        (chunk_folded_evaluations(LDE) * EXTENSION_WORDS).downcast_truncate()
    let mut fri_equal = true
    let mut f_word: u32 = 0
    while f_word < folded_eval_words {
        if proof.load(index: layout.fri_clean + f_word)
            != proof.load(index: layout.fri_observed + f_word)
        {
            fri_equal = false
        }
        f_word = f_word + 1
    }
    let fri_correct = fri_valid && (if tampered { !fri_equal } else { fri_equal })

    let eval_words_per_variant: u32 =
        (chunk_query_evaluations(FRI_ROUNDS) * EXTENSION_WORDS).downcast_truncate()
    let sibling_words_per_variant: u32 =
        (chunk_query_path_siblings(FRI_ROUNDS) * DIGEST_FIELDS).downcast_truncate()
    let variants: u32 = FRI_VARIANTS.downcast_truncate()
    let evaluation_words_total: u32 = variants * eval_words_per_variant
    let half_lde: u32 = (LDE / 2).downcast_truncate()

    let mut clean_query_valid =
        proof.load(index: layout.fri_query_index_valid) == 1
            && (proof.load(index: layout.fri_query_indices) < half_lde)
    let mut observed_query_valid =
        proof.load(index: layout.fri_query_index_valid + 1) == 1
            && (proof.load(index: layout.fri_query_indices + 1) < half_lde)

    let mut q_word: u32 = 0
    while q_word < eval_words_per_variant {
        if scratch.load(index: scratch_layout.query_copy_valid + q_word) != 1 {
            clean_query_valid = false
        }
        if scratch.load(
            index: scratch_layout.query_copy_valid
                + eval_words_per_variant + q_word,
        ) != 1 {
            observed_query_valid = false
        }
        q_word = q_word + 1
    }
    q_word = 0
    while q_word < sibling_words_per_variant {
        if scratch.load(
            index: scratch_layout.query_copy_valid
                + evaluation_words_total + q_word,
        ) != 1 {
            clean_query_valid = false
        }
        if scratch.load(
            index: scratch_layout.query_copy_valid
                + evaluation_words_total + sibling_words_per_variant + q_word,
        ) != 1 {
            observed_query_valid = false
        }
        q_word = q_word + 1
    }

    let mut query_equal =
        proof.load(index: layout.fri_query_indices)
            == proof.load(index: layout.fri_query_indices + 1)
    q_word = 0
    while q_word < eval_words_per_variant {
        if proof.load(index: layout.fri_query_evaluations + q_word)
            != proof.load(
                index: layout.fri_query_evaluations
                    + eval_words_per_variant + q_word,
            )
        {
            query_equal = false
        }
        q_word = q_word + 1
    }
    q_word = 0
    while q_word < sibling_words_per_variant {
        if proof.load(index: layout.fri_query_siblings + q_word)
            != proof.load(
                index: layout.fri_query_siblings
                    + sibling_words_per_variant + q_word,
            )
        {
            query_equal = false
        }
        q_word = q_word + 1
    }

    let query_valid = clean_query_valid && observed_query_valid
    let query_correct = query_valid
        && (if tampered { !query_equal } else { query_equal })
    let overall = trace_valid
        && lde_valid
        && root_nonzero
        && fri_correct
        && query_correct

    proof.store(
        index: layout.fri_status,
        value: if fri_equal { 1 } else { 0 },
    )
    proof.store(
        index: layout.fri_status + 1,
        value: if fri_correct { 1 } else { 0 },
    )
    proof.store(
        index: layout.fri_status + 2,
        value: status_word(fri_correct, tampered),
    )

    proof.store(
        index: layout.fri_query_opening_valid,
        value: if clean_query_valid { 1 } else { 0 },
    )
    proof.store(
        index: layout.fri_query_opening_valid + 1,
        value: if observed_query_valid { 1 } else { 0 },
    )
    proof.store(
        index: layout.fri_query_status,
        value: if query_equal { 1 } else { 0 },
    )
    proof.store(
        index: layout.fri_query_status + 1,
        value: if query_correct { 1 } else { 0 },
    )
    proof.store(
        index: layout.fri_query_status + 2,
        value: status_word(query_correct, tampered),
    )

    proof.store(
        index: layout.status,
        value: if trace_valid { 1 } else { 0 },
    )
    proof.store(
        index: layout.status + 1,
        value: if fri_equal { 1 } else { 0 },
    )
    proof.store(
        index: layout.status + 2,
        value: if overall { 1 } else { 0 },
    )
    proof.store(
        index: layout.status + 3,
        value: status_word(trace_valid, false),
    )
    proof.store(
        index: layout.status + 4,
        value: status_word(lde_valid, false),
    )
    proof.store(
        index: layout.status + 5,
        value: status_word(root_nonzero, false),
    )
    proof.store(
        index: layout.status + 6,
        value: status_word(overall, tampered),
    )
}

/// Pass 34: Render status bands and folded FRI evaluation words.
pub fn display_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ tamper: f32,
    _ res: f32,
    _ px: i32,
    _ py: i32,
) -> i32 {
    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let u = from_i32(px) / res
    let v = from_i32(py) / res
    let tampered = tamper >= 0.5

    if v < 0.18 {
        if u < 0.2 {
            return proof.load(index: layout.status.wrapping_add(3)).downcast_truncate()
        }
        if u < 0.4 {
            return proof.load(index: layout.status.wrapping_add(4)).downcast_truncate()
        }
        if u < 0.6 {
            return proof.load(index: layout.status.wrapping_add(5)).downcast_truncate()
        }
        if u < 0.8 {
            return proof.load(index: layout.fri_status.wrapping_add(2)).downcast_truncate()
        }
        return proof.load(index: layout.status.wrapping_add(6)).downcast_truncate()
    }
    if v > 0.82 {
        return proof.load(index: layout.status.wrapping_add(6)).downcast_truncate()
    }

    let folded_eval_words: i32 =
        (chunk_folded_evaluations(LDE) * EXTENSION_WORDS).downcast_truncate()
    let sample_i: u32 = to_i32(
        u * from_i32(folded_eval_words),
    ).downcast_unchecked()
    let folded_base = if tampered {
        layout.fri_observed
    } else {
        layout.fri_clean
    }
    let sample = proof.load(index: folded_base.wrapping_add(sample_i))
    let red = (54 as u32).wrapping_add(sample & 127)
    let green = (42 as u32).wrapping_add((sample >> 8) & 95)
    let blue = (96 as u32).wrapping_add((sample >> 16) & 127)
    let stripe: u32 = if u + v > 1.0 { 18 } else { 0 }
    let reject_glow: u32 = if tampered { 26 } else { 0 }
    packed_rgba(
        red.wrapping_add(reject_glow),
        green.wrapping_add(stripe),
        blue,
    )
}
