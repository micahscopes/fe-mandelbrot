pub struct FriScratchChunkLayout {
    pub tree_digests: u32,
    pub tree_valid: u32,
    pub tree_progress: u32,
    pub composition_fold: u32,
    pub composition_fold_valid: u32,
    pub composition_all_rows: u32,
    pub composition_pair_rows: u32,
    pub composition_first_row: u32,
    pub round_placements: u32,
    pub round_cursor: u32,
    pub row_aux_valid: u32,
    pub query_copy_valid: u32,
    pub total_words: u32,
}
impl core::marker::Copy for FriScratchChunkLayout {}

pub const fn fri_scratch_chunk_layout(
    _ trace: usize,
    _ lde: usize,
    _ fri_rounds: usize,
) -> FriScratchChunkLayout {
    let stride_nodes = chunk_tree_stride_nodes(lde)
    let tree_nodes_total = FRI_VARIANTS * stride_nodes
    let tree_digests: usize = 0
    let tree_valid = tree_digests + tree_nodes_total * DIGEST_FIELDS
    let tree_progress = tree_valid + tree_nodes_total
    let composition_fold = tree_progress + lde
    let composition_fold_valid = composition_fold + lde * 2 * EXTENSION_WORDS
    let composition_all_rows = composition_fold_valid + lde
    let composition_pair_rows = composition_all_rows + lde * EXTENSION_WORDS
    let composition_first_row = composition_pair_rows + lde * EXTENSION_WORDS
    let round_placements = composition_first_row + lde * EXTENSION_WORDS
    let round_cursor = round_placements + fri_rounds * FRI_ROUND_PLACEMENT_FIELDS
    let row_aux_valid = round_cursor + 1
    let query_copy_valid = row_aux_valid + trace
    let query_eval_words =
        FRI_VARIANTS * chunk_query_evaluations(fri_rounds) * EXTENSION_WORDS
    let query_sibling_words =
        FRI_VARIANTS * chunk_query_path_siblings(fri_rounds) * DIGEST_FIELDS
    let total_words = query_copy_valid + query_eval_words + query_sibling_words
    FriScratchChunkLayout {
        tree_digests: tree_digests.downcast_truncate(),
        tree_valid: tree_valid.downcast_truncate(),
        tree_progress: tree_progress.downcast_truncate(),
        composition_fold: composition_fold.downcast_truncate(),
        composition_fold_valid: composition_fold_valid.downcast_truncate(),
        composition_all_rows: composition_all_rows.downcast_truncate(),
        composition_pair_rows: composition_pair_rows.downcast_truncate(),
        composition_first_row: composition_first_row.downcast_truncate(),
        round_placements: round_placements.downcast_truncate(),
        round_cursor: round_cursor.downcast_truncate(),
        row_aux_valid: row_aux_valid.downcast_truncate(),
        query_copy_valid: query_copy_valid.downcast_truncate(),
        total_words: total_words.downcast_truncate(),
    }
}

#[inline(always)]
fn store_digest_at<const WORDS: usize>(
    _ buffer: StorageBuffer<u32, WORDS>,
    _ base: u32,
    _ digest: Poseidon2Digest,
) {
    let mut field: u32 = 0
    while field < DIGEST_FIELDS.downcast_truncate() {
        buffer.store(index: base + field, value: digest.field(field).to_u32())
        field = field + 1
    }
}

#[inline(always)]
fn load_digest_at<const WORDS: usize>(
    _ buffer: StorageBuffer<u32, WORDS>,
    _ base: u32,
) -> Poseidon2Digest {
    Poseidon2Digest::from_u32s([
        buffer.load(index: base),
        buffer.load(index: base + 1),
        buffer.load(index: base + 2),
        buffer.load(index: base + 3),
        buffer.load(index: base + 4),
        buffer.load(index: base + 5),
        buffer.load(index: base + 6),
        buffer.load(index: base + 7),
    ])
}

#[inline(always)]
fn store_ext4_at<const WORDS: usize>(
    _ buffer: StorageBuffer<u32, WORDS>,
    _ base: u32,
    _ value: BabyBearExt4,
) {
    buffer.store(index: base, value: value.coefficient_0().to_u32())
    buffer.store(index: base + 1, value: value.coefficient_1().to_u32())
    buffer.store(index: base + 2, value: value.coefficient_2().to_u32())
    buffer.store(index: base + 3, value: value.coefficient_3().to_u32())
}

#[inline(always)]
fn load_ext4_at<const WORDS: usize>(
    _ buffer: StorageBuffer<u32, WORDS>,
    _ base: u32,
) -> BabyBearExt4 {
    BabyBearExt4::from_coordinate_words(
        buffer.load(index: base),
        buffer.load(index: base + 1),
        buffer.load(index: base + 2),
        buffer.load(index: base + 3),
    )
}

#[inline(always)]
fn tree_node_index(_ stride_nodes: u32, _ tree: u32, _ offset: u32, _ node: u32) -> u32 {
    tree * stride_nodes + offset + node
}

#[inline(always)]
fn store_tree_digest_at<const WORDS: usize>(
    _ scratch: StorageBuffer<u32, WORDS>,
    _ tree_digests_base: u32,
    _ node: u32,
    _ digest: Poseidon2Digest,
) {
    store_digest_at(
        scratch,
        tree_digests_base + node * DIGEST_FIELDS.downcast_truncate(),
        digest,
    )
}

#[inline(always)]
fn load_tree_digest_at<const WORDS: usize>(
    _ scratch: StorageBuffer<u32, WORDS>,
    _ tree_digests_base: u32,
    _ node: u32,
) -> Poseidon2Digest {
    load_digest_at(
        scratch,
        tree_digests_base + node * DIGEST_FIELDS.downcast_truncate(),
    )
}

#[inline(always)]
fn tree_level_offset(_ width: u32, _ level: u32) -> u32 {
    let mut offset: u32 = 0
    let mut level_width = width
    let mut current: u32 = 0
    while current < level {
        offset = offset + level_width
        level_width = level_width / 2
        current = current + 1
    }
    offset
}

#[inline(always)]
fn store_fri_round_placement_at<const WORDS: usize>(
    _ storage: StorageBuffer<u32, WORDS>,
    _ base_offset: u32,
    _ index: u32,
    _ placement: FriRoundPlacement,
) {
    let base = base_offset + index * FRI_ROUND_PLACEMENT_FIELDS.downcast_truncate()
    storage.store(index: base, value: if placement.valid { 1 } else { 0 })
    storage.store(index: base + 1, value: placement.index)
    storage.store(index: base + 2, value: placement.round)
    storage.store(index: base + 3, value: placement.input_log)
    storage.store(index: base + 4, value: placement.input_width)
    storage.store(index: base + 5, value: placement.output_width)
    storage.store(index: base + 6, value: placement.output_offset)
    storage.store(index: base + 7, value: placement.tree_offset)
    storage.store(index: base + 8, value: placement.tree_nodes)
    storage.store(index: base + 9, value: placement.query_value_offset)
    storage.store(index: base + 10, value: placement.query_sibling_offset)
    storage.store(index: base + 11, value: placement.pair_width)
    storage.store(index: base + 12, value: placement.pair_depth)
}

#[inline(always)]
fn load_fri_round_placement_at<const WORDS: usize>(
    _ storage: StorageBuffer<u32, WORDS>,
    _ base_offset: u32,
    _ index: u32,
) -> FriRoundPlacement {
    let base = base_offset + index * FRI_ROUND_PLACEMENT_FIELDS.downcast_truncate()
    FriRoundPlacement {
        valid: storage.load(index: base) == 1,
        index: storage.load(index: base + 1),
        round: storage.load(index: base + 2),
        input_log: storage.load(index: base + 3),
        input_width: storage.load(index: base + 4),
        output_width: storage.load(index: base + 5),
        output_offset: storage.load(index: base + 6),
        tree_offset: storage.load(index: base + 7),
        tree_nodes: storage.load(index: base + 8),
        query_value_offset: storage.load(index: base + 9),
        query_sibling_offset: storage.load(index: base + 10),
        pair_width: storage.load(index: base + 11),
        pair_depth: storage.load(index: base + 12),
    }
}

#[inline(always)]
fn store_main_trace_row<const TRACE: usize, const PROOF_WORDS: usize>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ air_trace_base: u32,
    _ row_index: u32,
    _ row: EncodedProofRow,
) {
    let trace_rows: u32 = TRACE.downcast_truncate()
    let mut column: usize = 0
    while column < MAIN_COLUMN_COUNT {
        let column_word: u32 = column.downcast_truncate()
        proof.store(
            index: air_trace_base + column_word * trace_rows + row_index,
            value: encoded_proof_row_word(row, column),
        )
        column = column + 1
    }
}

#[inline(always)]
fn load_main_trace_row<const TRACE: usize, const PROOF_WORDS: usize>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ air_trace_base: u32,
    _ row_index: u32,
) -> EncodedProofRow {
    let trace_rows: u32 = TRACE.downcast_truncate()
    let step = proof.load(index: air_trace_base + 0 * trace_rows + row_index)
    let zr_sign = proof.load(index: air_trace_base + 1 * trace_rows + row_index)
    let zr_mag = proof.load(index: air_trace_base + 2 * trace_rows + row_index)
    let zi_sign = proof.load(index: air_trace_base + 3 * trace_rows + row_index)
    let zi_mag = proof.load(index: air_trace_base + 4 * trace_rows + row_index)
    let rr = proof.load(index: air_trace_base + 5 * trace_rows + row_index)
    let ii = proof.load(index: air_trace_base + 6 * trace_rows + row_index)
    let magnitude = proof.load(index: air_trace_base + 7 * trace_rows + row_index)
    let q_re_sign = proof.load(index: air_trace_base + 8 * trace_rows + row_index)
    let q_re_mag = proof.load(index: air_trace_base + 9 * trace_rows + row_index)
    let r_re = proof.load(index: air_trace_base + 10 * trace_rows + row_index)
    let q_im_sign = proof.load(index: air_trace_base + 11 * trace_rows + row_index)
    let q_im_mag = proof.load(index: air_trace_base + 12 * trace_rows + row_index)
    let r_im = proof.load(index: air_trace_base + 13 * trace_rows + row_index)
    let air_terminal = proof.load(index: air_trace_base + 14 * trace_rows + row_index)
    let active = proof.load(index: air_trace_base + 15 * trace_rows + row_index)
    let terminal = proof.load(index: air_trace_base + 16 * trace_rows + row_index)
    EncodedProofRow {
        active: active,
        terminal: terminal,
        air: EncodedAirRow {
            step: step,
            zr: SignedWord { sign: zr_sign, magnitude: zr_mag },
            zi: SignedWord { sign: zi_sign, magnitude: zi_mag },
            rr: rr,
            ii: ii,
            magnitude: magnitude,
            q_re: SignedWord { sign: q_re_sign, magnitude: q_re_mag },
            r_re: r_re,
            q_im: SignedWord { sign: q_im_sign, magnitude: q_im_mag },
            r_im: r_im,
            terminal: air_terminal,
        },
    }
}

/// Pass 0: Derive the canonical Q12 Mandelbrot escape orbit and public statement.
pub fn derive_main_orbit_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ bound: u32,
) {
    derive_main_orbit_chunk_with_padding<TRACE, LDE, FRI_ROUNDS, PROOF_WORDS>(
        proof, c_re_q12, c_im_q12, bound, false,
    )
}

/// Viewer capacity profile: retain a fixed power-of-two domain while allowing
/// an earlier unique escape row followed by the existing inactive padding.
/// The minimal-domain entry above retains its original acceptance contract.
pub fn derive_main_orbit_chunk_capacity<
    const TRACE: usize, const LDE: usize, const FRI_ROUNDS: usize, const PROOF_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>, _ c_re_q12: i32,
    _ c_im_q12: i32, _ bound: u32,
) {
    derive_main_orbit_chunk_with_padding<TRACE, LDE, FRI_ROUNDS, PROOF_WORDS>(
        proof, c_re_q12, c_im_q12, bound, true,
    )
}

fn derive_main_orbit_chunk_with_padding<
    const TRACE: usize, const LDE: usize, const FRI_ROUNDS: usize, const PROOF_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>, _ c_re_q12: i32,
    _ c_im_q12: i32, _ bound: u32, _ allow_capacity_padding: bool,
) {
    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let claim = EscapesByQ12::new(c_re_q12, c_im_q12, bound)
    let mut stream = EscapeTraceStream::new(claim)
    let mut valid = stream.is_valid()
    let mut row_index: u32 = 0
    let trace_rows: u32 = TRACE.downcast_truncate()
    let mut reached_terminal = false

    while row_index < trace_rows {
        let current = stream.current_proof_row()
        let encoded = encode_proof_row(current)
        store_main_trace_row<TRACE, PROOF_WORDS>(
            proof,
            layout.air_trace,
            row_index,
            encoded,
        )
        if current.terminal {
            reached_terminal = true
            break
        }
        if row_index + 1 >= trace_rows || !stream.can_advance() {
            valid = false
            break
        }
        stream.advance()
        row_index = row_index + 1
    }

    let terminal_air = stream.current_air_row()
    let terminal_step = terminal_air.semantic.step
    let trace_length = row_index + 1
    if !reached_terminal
        || (!allow_capacity_padding && padded_trace_length(trace_length) != trace_rows)
        || (allow_capacity_padding && (trace_rows == 0 || (trace_rows & (trace_rows - 1)) != 0))
    {
        valid = false
    }

    let padding = encode_proof_row(
        PaddedEscapeAirRow {
            valid: true,
            active: false,
            terminal: false,
            air: terminal_air,
        },
    )
    let mut pad_index: u32 = row_index + 1
    while pad_index < trace_rows {
        store_main_trace_row<TRACE, PROOF_WORDS>(
            proof,
            layout.air_trace,
            pad_index,
            padding,
        )
        pad_index = pad_index + 1
    }

    let public = EscapesByQ12Public {
        c_re: encode_signed_word(claim.c.re),
        c_im: encode_signed_word(claim.c.im),
        bound: claim.bound,
        terminal_step: terminal_step,
        trace_length: trace_length,
        padded_length: trace_rows,
    }
    let mut word: usize = 0
    while word < ESCAPES_BY_Q12_PUBLIC_WORDS {
        proof.store(
            index: layout.canonical_public + word.downcast_truncate(),
            value: escapes_by_q12_public_word(public, word),
        )
        word = word + 1
    }
    let mut field: u32 = 0
    while field < PUBLIC_FIELDS.downcast_truncate() {
        proof.store(
            index: layout.packed_public + field,
            value: encoded_public_field_direct(public, field),
        )
        field = field + 1
    }
    let public_valid = encoded_public_fields_are_valid(public)
    proof.store(
        index: layout.trace_valid,
        value: if valid && public_valid { 1 } else { 0 },
    )
}

/// Pass 1: Parallel per-row derivation of all 411 auxiliary range/bit-witness
/// columns and injective 30-bit BabyBear trace packings.
pub fn derive_auxiliary_witness_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let row_index = invocation.global.x
    let trace_rows: u32 = TRACE.downcast_truncate()
    if row_index >= trace_rows { return }

    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let row = load_main_trace_row<TRACE, PROOF_WORDS>(
        proof,
        layout.air_trace,
        row_index,
    )

    let mut column: usize = 0
    while column < AUXILIARY_ROW_BITS {
        let column_word: u32 = (MAIN_COLUMN_COUNT + column).downcast_truncate()
        proof.store(
            index: layout.air_trace + column_word * trace_rows + row_index,
            value: encoded_auxiliary_row_bit_direct(row.air, column),
        )
        column = column + 1
    }

    let mut field: u32 = 0
    while field < ROW_FIELDS.downcast_truncate() {
        proof.store(
            index: layout.packed_main_trace
                + row_index * ROW_FIELDS.downcast_truncate() + field,
            value: encoded_row_field_direct(row, field),
        )
        field = field + 1
    }

    field = 0
    while field < AUXILIARY_FIELDS.downcast_truncate() {
        proof.store(
            index: layout.packed_auxiliary_trace
                + row_index * AUXILIARY_FIELDS.downcast_truncate() + field,
            value: encoded_auxiliary_field_direct(row, field),
        )
        field = field + 1
    }

    let row_valid = encoded_row_fields_are_valid(row)
        && encoded_auxiliary_fields_are_valid(row)
    scratch.store(
        index: scratch_layout.row_aux_valid + row_index,
        value: if row_valid { 1 } else { 0 },
    )
}

/// Pass 7: Commit all `TRACE` main trace rows (`tree = 0`), all `TRACE`
/// auxiliary trace rows (`tree = 1`), and the public claim (`task = 2 * TRACE`)
/// using a single Poseidon2 permutation kernel loop.
pub fn commit_trace_leaves_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let task = invocation.global.x
    let trace_width: u32 = TRACE.downcast_truncate()
    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)

    if task < trace_width {
        scratch.store(index: scratch_layout.tree_progress + task, value: 0)
    }

    if task > 2 * trace_width { return }

    let tag = if task < trace_width {
        row_domain_tag()
    } else if task < 2 * trace_width {
        auxiliary_domain_tag()
    } else {
        public_domain_tag()
    }
    let prefix: u32 = if task < trace_width {
        210
    } else if task < 2 * trace_width {
        AUXILIARY_ROW_BITS.downcast_truncate()
    } else {
        114
    }
    let expected: u32 = if task < trace_width {
        ROW_FIELDS.downcast_truncate()
    } else if task < 2 * trace_width {
        AUXILIARY_FIELDS.downcast_truncate()
    } else {
        PUBLIC_FIELDS.downcast_truncate()
    }
    let total_steps: u32 = if task < 2 * trace_width { 2 } else { 1 }

    let mut sponge = Poseidon2FieldSponge::begin_prefixed_tag(tag, prefix, expected)
    let mut canonical = true
    let mut step: u32 = 0
    while step < total_steps {
        let start: u32 = step * 6
        let count: u32 = if step == 0 {
            if task < 2 * trace_width { 6 } else { 4 }
        } else {
            if task < trace_width { 1 } else { 8 }
        }
        let final_block = step + 1 == total_steps
        let mut block = [BabyBear::zero(); SPONGE_RATE]
        let mut i: u32 = 0
        while i < count {
            let word = if task < trace_width {
                proof.load(
                    index: layout.packed_main_trace
                        + task * ROW_FIELDS.downcast_truncate() + start + i,
                )
            } else if task < 2 * trace_width {
                let row = task - trace_width
                proof.load(
                    index: layout.packed_auxiliary_trace
                        + row * AUXILIARY_FIELDS.downcast_truncate() + start + i,
                )
            } else {
                proof.load(index: layout.packed_public + start + i)
            }
            if word >= BABY_BEAR_MODULUS { canonical = false }
            block[i as usize] = BabyBear::from_u32(word)
            i = i + 1
        }
        sponge.absorb_scheduled_block(ref block, count, final_block)
        step = step + 1
    }

    let committed = sponge.finish_scheduled().require(canonical)
    let valid_word: u32 = if committed.is_valid() { 1 } else { 0 }
    let digest = committed.digest()
    let stride_nodes = chunk_tree_stride_nodes(LDE).downcast_truncate()

    if task < 2 * trace_width {
        let tree = task / trace_width
        let row = task % trace_width
        let node = tree_node_index(stride_nodes, tree, 0, row)
        store_tree_digest_at(scratch, scratch_layout.tree_digests, node, digest)
        scratch.store(index: scratch_layout.tree_valid + node, value: valid_word)
    } else {
        store_digest_at(proof, layout.public_digest, digest)
        proof.store(
            index: layout.production_trace_digest_valid + 2,
            value: valid_word,
        )
    }
}

/// Pass 8: Reduce both `main_trace_tree` (`tree = 0`) and `aux_trace_tree`
/// (`tree = 1`) across `Repeat<..., TRACE_LOG>`.
pub fn reduce_trace_trees_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const TRACE_LOG: usize,
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let task = invocation.global.x
    let trace_width: u32 = TRACE.downcast_truncate()
    if task >= trace_width { return }

    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let level = scratch.load(index: scratch_layout.tree_progress + task)
    if level >= TRACE_LOG.downcast_truncate() { return }

    let child_width = trace_width >> level
    let parent_width = child_width / 2
    if task < 2 * parent_width {
        let tree = task / parent_width
        let parent = task % parent_width
        let child_offset = tree_level_offset(trace_width, level)
        let parent_offset = child_offset + child_width
        let stride_nodes = chunk_tree_stride_nodes(LDE).downcast_truncate()
        let left = tree_node_index(stride_nodes, tree, 0, child_offset + 2 * parent)
        let right = left + 1
        let node = tree_node_index(stride_nodes, tree, 0, parent_offset + parent)
        let valid = scratch.load(index: scratch_layout.tree_valid + left) == 1
            && scratch.load(index: scratch_layout.tree_valid + right) == 1
        let digest = if valid {
            compress(
                load_tree_digest_at(scratch, scratch_layout.tree_digests, left),
                load_tree_digest_at(scratch, scratch_layout.tree_digests, right),
            )
        } else {
            Poseidon2Digest::zero()
        }
        let valid_word: u32 = if valid { 1 } else { 0 }
        store_tree_digest_at(scratch, scratch_layout.tree_digests, node, digest)
        scratch.store(index: scratch_layout.tree_valid + node, value: valid_word)

        if level + 1 == TRACE_LOG.downcast_truncate() {
            let root_base = if tree == 0 {
                layout.main_trace_root
            } else {
                layout.auxiliary_trace_root
            }
            store_digest_at(proof, root_base, digest)
            proof.store(
                index: layout.production_trace_digest_valid + tree,
                value: valid_word,
            )
        }
    }

    scratch.store(index: scratch_layout.tree_progress + task, value: level + 1)
}

/// Pass 9: Commit all `LDE` Main LDE rows (17 columns in 3 sponge blocks per row)
/// into `tree = 0` leaf `row` and reset `tree_progress`.
pub fn commit_main_lde_leaves_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const AIR_LDE_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ lde_values: StorageBuffer<u32, AIR_LDE_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let row = invocation.global.x
    let lde_width: u32 = LDE.downcast_truncate()
    if row >= lde_width { return }

    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    scratch.store(index: scratch_layout.tree_progress + row, value: 0)

    let mut sponge = Poseidon2FieldSponge::begin_tag(
        main_lde_row_domain_tag(),
        MAIN_COLUMN_COUNT.downcast_truncate(),
    )
    let mut canonical = true
    let mut step: u32 = 0
    while step < 3 {
        let start: u32 = if step == 0 { 0 } else if step == 1 { 6 } else { 14 }
        let count: u32 = if step == 0 { 6 } else if step == 1 { 8 } else { 3 }
        let final_block = step == 2
        let mut block = [BabyBear::zero(); SPONGE_RATE]
        let mut i: u32 = 0
        while i < count {
            let word = lde_values.load(index: (start + i) * lde_width + row)
            if word >= BABY_BEAR_MODULUS { canonical = false }
            block[i as usize] = BabyBear::from_u32(word)
            i = i + 1
        }
        sponge.absorb_scheduled_block(ref block, count, final_block)
        step = step + 1
    }

    let committed = sponge.finish_scheduled().require(canonical)
    let stride_nodes = chunk_tree_stride_nodes(LDE).downcast_truncate()
    let node = tree_node_index(stride_nodes, 0, 0, row)
    store_tree_digest_at(
        scratch,
        scratch_layout.tree_digests,
        node,
        committed.digest(),
    )
    scratch.store(
        index: scratch_layout.tree_valid + node,
        value: if committed.is_valid() { 1 } else { 0 },
    )
}

/// Pass 10: Commit all `LDE` Auxiliary LDE rows (411 columns in 52 sponge blocks
/// per row) into `tree = 1` leaf `row`.
pub fn commit_auxiliary_lde_leaves_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const AIR_LDE_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ lde_values: StorageBuffer<u32, AIR_LDE_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let row = invocation.global.x
    let lde_width: u32 = LDE.downcast_truncate()
    if row >= lde_width { return }

    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let mut sponge = Poseidon2FieldSponge::begin_tag(
        auxiliary_lde_row_domain_tag(),
        AUXILIARY_ROW_BITS.downcast_truncate(),
    )
    let mut canonical = true
    let aux_base: u32 = MAIN_COLUMN_COUNT.downcast_truncate()
    let mut step: u32 = 0
    while step < 52 {
        let start: u32 = if step == 0 {
            0
        } else {
            6 + (step - 1) * SPONGE_RATE.downcast_truncate()
        }
        let count: u32 = if step == 0 {
            6
        } else if step < 51 {
            8
        } else {
            5
        }
        let final_block = step == 51
        let mut block = [BabyBear::zero(); SPONGE_RATE]
        let mut i: u32 = 0
        while i < count {
            let word = lde_values.load(
                index: (aux_base + start + i) * lde_width + row,
            )
            if word >= BABY_BEAR_MODULUS { canonical = false }
            block[i as usize] = BabyBear::from_u32(word)
            i = i + 1
        }
        sponge.absorb_scheduled_block(ref block, count, final_block)
        step = step + 1
    }

    let committed = sponge.finish_scheduled().require(canonical)
    let stride_nodes = chunk_tree_stride_nodes(LDE).downcast_truncate()
    let node = tree_node_index(stride_nodes, 1, 0, row)
    store_tree_digest_at(
        scratch,
        scratch_layout.tree_digests,
        node,
        committed.digest(),
    )
    scratch.store(
        index: scratch_layout.tree_valid + node,
        value: if committed.is_valid() { 1 } else { 0 },
    )
}

/// Pass 11: Reduce both `main_lde_tree` (`tree = 0`) and `aux_lde_tree`
/// (`tree = 1`) across `Repeat<..., LDE_LOG>`.
pub fn reduce_air_lde_trees_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let task = invocation.global.x
    let lde_width: u32 = LDE.downcast_truncate()
    if task >= lde_width { return }

    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let level = scratch.load(index: scratch_layout.tree_progress + task)
    if level >= FRI_ROUNDS.downcast_truncate() { return }

    let child_width = lde_width >> level
    let parent_width = child_width / 2
    if task < 2 * parent_width {
        let tree = task / parent_width
        let parent = task % parent_width
        let child_offset = tree_level_offset(lde_width, level)
        let parent_offset = child_offset + child_width
        let stride_nodes = chunk_tree_stride_nodes(LDE).downcast_truncate()
        let left = tree_node_index(stride_nodes, tree, 0, child_offset + 2 * parent)
        let right = left + 1
        let node = tree_node_index(stride_nodes, tree, 0, parent_offset + parent)
        let valid = scratch.load(index: scratch_layout.tree_valid + left) == 1
            && scratch.load(index: scratch_layout.tree_valid + right) == 1
        let digest = if valid {
            compress(
                load_tree_digest_at(scratch, scratch_layout.tree_digests, left),
                load_tree_digest_at(scratch, scratch_layout.tree_digests, right),
            )
        } else {
            Poseidon2Digest::zero()
        }
        let valid_word: u32 = if valid { 1 } else { 0 }
        store_tree_digest_at(scratch, scratch_layout.tree_digests, node, digest)
        scratch.store(index: scratch_layout.tree_valid + node, value: valid_word)

        if level + 1 == FRI_ROUNDS.downcast_truncate() {
            let root_base = if tree == 0 {
                layout.main_lde_root
            } else {
                layout.auxiliary_lde_root
            }
            store_digest_at(proof, root_base, digest)
            proof.store(
                index: layout.air_lde_root_valid + tree,
                value: valid_word,
            )
        }
    }

    scratch.store(index: scratch_layout.tree_progress + task, value: level + 1)
}

/// Pass 12: Bind `public_digest`, `main_trace_root`, `auxiliary_trace_root`,
/// `main_lde_root`, and `auxiliary_lde_root` into `air_transcript` and squeeze
/// `composition_challenge` using a single Poseidon2 loop.
pub fn derive_air_transcript_and_challenge_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
) {
    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let mut op: u32 = 0
    while op < 5 {
        let left = if op == 0 {
            load_digest_at(proof, layout.public_digest)
        } else {
            load_digest_at(proof, layout.air_transcript)
        }
        let right = if op == 0 {
            load_digest_at(proof, layout.main_trace_root)
        } else if op == 1 {
            load_digest_at(proof, layout.auxiliary_trace_root)
        } else if op == 2 {
            load_digest_at(proof, layout.main_lde_root)
        } else {
            load_digest_at(proof, layout.auxiliary_lde_root)
        }
        let tag = if op == 0 {
            statement_domain_tag()
        } else if op == 1 {
            proof_transcript_domain_tag()
        } else if op == 2 {
            main_lde_transcript_domain_tag()
        } else if op == 3 {
            auxiliary_lde_transcript_domain_tag()
        } else {
            composition_challenge_domain_tag()
        }
        let input_valid = if op == 0 {
            proof.load(index: layout.production_trace_digest_valid + 2) == 1
                && proof.load(index: layout.production_trace_digest_valid) == 1
        } else if op == 1 {
            proof.load(index: layout.air_transcript_valid) == 1
                && proof.load(index: layout.production_trace_digest_valid + 1) == 1
        } else if op == 2 {
            proof.load(index: layout.air_transcript_valid) == 1
                && proof.load(index: layout.air_lde_root_valid) == 1
        } else if op == 3 {
            proof.load(index: layout.air_transcript_valid) == 1
                && proof.load(index: layout.air_lde_root_valid + 1) == 1
        } else {
            proof.load(index: layout.air_transcript_valid) == 1
        }
        let expected: u32 = if op < 4 { 16 } else { 8 }
        let blocks: u32 = if op < 4 { 3 } else { 2 }
        let mut sponge = Poseidon2FieldSponge::begin_tag(tag, expected)
        let mut block_step: u32 = 0
        while block_step < blocks {
            let count: u32 = if block_step == 0 {
                6
            } else if op < 4 && block_step == 1 {
                8
            } else {
                2
            }
            let final_block = block_step + 1 == blocks
            let block = if block_step == 0 {
                [
                    left.field(0),
                    left.field(1),
                    left.field(2),
                    left.field(3),
                    left.field(4),
                    left.field(5),
                    BabyBear::zero(),
                    BabyBear::zero(),
                ]
            } else if op < 4 && block_step == 1 {
                [
                    left.field(6),
                    left.field(7),
                    right.field(0),
                    right.field(1),
                    right.field(2),
                    right.field(3),
                    right.field(4),
                    right.field(5),
                ]
            } else if op < 4 {
                [
                    right.field(6),
                    right.field(7),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                ]
            } else {
                [
                    left.field(6),
                    left.field(7),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                    BabyBear::zero(),
                ]
            }
            sponge.absorb_scheduled_block(ref block, count, final_block)
            block_step = block_step + 1
        }
        let committed = sponge.finish_scheduled().require(input_valid)
        let digest = committed.digest()
        let valid_word: u32 = if committed.is_valid() { 1 } else { 0 }
        if op < 4 {
            store_digest_at(proof, layout.air_transcript, digest)
            proof.store(index: layout.air_transcript_valid, value: valid_word)
        } else {
            let mut lane: u32 = 0
            while lane < EXTENSION_WORDS.downcast_truncate() {
                proof.store(
                    index: layout.composition_challenge + lane,
                    value: digest.field(lane).to_u32(),
                )
                lane = lane + 1
            }
            proof.store(index: layout.composition_valid, value: valid_word)
        }
        op = op + 1
    }
}

struct ChunkAirLdeSource<const AIR_LDE_WORDS: usize> {
    values: StorageBuffer<u32, AIR_LDE_WORDS>,
    row: u32,
}
impl<const AIR_LDE_WORDS: usize> core::marker::Copy
    for ChunkAirLdeSource<AIR_LDE_WORDS> {}

struct ChunkAirLdeRow<const LDE: usize> {}
impl<const LDE: usize> core::marker::Copy for ChunkAirLdeRow<LDE> {}

struct ChunkAirLdeNextRow<const TRACE: usize, const LDE: usize> {}
impl<const TRACE: usize, const LDE: usize> core::marker::Copy
    for ChunkAirLdeNextRow<TRACE, LDE> {}

#[inline(always)]
fn chunk_air_lde_main<const LDE: usize, const AIR_LDE_WORDS: usize>(
    _ source: ChunkAirLdeSource<AIR_LDE_WORDS>,
    _ row: u32,
    _ column: usize,
) -> BabyBearExt4 {
    if column >= MAIN_COLUMN_COUNT { return BabyBearExt4::zero() }
    let column_index: u32 = column.downcast_truncate()
    let lde_width: u32 = LDE.downcast_truncate()
    BabyBearExt4::from_base(BabyBear::from_u32(source.values.load(
        index: column_index * lde_width + row,
    )))
}

#[inline(always)]
fn chunk_air_lde_auxiliary<const LDE: usize, const AIR_LDE_WORDS: usize>(
    _ source: ChunkAirLdeSource<AIR_LDE_WORDS>,
    _ row: u32,
    _ column: usize,
) -> BabyBearExt4 {
    if column >= AUXILIARY_ROW_BITS { return BabyBearExt4::zero() }
    let column_index: u32 = (MAIN_COLUMN_COUNT + column).downcast_truncate()
    let lde_width: u32 = LDE.downcast_truncate()
    BabyBearExt4::from_base(BabyBear::from_u32(source.values.load(
        index: column_index * lde_width + row,
    )))
}

impl<const LDE: usize, const AIR_LDE_WORDS: usize> AirColumnView<
    BabyBearExt4,
    ChunkAirLdeSource<AIR_LDE_WORDS>,
> for ChunkAirLdeRow<LDE> {
    fn main(
        ref self,
        _ source: ChunkAirLdeSource<AIR_LDE_WORDS>,
        _ column: usize,
    ) -> BabyBearExt4 {
        chunk_air_lde_main<LDE, AIR_LDE_WORDS>(source, source.row, column)
    }

    fn auxiliary(
        ref self,
        _ source: ChunkAirLdeSource<AIR_LDE_WORDS>,
        _ column: usize,
    ) -> BabyBearExt4 {
        chunk_air_lde_auxiliary<LDE, AIR_LDE_WORDS>(source, source.row, column)
    }
}

impl<
    const TRACE: usize,
    const LDE: usize,
    const AIR_LDE_WORDS: usize,
> AirColumnView<
    BabyBearExt4,
    ChunkAirLdeSource<AIR_LDE_WORDS>,
> for ChunkAirLdeNextRow<TRACE, LDE> {
    fn main(
        ref self,
        _ source: ChunkAirLdeSource<AIR_LDE_WORDS>,
        _ column: usize,
    ) -> BabyBearExt4 {
        let row = (source.row + (LDE / TRACE).downcast_truncate())
            % LDE.downcast_truncate()
        chunk_air_lde_main<LDE, AIR_LDE_WORDS>(source, row, column)
    }

    fn auxiliary(
        ref self,
        _ source: ChunkAirLdeSource<AIR_LDE_WORDS>,
        _ column: usize,
    ) -> BabyBearExt4 {
        let row = (source.row + (LDE / TRACE).downcast_truncate())
            % LDE.downcast_truncate()
        chunk_air_lde_auxiliary<LDE, AIR_LDE_WORDS>(source, row, column)
    }
}

#[inline(always)]
fn store_composition_fold_at<const ABSORBED: usize, const WORDS: usize>(
    _ scratch: StorageBuffer<u32, WORDS>,
    _ fold_base: u32,
    _ row: u32,
    _ checkpoint: ConstraintFoldCheckpoint<BabyBearExt4, ABSORBED>,
) {
    let power = constraint_fold_power<BabyBearExt4, ABSORBED>(checkpoint)
    let value = constraint_fold_value<BabyBearExt4, ABSORBED>(checkpoint)
    let base = fold_base + row * (2 * EXTENSION_WORDS).downcast_truncate()
    store_ext4_at(scratch, base, power)
    store_ext4_at(scratch, base + EXTENSION_WORDS.downcast_truncate(), value)
}

#[inline(always)]
fn load_composition_fold_at<const ABSORBED: usize, const WORDS: usize>(
    _ scratch: StorageBuffer<u32, WORDS>,
    _ fold_base: u32,
    _ challenge: BabyBearExt4,
    _ row: u32,
) -> ConstraintFoldCheckpoint<BabyBearExt4, ABSORBED> {
    let base = fold_base + row * (2 * EXTENSION_WORDS).downcast_truncate()
    let power = load_ext4_at(scratch, base)
    let value = load_ext4_at(scratch, base + EXTENSION_WORDS.downcast_truncate())
    restore_constraint_fold<BabyBearExt4, ABSORBED>(challenge, power, value)
}

#[inline(always)]
fn store_composition_family_at<const WORDS: usize>(
    _ scratch: StorageBuffer<u32, WORDS>,
    _ family_base: u32,
    _ row: u32,
    _ value: BabyBearExt4,
) {
    store_ext4_at(
        scratch,
        family_base + row * EXTENSION_WORDS.downcast_truncate(),
        value,
    )
}

#[inline(always)]
fn load_composition_family_at<const WORDS: usize>(
    _ scratch: StorageBuffer<u32, WORDS>,
    _ family_base: u32,
    _ row: u32,
) -> BabyBearExt4 {
    load_ext4_at(
        scratch,
        family_base + row * EXTENSION_WORDS.downcast_truncate(),
    )
}

/// Pass 13: Fold local and step constraints (0 -> 78).
pub fn evaluate_air_local_step_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
    const AIR_LDE_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ lde_values: StorageBuffer<u32, AIR_LDE_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let evaluation = invocation.global.x
    if evaluation >= LDE.downcast_truncate() { return }
    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let challenge = load_ext4_at(proof, layout.composition_challenge)
    let source = ChunkAirLdeSource { values: lde_values, row: evaluation }
    let row = ChunkAirLdeRow<LDE> {}
    let fold0 = begin_constraint_fold<BabyBearExt4>(challenge)
    let fold78 = fold_local_step_constraints<
        BabyBearExt4,
        ChunkAirLdeSource<AIR_LDE_WORDS>,
        ChunkAirLdeRow<LDE>,
    >(fold0, source, ref row)
    store_composition_fold_at(
        scratch,
        scratch_layout.composition_fold,
        evaluation,
        fold78,
    )
    let challenge_valid = proof.load(index: layout.composition_valid) == 1
    scratch.store(
        index: scratch_layout.composition_fold_valid + evaluation,
        value: if challenge_valid { 1 } else { 0 },
    )
}

/// Pass 14: Fold orbit coordinate range constraints (78 -> 174).
pub fn evaluate_air_orbit_coordinates_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
