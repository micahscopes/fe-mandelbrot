/// Pass 20: Fold pair-row transition constraints (653 -> 690).
pub fn evaluate_air_pair_rows_chunk<
    const TRACE: usize,
    const LDE: usize,
    const FRI_ROUNDS: usize,
    const PROOF_WORDS: usize,
    const AIR_LDE_WORDS: usize,
    const FRI_SCRATCH_WORDS: usize,
>(
    _ proof: StorageBuffer<u32, PROOF_WORDS>,
    _ lde_values: StorageBuffer<u32, AIR_LDE_WORDS>,
    _ scratch: StorageBuffer<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let evaluation = invocation.global.x
    if evaluation >= LDE.downcast_truncate() { return }
    let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let scratch_layout = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    let challenge = load_ext4_at(proof, layout.composition_challenge)
    let fold653 = load_composition_fold_at<653, FRI_SCRATCH_WORDS>(
        scratch,
        scratch_layout.composition_fold,
        challenge,
        evaluation,
    )
    let sign_re = BabyBearExt4::from_base(BabyBear::from_u32(
        proof.load(index: layout.canonical_public),
    ))
    let magnitude_re = BabyBearExt4::from_base(BabyBear::from_u32(
        proof.load(index: layout.canonical_public + 1),
    ))
    let sign_im = BabyBearExt4::from_base(BabyBear::from_u32(
        proof.load(index: layout.canonical_public + 2),
    ))
    let magnitude_im = BabyBearExt4::from_base(BabyBear::from_u32(
        proof.load(index: layout.canonical_public + 3),
    ))
    let source = ChunkAirLdeSource { values: lde_values, row: evaluation }
    let row = ChunkAirLdeRow<LDE> {}
    let next = ChunkAirLdeNextRow<TRACE, LDE> {}
    let checkpoint = fold_pair_rows_constraints<
        BabyBearExt4,
        ChunkAirLdeSource<AIR_LDE_WORDS>,
        ChunkAirLdeRow<LDE>,
        ChunkAirLdeNextRow<TRACE, LDE>,
    >(
        fold653,
        source,
        signed_air_value<BabyBearExt4>(sign_re, magnitude_re),
        signed_air_value<BabyBearExt4>(sign_im, magnitude_im),
        ref row,
        ref next,
    )
    store_composition_fold_at(
        scratch,
        scratch_layout.composition_fold,
        evaluation,
        pair_rows_constraint_fold(checkpoint),
    )
    store_composition_family_at(
        scratch,
        scratch_layout.composition_all_rows,
        evaluation,
        pair_rows_all_rows(checkpoint),
    )
}

