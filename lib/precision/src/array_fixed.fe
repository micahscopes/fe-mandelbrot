//! Array interpretation of signed radix-8192 fixed-point values for frame work.
//!
//! The private representation has 2..=10 canonical digits, least significant
//! first, with 13*(L-1) fractional bits. Addition wraps magnitude modulo 8192^L;
//! opposite signs retain the larger magnitude's sign (the left sign on ties).
//! Negative zero is retained internally; binary32 observation canonicalizes it.
//! The reference recurrence uses this interpretation; wire layouts stay explicit.

use core::marker::Copy
use core::ops::{Add, Eq, Mul, Neg, Sub}
use super::{Expansion, to_quad}
use super::fixed::{Binary32View, limb_highest_bit, project_binary32, project_binary32_quad}

extern { const fn __bitcast<From, To>(_: From) -> To }

// These checked boundaries use only backend scalar words. The generic core
// IntDowncast currently passes through u256, outside the web scalar envelope.
fn signed_word(_ value: u32) -> i32 {
    assert(value <= 2147483647)
    __bitcast<u32, i32>(value)
}

fn unsigned_word(_ value: i32) -> u32 {
    assert(value >= 0)
    __bitcast<i32, u32>(value)
}

pub struct ArrayFixed<const L: usize> {
    negative: bool,
    digits: [u32; L],
}

impl<const L: usize> Copy for ArrayFixed<L> {}

impl<const L: usize> ArrayFixed<L> {
    // Like Contacts::capacity, convert the compile-time array dimension once;
    // all runtime counters are u32 and only widen at checked array indexing.
    fn width() -> u32 {
        assert(L >= 2 && L <= 10)
        L.downcast_truncate()
    }

    pub fn zero() -> Self {
        let _ = Self::width()
        Self { negative: false, digits: [0; L] }
    }

    /// Checked integer boundary. Unlike canonical wire Fixed, this arithmetic
    /// value deliberately permits negative zero, matching the old limb kernel.
    pub fn from_digits(_ negative: bool, _ digits: [u32; L]) -> Self {
        let width: u32 = Self::width()
        let mut index: u32 = 0
        while index < width {
            assert(digits[index as usize] < 8192)
            index = index + 1
        }
        Self { negative: negative, digits: digits }
    }

    /// Quantize one finite |value| < 8192 source toward zero onto this lattice.
    /// Decode integer bits directly: no GPU floating reassociation or flush-to-
    /// zero can change the retained digits. Both IEEE zero encodings parse +0;
    /// a negative nonzero source below the lattice parses negative zero.
    pub fn from_binary32_bits(_ bits: u32) -> Self {
        let magnitude: u32 = bits & 2147483647
        // 0x46000000 encodes 8192; this also rejects infinities and NaNs.
        assert(magnitude < 1174405120)
        let mut result: Self = Self::zero()
        result.negative = (bits >> 31) != 0 && magnitude != 0
        let encoded_exponent: u32 = magnitude >> 23
        // Every binary32 subnormal is below the finest supported 2^-117 unit.
        if encoded_exponent == 0 { return result }
        let significand: u32 = (magnitude & 8388607) | 8388608
        let exponent: i32 = signed_word(encoded_exponent)
        let lattice_shift: i32 = exponent - 150 + result.fractional_bits()
        let mut source_bit: i32 = -lattice_shift
        let width: u32 = Self::width()
        let mut index: u32 = 0
        while index < width {
            result.digits[index as usize] = if source_bit >= 24 || source_bit <= -13 {
                0
            } else if source_bit >= 0 {
                let shift: u32 = unsigned_word(source_bit)
                (significand >> shift) & 8191
            } else {
                let shift: u32 = unsigned_word(-source_bit)
                (significand << shift) & 8191
            }
            source_bit = source_bit + 13
            index = index + 1
        }
        result
    }

    pub fn from_f32(_ value: f32) -> Self {
        Self::from_binary32_bits(__bitcast<f32, u32>(value))
    }

    /// Preserve the old four-word, left-associated accumulation and final +0.
    pub fn from_expansion(_ value: Expansion<4>) -> Self {
        let (a, b, c, d) = to_quad(value)
        let terms: [f32; 4] = [a, b, c, d]
        let mut result: Self = Self::from_f32(terms[0])
        let mut index: usize = 1
        while index < 4 {
            result = result + Self::from_f32(terms[index])
            index = index + 1
        }
        result + Self::zero()
    }

    pub fn sign(self) -> u32 { if self.negative { 1 } else { 0 } }

    pub fn to_digits(self) -> [u32; L] { self.digits }

    pub fn to_quad_bits(self) -> (u32, u32, u32, u32) {
        project_binary32_quad(self.sign(), self)
    }

    pub fn to_binary32_bits(self) -> u32 {
        project_binary32(if self.negative { 1 } else { 0 }, self)
    }

    pub fn to_f32(self) -> f32 {
        __bitcast<u32, f32>(self.to_binary32_bits())
    }

    /// Strict magnitude > 4, including a nonzero fractional suffix at 4.
    pub fn magnitude_exceeds_four(self) -> bool {
        let width: u32 = Self::width()
        let top: u32 = self.digits[(width - 1) as usize]
        if top > 4 { return true }
        if top < 4 { return false }
        let mut index: u32 = 0
        while index < width - 1 {
            if self.digits[index as usize] != 0 { return true }
            index = index + 1
        }
        false
    }

    fn magnitude_less(self, _ other: Self) -> bool {
        let mut index: u32 = Self::width()
        while index > 0 {
            index = index - 1
            if self.digits[index as usize] != other.digits[index as usize] {
                return self.digits[index as usize] < other.digits[index as usize]
            }
        }
        false
    }


}

// Representation equality observes the retained zero sign. In particular,
// opposite-sign exact cancellation keeps the left sign, as in fixed::add.
impl<const L: usize> Eq for ArrayFixed<L> {
    fn eq(self, _ other: Self) -> bool {
        if self.negative != other.negative { return false }
        let width: u32 = Self::width()
        let mut index: u32 = 0
        while index < width {
            if self.digits[index as usize] != other.digits[index as usize] { return false }
            index = index + 1
        }
        true
    }
}

impl<const L: usize> Add for ArrayFixed<L> {
    type Output = Self

    fn add(own self, _ other: own Self) -> Self {
        let width: u32 = Self::width()
        let mut result: Self = Self::zero()
        result.negative = self.negative
        if self.negative == other.negative {
            let mut carry: u32 = 0
            let mut index: u32 = 0
            while index < width {
                let digit: usize = index as usize
                let sum: u32 = self.digits[digit] + other.digits[digit] + carry
                result.digits[digit] = sum & 8191
                carry = sum >> 13
                index = index + 1
            }
        } else {
            let left_is_smaller: bool = self.magnitude_less(other)
            result.negative = if left_is_smaller { other.negative } else { self.negative }
            let mut borrow: u32 = 0
            let mut index: u32 = 0
            while index < width {
                let digit: usize = index as usize
                let larger: u32 = if left_is_smaller { other.digits[digit] } else { self.digits[digit] }
                let smaller: u32 = if left_is_smaller { self.digits[digit] } else { other.digits[digit] }
                // Canonical digits make this biased difference nonnegative.
                let biased: u32 = 8192 + larger - smaller - borrow
                result.digits[digit] = biased & 8191
                borrow = 1 - (biased >> 13)
                index = index + 1
            }
        }
        result
    }
}

/// Sliding radix multiplication: round the discarded fraction half upward,
/// then retain L magnitude digits. Every MAC is bounded by 8192^2 - 1.
/// The loops share one accumulator instead of expanding a family of limb calls.
impl<const L: usize> Mul for ArrayFixed<L> {
    type Output = Self

    fn mul(own self, _ other: own Self) -> Self {
        let width: u32 = Self::width()
        let mut result: Self = Self::zero()
        result.negative = self.negative != other.negative
        let mut guard: u32 = 0
        let mut row: u32 = 0
        while row < width {
            let mut carry: u32 = 0
            let mut column: u32 = 0
            while column < width {
                let index: usize = column as usize
                let sum: u32 = result.digits[index]
                    + self.digits[index] * other.digits[row as usize] + carry
                result.digits[index] = sum & 8191
                carry = sum >> 13
                column = column + 1
            }
            if row < width - 1 {
                guard = result.digits[0]
                let mut column: u32 = 0
                while column < width - 1 {
                    result.digits[column as usize] = result.digits[(column + 1) as usize]
                    column = column + 1
                }
                result.digits[(width - 1) as usize] = carry
            } else {
                let mut carry: u32 = guard >> 12
                let mut column: u32 = 0
                while column < width {
                    let index: usize = column as usize
                    let sum: u32 = result.digits[index] + carry
                    result.digits[index] = sum & 8191
                    carry = sum >> 13
                    column = column + 1
                }
            }
            row = row + 1
        }
        result
    }
}

impl<const L: usize> Neg for ArrayFixed<L> {
    type Output = Self

    fn neg(own self) -> Self {
        Self { negative: !self.negative, digits: self.digits }
    }
}

impl<const L: usize> Sub for ArrayFixed<L> {
    type Output = Self

    fn sub(own self, _ other: own Self) -> Self { self + (-other) }
}

impl<const L: usize> Binary32View for ArrayFixed<L> {
    fn highest_bit(self) -> i32 {
        let mut index: u32 = Self::width()
        let mut digit: u32 = 0
        while index > 0 && digit == 0 {
            index = index - 1
            digit = self.digits[index as usize]
        }
        if digit == 0 {
            -1
        } else {
            let bit: i32 = limb_highest_bit(digit)
            let limb: i32 = signed_word(index)
            limb * 13 + bit
        }
    }

    fn bit_at(self, _ index: i32) -> u32 {
        if index < 0 { return 0 }
        let position: u32 = unsigned_word(index)
        let slot: u32 = position / 13
        if slot >= Self::width() { return 0 }
        (self.digits[slot as usize] >> (position % 13)) & 1
    }

    fn word_from(self, _ index: i32) -> u32 {
        if index < 0 { return 0 }
        let offset: u32 = unsigned_word(index)
        let width: u32 = Self::width()
        let mut slot: u32 = offset / 13
        if slot >= width { return 0 }
        let shift: u32 = offset % 13
        let mut result: u32 = self.digits[slot as usize] >> shift
        let mut position: u32 = 13 - shift
        slot = slot + 1
        // A 32-bit window touches at most four canonical radix digits.
        while slot < width && position < 32 {
            result = result | (self.digits[slot as usize] << position)
            slot = slot + 1
            position = position + 13
        }
        result
    }

    fn any_below(self, _ count: i32) -> u32 {
        if count <= 0 { return 0 }
        let bits: u32 = unsigned_word(count)
        let whole: u32 = bits / 13
        let width: u32 = Self::width()
        let mut index: u32 = 0
        let mut result: u32 = 0
        while index < width && index < whole {
            result = result | self.digits[index as usize]
            index = index + 1
        }
        if index < width {
            let partial: u32 = bits % 13
            result = result | (self.digits[index as usize] & (((1 as u32) << partial) - 1))
        }
        result
    }

    fn fractional_bits(self) -> i32 {
        let fractional_limbs: i32 = signed_word(Self::width() - 1)
        fractional_limbs * 13
    }
}

/// Frame-scope difference with the same independently quantized ordered words
/// as fixed::expansion_difference. L=10 retains the existing 117-bit lattice.
pub fn expansion_difference<const L: usize>(_ from: Expansion<4>, _ to: Expansion<4>) -> f32 {
    (ArrayFixed<L>::from_expansion(to) - ArrayFixed<L>::from_expansion(from)).to_f32()
}
