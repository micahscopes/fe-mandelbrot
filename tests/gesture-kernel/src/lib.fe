//! Runtime-word reference recurrence and packing probe. No generated arithmetic
//! is edited by the runner; independent integer expectations live outside Fe.
use core::marker::Copy
use std::webgpu::{
    ComputeSurface, FixedDispatch, Workgroup, StorageBuffer, FragmentSurface,
    GpuProgram, ContinuousFrames, StandardSurfaceRecovery, SurfaceQuality,
    SurfaceQualityFacts, SurfaceBackingExtent, SurfaceRecovery,
    SurfaceScheduling, SurfaceTransition, WebGpuBackend,
}
use std::web::view::{
    ApplyParamBindings, Extent, Param, ParamBindingsProvider,
    Surface, SurfaceEvent, SurfaceState,
}
use renderer::policy::initial_camera
use algebra::{Complex, Similarity2}

pub struct ProbeParams { pub result: Param }
pub struct ProbeState { pub result: f32 }
impl Copy for ProbeState {}
impl SurfaceState for ProbeState { type Params = ProbeParams }
derive ApplyParamBindings for ProbeState using ParamBindingsProvider<ProbeParams>
pub struct ProbeEnvelope { pub state: ProbeState }
impl Copy for ProbeEnvelope {}

pub struct ProbeBacking {}
impl ProbeBacking {
    pub fn choose(_ facts: own SurfaceQualityFacts) -> SurfaceBackingExtent {
        let _ = facts
        SurfaceBackingExtent { width: 64.0, height: 64.0 }
    }
}

actor GestureKernelProbe uses (
    GpuProgram<WebGpuBackend>, SurfaceQuality<ProbeBacking>, SurfaceRecovery<StandardSurfaceRecovery>,
) {
    inputs: StorageBuffer<f32, 8>,
    outputs: StorageBuffer<f32, 8>,
    state: ProbeState,

    fn initial() -> ProbeEnvelope uses (core::actor::InitialState) {
        ProbeEnvelope { state: ProbeState { result: 1.0 } }
    }
    const fn view() -> Surface<ProbeParams> {
        Surface { extent: Extent::square(64), params: ProbeParams { result: Param::fixed(0.0) } }
    }
    fn projection_case(self) uses (ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 1, 1>>) {
        let mut camera = initial_camera()
        camera.zoom = self.inputs.load(index: 0)
        camera.orientation = Complex { re: self.inputs.load(index: 1), im: self.inputs.load(index: 2) }
        let point = Complex { re: self.inputs.load(index: 3), im: self.inputs.load(index: 4) }
        let projected = camera.plane_offset(point)
        let restored = camera.normalized_offset(projected)
        self.outputs.store(index: 0, value: projected.re)
        self.outputs.store(index: 1, value: projected.im)
        self.outputs.store(index: 2, value: restored.re)
        self.outputs.store(index: 3, value: restored.im)
        let map = Similarity2 { linear: camera.orientation.scale(camera.zoom),
            offset: Complex { re: 0.0, im: 0.0 } }
        let roundtrip = map.then(map.inverse()).apply(point)
        self.outputs.store(index: 4, value: roundtrip.re)
        self.outputs.store(index: 5, value: roundtrip.im)
        let moved = camera.normalized_offset(Complex { re: self.inputs.load(index: 5), im: self.inputs.load(index: 6) })
        self.outputs.store(index: 6, value: moved.re)
        self.outputs.store(index: 7, value: moved.im)
    }
    fn display(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        let _ = px
        let _ = py
        0
    }
    fn step(self, event: own SurfaceEvent) -> ProbeEnvelope
        uses (SurfaceTransition, SurfaceScheduling<ContinuousFrames>) {
        let _ = event
        ProbeEnvelope { state: self.state }
    }
}
