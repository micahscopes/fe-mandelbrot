//! Generated exact rational conversion cases; see oracle.py.
use precision::array_fixed::ArrayFixed

#[test]
fn exact_binary32_conversion_l2() {
    let expected = ArrayFixed<2>::from_digits(false, [0, 0])
    let actual = ArrayFixed<2>::from_binary32_bits(0)
    assert(actual == expected)
    assert(actual.to_binary32_bits() == 0)
    let expected = ArrayFixed<2>::from_digits(false, [0, 0])
    let actual = ArrayFixed<2>::from_binary32_bits(2147483648)
    assert(actual == expected)
    assert(actual.to_binary32_bits() == 0)
    let expected = ArrayFixed<2>::from_digits(false, [0, 0])
    let actual = ArrayFixed<2>::from_binary32_bits(1)
    assert(actual == expected)
    assert(actual.to_binary32_bits() == 0)
    let expected = ArrayFixed<2>::from_digits(true, [0, 0])
    let actual = ArrayFixed<2>::from_binary32_bits(2147483649)
    assert(actual == expected)
    assert(actual.to_binary32_bits() == 0)
    let expected = ArrayFixed<2>::from_digits(false, [0, 0])
    let actual = ArrayFixed<2>::from_binary32_bits(8388607)
    assert(actual == expected)
    assert(actual.to_binary32_bits() == 0)
    let expected = ArrayFixed<2>::from_digits(true, [0, 0])
    let actual = ArrayFixed<2>::from_binary32_bits(2155872255)
    assert(actual == expected)
    assert(actual.to_binary32_bits() == 0)
    let expected = ArrayFixed<2>::from_digits(false, [8188, 8191])
    let actual = ArrayFixed<2>::from_binary32_bits(1174405119)
    assert(actual == expected)
    assert(actual.to_binary32_bits() == 1174405119)
    let expected = ArrayFixed<2>::from_digits(true, [8188, 8191])
    let actual = ArrayFixed<2>::from_binary32_bits(3321888767)
    assert(actual == expected)
    assert(actual.to_binary32_bits() == 3321888767)
    let expected = ArrayFixed<2>::from_digits(false, [0, 0])
    let actual = ArrayFixed<2>::from_binary32_bits(8388609)
