//! Camera-difference arithmetic on the GPU that runs it.
//! One single-invocation workgroup per case evaluates the production
//! `expansion_difference<10>` and the stages it is made of, so a wrong result
//! can be attributed to conversion, accumulation, subtraction or projection.
//! Expected words come from the independent Fraction oracle in oracle.py.
use core::marker::Copy
use std::webgpu::{
    ComputeInvocation, ComputeSurface, FixedDispatch, Workgroup, StorageBuffer,
    FragmentSurface, GpuProgram, ContinuousFrames, StandardSurfaceRecovery,
    SurfaceQuality, SurfaceQualityFacts, SurfaceBackingExtent, SurfaceRecovery,
    SurfaceScheduling, SurfaceTransition, WebGpuBackend,
}
use std::web::view::{
    ApplyParamBindings, Extent, Param, ParamBindingsProvider,
    Surface, SurfaceEvent, SurfaceState,
}
use precision::{Expansion, from_quad}
use precision::array_fixed::{ArrayFixed, expansion_difference}

extern { const fn __bitcast<From, To>(_: From) -> To }

pub const CASES: u32 = 512
pub const WORDS_PER_CASE: u32 = 32

pub struct ProbeParams { pub unused: Param }
pub struct ProbeState { pub unused: f32 }
impl Copy for ProbeState {}
impl SurfaceState for ProbeState { type Params = ProbeParams }
derive ApplyParamBindings for ProbeState using ParamBindingsProvider<ProbeParams>
pub struct ProbeEnvelope { pub state: ProbeState }
impl Copy for ProbeEnvelope {}

pub struct ProbeBacking {}
impl ProbeBacking {
    pub fn choose(_ facts: own SurfaceQualityFacts) -> SurfaceBackingExtent {
        let _ = facts
        SurfaceBackingExtent { width: 64.0, height: 64.0 }
    }
}

fn read_f32(_ buffer: StorageBuffer<u32, 4096>, _ index: u32) -> f32 {
    __bitcast<u32, f32>(buffer.load(index: index))
}

fn read_expansion(_ buffer: StorageBuffer<u32, 4096>, _ base: u32) -> Expansion<4> {
    from_quad(
        read_f32(buffer, base), read_f32(buffer, base + 1),
        read_f32(buffer, base + 2), read_f32(buffer, base + 3),
    )
}

/// Order-sensitive fold of canonical 13-bit digits; mirrored in oracle.py.
fn digest(_ digits: [u32; 10]) -> u32 {
    let mut folded: u32 = 0
    let mut index: u32 = 0
    while index < 10 {
        folded = folded ^ (digits[index as usize] << ((index * 7) % 19))
        index = index + 1
    }
    folded
}


/// Smallest form of the suspect construct: a dynamically indexed array inside a
/// local struct that also holds a bool, filled by a loop and returned by value.
pub struct Lanes { pub negative: bool, pub digits: [u32; 10] }
impl Copy for Lanes {}

fn fill_lanes(_ seed: u32) -> Lanes {
    let mut lanes: Lanes = Lanes { negative: (seed >> 31) != 0, digits: [0; 10] }
    let mut index: u32 = 0
    while index < 10 {
        lanes.digits[index as usize] = (seed >> index) & 8191
        index = index + 1
    }
    lanes
}

/// Same record built from a literal: an array inside a struct returned by value, no loop.
fn literal_lanes(_ seed: u32) -> Lanes {
    Lanes {
        negative: (seed >> 31) != 0,
        digits: [
            seed & 8191, (seed >> 1) & 8191, (seed >> 2) & 8191, (seed >> 3) & 8191,
            (seed >> 4) & 8191, (seed >> 5) & 8191, (seed >> 6) & 8191, (seed >> 7) & 8191,
            (seed >> 8) & 8191, (seed >> 9) & 8191,
        ],
    }
}

/// Digest of the digits with the flag in bit 31, so one word observes both fields.
fn fold_lanes(_ lanes: Lanes) -> u32 {
    digest(lanes.digits) | (if lanes.negative { 2147483648 } else { 0 })
}

/// A bare array filled by a loop and returned by value (no struct, no flag).
fn fill_array(_ seed: u32) -> [u32; 10] {
    let mut digits: [u32; 10] = [0; 10]
    let mut index: u32 = 0
    while index < 10 {
        digits[index as usize] = (seed >> index) & 8191
        index = index + 1
    }
    digits
}

/// The loop writes through a mutable parameter; nothing aggregate is returned.
fn fill_into(_ lanes: mut Lanes, _ seed: u32) {
    let mut index: u32 = 0
    while index < 10 {
        lanes.digits[index as usize] = (seed >> index) & 8191
        index = index + 1
    }
}

/// A struct without an array returned out of a loop.
pub struct Flag { pub negative: bool, pub count: u32 }
impl Copy for Flag {}

fn count_flag(_ seed: u32) -> Flag {
    let mut flag: Flag = Flag { negative: (seed >> 31) != 0, count: 0 }
    let mut index: u32 = 0
    while index < 10 {
        flag.count = flag.count + ((seed >> index) & 1)
        index = index + 1
    }
    flag
}

/// A local array filled by a loop, folded in the same function; only a scalar leaves.
fn loop_digest(_ seed: u32) -> u32 {
    let mut digits: [u32; 10] = [0; 10]
    let mut index: u32 = 0
    while index < 10 {
        digits[index as usize] = (seed >> index) & 8191
        index = index + 1
    }
    digest(digits)
}

actor CameraDeltaProbe uses (
    GpuProgram<WebGpuBackend>,
    SurfaceQuality<ProbeBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
) {
    inputs: StorageBuffer<u32, 4096>,
    outputs: StorageBuffer<u32, 16384>,
    state: ProbeState,

    fn initial() -> ProbeEnvelope uses (core::actor::InitialState) {
        ProbeEnvelope { state: ProbeState { unused: 0.0 } }
    }

    const fn view() -> Surface<ProbeParams> {
        Surface { extent: Extent::square(64), params: ProbeParams { unused: Param::fixed(0.0) } }
    }

    fn delta_case(self, invocation: ComputeInvocation)
        uses (ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<512, 1, 1>>)
    {
        let case: u32 = invocation.global.x
        let input: u32 = case * 8
        let output: u32 = case * 32
        let from: Expansion<4> = read_expansion(self.inputs, input)
        let to: Expansion<4> = read_expansion(self.inputs, input + 4)
        let origin: ArrayFixed<10> = ArrayFixed<10>::from_expansion(from)
        let target: ArrayFixed<10> = ArrayFixed<10>::from_expansion(to)
        let difference: ArrayFixed<10> = target - origin
        self.outputs.store(index: output, value: __bitcast<f32, u32>(expansion_difference<10>(from, to)))
        let target_digits: [u32; 10] = target.to_digits()
        let mut index: u32 = 0
        while index < 10 {
            self.outputs.store(index: output + 1 + index, value: target_digits[index as usize])
            index = index + 1
        }
        self.outputs.store(index: output + 11, value: target.sign())
        self.outputs.store(index: output + 12, value: origin.to_binary32_bits())
        self.outputs.store(index: output + 13, value: target.to_binary32_bits())
        self.outputs.store(index: output + 14, value: difference.sign())
        self.outputs.store(index: output + 15, value: digest(difference.to_digits()))
        // Canaries and isolated primitives (words 16..30).
        let raw_from: u32 = self.inputs.load(index: input)
        let raw_to: u32 = self.inputs.load(index: input + 4)
        self.outputs.store(index: output + 16, value: 12648430)
        self.outputs.store(index: output + 17, value: raw_from)
        self.outputs.store(index: output + 18, value: raw_to)
        self.outputs.store(index: output + 19, value: raw_from >> 31)
        let single: ArrayFixed<10> = ArrayFixed<10>::from_binary32_bits(raw_from)
        self.outputs.store(index: output + 20, value: digest(single.to_digits()))
        self.outputs.store(index: output + 21, value: single.sign())
        self.outputs.store(index: output + 22, value: single.to_binary32_bits())
        let lanes: Lanes = fill_lanes(raw_from)
        self.outputs.store(index: output + 23, value: digest(lanes.digits))
        self.outputs.store(index: output + 24, value: fold_lanes(literal_lanes(raw_from)))
        self.outputs.store(index: output + 25, value: if lanes.negative { 1 } else { 0 })
        self.outputs.store(index: output + 26, value: digest(fill_array(raw_from)))
        let mut inline_lanes: Lanes = Lanes { negative: (raw_from >> 31) != 0, digits: [0; 10] }
        let mut slot: u32 = 0
        while slot < 10 {
            inline_lanes.digits[slot as usize] = (raw_from >> slot) & 8191
            slot = slot + 1
        }
        self.outputs.store(index: output + 27, value: fold_lanes(inline_lanes))
        let mut through: Lanes = Lanes { negative: (raw_from >> 31) != 0, digits: [0; 10] }
        fill_into(mut through, raw_from)
        self.outputs.store(index: output + 28, value: fold_lanes(through))
        let flag: Flag = count_flag(raw_from)
        self.outputs.store(index: output + 29, value: flag.count | (if flag.negative { 2147483648 } else { 0 }))
        self.outputs.store(index: output + 30, value: loop_digest(raw_from))
    }

    fn display_probe(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        let _ = px
        let _ = py
        0
    }

    fn navigate(self, event: own SurfaceEvent) -> ProbeEnvelope
        uses (SurfaceTransition, SurfaceScheduling<ContinuousFrames>)
    {
        let _ = event
        ProbeEnvelope { state: self.state }
    }
}
