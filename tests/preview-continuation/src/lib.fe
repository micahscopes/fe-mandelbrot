use core::default::Default
use core::marker::Copy
use std::webgpu::{
    FragmentSurface as Display,
    GpuProgram as PassGraph,
    ContinuousFrames,
    StandardSurfaceRecovery,
    SurfaceQuality,
    SurfaceRecovery,
    SurfaceScheduling,
    SurfaceTransition,
    WebGpuBackend,
}
