FEH1
2933

//! Three bands: OKLCH hue sweep, OKLab blending, and lightness/chroma field.
//! The same perceptual_color ingot is used by the Mandelbrot renderer.
use core::marker::Copy
use std::webgpu::{
    FragmentSurface,
    GpuProgram,
    ResponsiveBacking,
    StandardSurfaceRecovery,
    SurfaceQuality,
    SurfaceRecovery,
    SurfaceTransition,
    WebGpuBackend,
}
use std::web::view::{
    ApplyParamBindings,
    Extent,
    Param,
    ParamBindingsProvider,
    Surface,
    SurfaceEvent,
    SurfaceState,
}
use fmath::from_i32
use perceptual_color::{Oklch, oklch, blend, display_rgba}

pub struct ColorParams {
    pub hue: Param,
    pub chroma: Param,
    pub lightness: Param,
    pub res: Param,
}

pub struct ColorState {
    pub hue: f32,
    pub chroma: f32,
    pub lightness: f32,
    pub res: f32,
}

impl Copy for ColorState {}

impl SurfaceState for ColorState {
    type Params = ColorParams
}

derive ApplyParamBindings for ColorState using ParamBindingsProvider<ColorParams>

pub struct ColorStateEnvelope {
    pub state: ColorState,
}

impl Copy for ColorStateEnvelope {}

const fn params() -> ColorParams {
    ColorParams {
        hue: Param::range(min: 0.0, max: 360.0, init: 275.0).drag_x(per_px: 0.5),
        chroma: Param::range(min: 0.0, max: 0.25, init: 0.18),
        lightness: Param::range(min: 0.1, max: 0.95, init: 0.65).drag_y(per_px: -0.001),
        res: Param::extent_x(),
    }
}

actor ColorDemo uses (
    GpuProgram<WebGpuBackend>,
    SurfaceQuality<ResponsiveBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
) {
    state: ColorState,

    const fn view() -> Surface<ColorParams> {
        Surface {
            extent: Extent::square(768),
            params: params(),
        }
    }

    fn navigate(self, event: own SurfaceEvent) -> ColorStateEnvelope
        uses (SurfaceTransition)
    {
        ColorStateEnvelope {
            state: self.state.apply_param_bindings(params(), event),
        }
    }

    fn shade(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        let s: ColorState = self.state
        let x: f32 = (from_i32(px) + 0.5) / s.res
        let y: f32 = (from_i32(py) + 0.5) / s.res
        if y < 0.3333333 {
            let sweep: Oklch = Oklch {
                l: s.lightness,
                chroma: s.chroma,
                hue: s.hue + x * 360.0,
            }
            display_rgba(sweep.to_color())
        } else {
            if y < 0.6666667 {
                let left = oklch(s.lightness, s.chroma, s.hue)
                let right = oklch(s.lightness, s.chroma, s.hue + 140.0)
                display_rgba(blend(left, right, x))
            } else {
                let field: Oklch = Oklch {
                    l: 0.15 + 0.75 * x,
                    chroma: s.chroma * (y - 0.6666667) * 3.0,
                    hue: s.hue,
                }
                display_rgba(field.to_color())
            }
        }
    }
}
