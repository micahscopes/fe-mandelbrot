//! Readable source browsing as a resident Fe component.
//!
//! The existing inspector task owns fetch/cancellation and stale responses.
//! This actor owns file selection, bounded UTF-8 retention, line numbers and
//! the projected DOM. No application JavaScript handles those operations.
use std::web::component::{
    BrowserBytes,
    BrowserPtr,
    BrowserString,
    ComponentEvent,
    ComponentEventKind,
    ComponentPatch,
    ComponentWriter,
    InitialState,
    ProjectState,
    ResidentTransition,
    VisibleParts,
    allocate_component_buffer,
}
use std::web::identity::{
    ComponentSchema,
    ComponentSchemaProvider,
    Part,
    Text,
    Link,
    Visibility,
    Repeat,
    Class,
}
use std::web::page::{
    ComponentComposition,
    ComponentView,
    PageAttribute,
    PageBuilder,
    PageElement,
    PageText,
}
use std::text::{
    Utf8Buffer,
    Utf8View,
}
use core::actor::{
    ActorSink,
    ScopedTask,
}
use core::pending::{
    PendingCancellation,
    Select,
    Suspend,
}
use std::actor::{
    ActorNotification,
    BrowserActorNotifications,
    BrowserActorSink,
}
use std::reactive::AsyncEventSource
use std::host::Resumable
use std::wasm::WasmBackend
use source_inspector::{
    TextLoadAction,
    TextLoadTask,
    load_latest_text,
    publish_load_command,
    URL_CAPACITY,
    CONTENT_CAPACITY,
    CONTROL_CAPACITY,
}
use ingot::highlight::{
    Document,
    Token,
    TokenKind,
    document,
    next,
}

const VIEW_CAPACITY: usize = 384
const PATCH_CAPACITY: u32 = 2097152
const GUTTER_CAPACITY: u32 = 65536
const MAX_HIGHLIGHTED_RUNS: u32 = 8191

struct SourceToken {}
struct Ty {}
struct Function {}
struct Property {}
struct Variable {}
struct Keyword {}
struct Comment {}
struct StringToken {}
struct Number {}

struct SourceParts {
    loading: Part<Visibility>,
    ready: Part<Visibility>,
    error: Part<Visibility>,
    empty: Part<Visibility>,
    code: Part<Repeat<SourceToken>>,
    token: Part<Text>,
    ty: Part<Class<Ty>>,
    function: Part<Class<Function>>,
    property: Part<Class<Property>>,
    variable: Part<Class<Variable>>,
    keyword: Part<Class<Keyword>>,
    comment: Part<Class<Comment>>,
    string: Part<Class<StringToken>>,
    number: Part<Class<Number>>,

    gutter: Part<Text>,
    title: Part<Text>,
    error_text: Part<Text>,
    raw: Part<Link>,
}

derive ComponentSchema for SourceParts using ComponentSchemaProvider

enum SourceStatus {
    Empty,
    Loading,
    Ready,
    Error,
}

impl Copy for SourceStatus {}

impl SourceStatus {
    fn is_empty(self) -> bool {
        match self {
            Self::Empty => true,
            _ => false,
        }
    }

    fn is_loading(self) -> bool {
        match self {
            Self::Loading => true,
            _ => false,
        }
    }

    fn is_ready(self) -> bool {
        match self {
            Self::Ready => true,
            _ => false,
        }
    }

    fn is_error(self) -> bool {
        match self {
            Self::Error => true,
            _ => false,
        }
    }
}

pub struct SourceState {
    patch_ptr: u32,
    control_ptr: u32,
    url_ptr: u32,
    content_ptr: u32,
    gutter_ptr: u32,
    url_len: u32,
    content_len: u32,
    request: u32,
    status: SourceStatus,
    connected: bool,
    project_source: bool,
    prevent_default: bool,
}

impl Copy for SourceState {}

pub struct SourceStateEnvelope {
    state: SourceState,
}

impl Copy for SourceStateEnvelope {}

impl SourceState {
    fn idle(self) -> Self {
        let mut next = self
        next.project_source = false
        next.prevent_default = false
        next
    }

    fn connected(self) -> Self {
        let mut next = self.idle()
        next.connected = true
        next.project_source = true
        next
    }

    fn disconnected(self) -> Self {
        let mut next = self.idle()
        next.connected = false
        next
    }

    fn begin_load(self, url_len: u32) -> Self {
        let mut next = self.idle()
        next.url_len = url_len
        next.request = self.request + 1
        next.content_len = 0
        next.status = SourceStatus::Loading
        next.project_source = true
        next.prevent_default = true
        next
    }

    fn apply_loaded(self, task: TextLoadTask) -> Self {
        let mut next = self.idle()
        next.content_len = task.content_len
        next.project_source = true
        next.status = if task.is_http_success() {
            SourceStatus::Ready
        } else {
            SourceStatus::Error
        }
        next
    }

    fn fail_load(self, task: TextLoadTask) -> Self {
        let mut next = self.idle()
        next.content_len = task.content_len
        next.project_source = true
        next.status = SourceStatus::Error
        next
    }
}

const fn label(_ text: String<31>) -> PageText {
    PageText::one(value: text)
}

const fn file_link(
    _ page: PageBuilder<VIEW_CAPACITY>,
    _ file: String<31>,
    _ description: String<31>,
) -> PageBuilder<VIEW_CAPACITY> {
    page.open(element: PageElement::Anchor)
        .attribute(value: PageAttribute::class(value: "file"))
        .attribute(
            value: PageAttribute::href(value: PageText::three(first: "source/", second: file, third: ".view")),
        )
        .attribute(
            value: PageAttribute::action(value: TextLoadAction::Select),
        )
        .open(element: PageElement::Code)
        .text(value: label(file))
        .close()
        .open(element: PageElement::Span)
        .text(value: label(description))
        .close()
        .close()
}

/// Gutter text is separate, so selecting/copying source retains exact bytes.
/// Stop at the allocated capacity; source text itself remains unmodified.
fn line_numbers(_ destination: u32, _ content: Utf8View) -> BrowserString {
    let mut offset: u32 = 0
    let mut line: u32 = 1
    let mut index: u32 = 0
    let mut at_start: bool = true
    while index < content.len() && offset + 12 < GUTTER_CAPACITY {
        if at_start {
            let mut digits: [u8; 10] = [0; 10]
            let mut number: u32 = line
            let mut count: usize = 0
            while number > 0 {
                digits[count] = (48 + number % 10).downcast_truncate()
                number = number / 10
                count = count + 1
            }
            while count > 0 {
                count = count - 1
                BrowserPtr<u8>::from_u32(destination + offset).write(digits[count])
                offset = offset + 1
            }
            BrowserPtr<u8>::from_u32(destination + offset).write(10)
            offset = offset + 1
            at_start = false
        }
        if content.byte(index: index) == 10 {
            line = line + 1
            at_start = true
        }
        index = index + 1
    }
    BrowserString { ptr: destination, len: offset }
}

fn filename(_ url: Utf8View) -> BrowserString {
    let mut index: u32 = 0
    let mut start: u32 = 0
    while index < url.len() {
        if url.byte(index: index) == 47 {
            start = index + 1
        }
        index = index + 1
    }
    url.slice(start: start, end: url.len()).view.browser_string()
}

fn write_run(
    writer: ComponentWriter,
    ui: SourceParts,
    key: u32,
    text: own BrowserString,
    kind: TokenKind,
) -> ComponentWriter {
    writer
        .repeat_item(key: key)
        .set_text(target: ui.token, value: text)
        .set_class(target: ui.token, token: ui.ty, enabled: kind.is_type_name())
        .set_class(target: ui.token, token: ui.function, enabled: kind.is_function())
        .set_class(target: ui.token, token: ui.property, enabled: kind.is_property())
        .set_class(target: ui.token, token: ui.variable, enabled: kind.is_variable())
        .set_class(target: ui.token, token: ui.keyword, enabled: kind.is_keyword())
        .set_class(target: ui.token, token: ui.comment, enabled: kind.is_comment())
        .set_class(target: ui.token, token: ui.string, enabled: kind.is_string())
        .set_class(target: ui.token, token: ui.number, enabled: kind.is_number())
}

actor FeSourceViewer {
    state: SourceState,

    const fn view() -> ComponentView<VIEW_CAPACITY> uses (ComponentComposition) {
        let ui = <SourceParts as ComponentSchema>::component_parts()
        let page = PageBuilder::new()
            .open(element: PageElement::Header)
            .open(element: PageElement::Anchor)
            .attribute(value: PageAttribute::href(value: label("../index.html")))
            .text(value: label("← Mandelbrot")).close()
            .open(element: PageElement::Anchor)
            .attribute(value: PageAttribute::href(value: label("../colors/index.html")))
            .text(value: label("← Color lab")).close()
            .open(element: PageElement::Heading1).text(value: label("Fe source")).close()
            .open(element: PageElement::Paragraph).text(value: label("Renderer, colors and viewer")).close()
            .close()
            .open(element: PageElement::Div).attribute(value: PageAttribute::class(value: "workspace"))
            .open(element: PageElement::Section).attribute(value: PageAttribute::class(value: "files"))
        let page = file_link(page, "lib.fe", "Actor and pass graph")
        let page = file_link(page, "policy.fe", "Camera and quality policy")
        let page = file_link(page, "orbit.fe", "Resumable perturbation")
        let page = file_link(page, "image.fe", "Color, sampling and Gaussian")
        let page = file_link(page, "cache.fe", "GPU cache metadata")
        let page = file_link(page, "palette.fe", "Rich OKLCH palette")
        let page = file_link(page, "partition.fe", "Blue-noise ordering")
        let page = file_link(page, "color_library.fe", "OKLCH and OKLab library")
        let page = file_link(page, "color_demo.fe", "Interactive color lab")
        let page = file_link(page, "viewer.fe", "This Fe source viewer")
        let page = file_link(page, "viewer_highlight.fe", "Fe lexical and semantic colors")
        page.close()
            .open(element: PageElement::Main)
            .open(element: PageElement::Div).attribute(value: PageAttribute::class(value: "file-heading"))
            .open(element: PageElement::Strong).attribute(value: PageAttribute::node(value: ui.title))
            .text(value: label("Choose a file")).close()
            .open(element: PageElement::Anchor).attribute(value: PageAttribute::node(value: ui.raw))
            .attribute(value: PageAttribute::target(value: "_blank"))
            .attribute(value: PageAttribute::rel(value: "noopener"))
            .text(value: label("Raw source ↗")).close().close()
            .open(element: PageElement::Paragraph).attribute(value: PageAttribute::view(value: ui.empty))
            .attribute(value: PageAttribute::class(value: "message"))
            .text(value: label("Choose a module to explore.")).close()
            .open(element: PageElement::Paragraph).attribute(value: PageAttribute::view(value: ui.loading))
            .attribute(value: PageAttribute::class(value: "message"))
            .text(value: label("Loading source…")).close()
            .open(element: PageElement::Pre).attribute(value: PageAttribute::view(value: ui.error))
            .attribute(value: PageAttribute::node(value: ui.error_text))
            .attribute(value: PageAttribute::class(value: "message error")).close()
            .open(element: PageElement::Div).attribute(value: PageAttribute::class(value: "source-lines"))
            .attribute(value: PageAttribute::view(value: ui.ready))
            .open(element: PageElement::Pre).attribute(value: PageAttribute::class(value: "line-numbers"))
            .attribute(value: PageAttribute::node(value: ui.gutter)).close()
            .open(element: PageElement::Pre).attribute(value: PageAttribute::class(value: "source-code"))
            .attribute(value: PageAttribute::node(value: ui.code)).close()
            .close().close().close()
            .open(element: PageElement::Template).attribute(value: PageAttribute::template(value: ui.code))
            .open(element: PageElement::Span)
            .open(element: PageElement::Span).attribute(value: PageAttribute::node(value: ui.token))
            .attribute(value: PageAttribute::class_token(slot: ui.ty, value: "hl-ty"))
            .attribute(value: PageAttribute::class_token(slot: ui.function, value: "hl-function"))
            .attribute(value: PageAttribute::class_token(slot: ui.property, value: "hl-property"))
            .attribute(value: PageAttribute::class_token(slot: ui.variable, value: "hl-variable"))
            .attribute(value: PageAttribute::class_token(slot: ui.keyword, value: "hl-keyword"))
            .attribute(value: PageAttribute::class_token(slot: ui.comment, value: "hl-comment"))
            .attribute(value: PageAttribute::class_token(slot: ui.string, value: "hl-string"))
            .attribute(value: PageAttribute::class_token(slot: ui.number, value: "hl-number"))
            .close().close().close().finish_component()
    }

    fn initial() -> SourceStateEnvelope uses (InitialState) {
        let patch = allocate_component_buffer(capacity: PATCH_CAPACITY)
        let control = allocate_component_buffer(capacity: CONTROL_CAPACITY)
        let url = allocate_component_buffer(capacity: URL_CAPACITY)
        let content = allocate_component_buffer(capacity: CONTENT_CAPACITY)
        let gutter = allocate_component_buffer(capacity: GUTTER_CAPACITY)
        publish_load_command(
            control: control.ptr,
            revision: 0,
            request: 0,
            url_len: 0,
            active: false,
        )
        SourceStateEnvelope {
            state: SourceState {
                patch_ptr: patch.ptr,
                control_ptr: control.ptr,
                url_ptr: url.ptr,
                content_ptr: content.ptr,
                gutter_ptr: gutter.ptr,
                url_len: 0,
                content_len: 0,
                request: 0,
                status: SourceStatus::Empty,
                connected: false,
                project_source: true,
                prevent_default: false,
            },
        }
    }

    fn load_resources(self) -> u32 uses (ScopedTask) {
        with (
            AsyncEventSource<WasmBackend, ActorNotification> = BrowserActorNotifications::new(),
            Select<WasmBackend, u32> = Resumable {},
            PendingCancellation<WasmBackend> = Resumable {},
            ActorSink<WasmBackend, ComponentEvent<TextLoadAction, TextLoadTask>> = BrowserActorSink {},
            Suspend<WasmBackend, u32> = Resumable {},
        ) {
            load_latest_text(
                control: self.state.control_ptr,
                url: self.state.url_ptr,
                content: self.state.content_ptr,
            )
        }
    }

    fn receive(
        self,
        event: own ComponentEvent<TextLoadAction, TextLoadTask>,
    ) -> SourceStateEnvelope uses (ResidentTransition) {
        let mut next = self.state.idle()
        match event.kind {
            ComponentEventKind::Connected => {
                next = self.state.connected()
            }
            ComponentEventKind::Disconnected => {
                next = self.state.disconnected()
                publish_load_command(
                    control: next.control_ptr,
                    revision: next.request + 1,
                    request: next.request,
                    url_len: next.url_len,
                    active: false,
                )
                BrowserActorNotifications::new().notify()
            }
            ComponentEventKind::Activate => {
                if self.state.connected {
                    match event.target {
                        TextLoadAction::Select => {
                            let copied = Utf8Buffer::empty(
                                ptr: self.state.url_ptr,
                                capacity: URL_CAPACITY,
                            ).replace_browser(event.text)
                            if copied.valid && !copied.truncated {
                                next = self.state.begin_load(url_len: copied.buffer.len())
                                publish_load_command(
                                    control: next.control_ptr,
                                    revision: next.request,
                                    request: next.request,
                                    url_len: next.url_len,
                                    active: true,
                                )
                                BrowserActorNotifications::new().notify()
                            }
                        }
                        _ => {}
                    }
                }
            }
            ComponentEventKind::TaskMessage => {
                if event.task.matches_request(
                    connected: self.state.connected,
                    active_request: self.state.request,
                ) {
                    match event.target {
                        TextLoadAction::TextLoaded => {
                            next = self.state.apply_loaded(task: event.task)
                        }
                        TextLoadAction::TextFailed => {
                            next = self.state.fail_load(task: event.task)
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        SourceStateEnvelope { state: next }
    }

    fn project(self) -> ComponentPatch uses (ProjectState) {
        let state = self.state
        let ui = <SourceParts as ComponentSchema>::component_parts()
        let ready = state.status.is_ready()
        let visible = VisibleParts::none()
            .show_if(target: ui.ready, visible: ready)
            .show_if(target: ui.empty, visible: state.status.is_empty())
            .show_if(target: ui.loading, visible: state.status.is_loading())
            .show_if(target: ui.error, visible: state.status.is_error())
        let requested = Utf8Buffer::with_len(
            ptr: state.url_ptr,
            len: state.url_len,
            capacity: URL_CAPACITY,
        ).view()
        let url = if requested.len() > 5
            && requested.slice(start: requested.len() - 5, end: requested.len()).view.equals_literal([46, 118, 105, 101, 119])
        {
            requested.slice(start: 0, end: requested.len() - 5).view
        } else {
            requested
        }
        let content = Utf8Buffer::with_len(
            ptr: state.content_ptr,
            len: state.content_len,
            capacity: CONTENT_CAPACITY,
        ).view()
        let mut writer = ComponentWriter::new(
            buffer: BrowserBytes { ptr: state.patch_ptr, len: PATCH_CAPACITY },
        )
        // Unrelated events preserve browser-owned text selection.
        if !state.project_source {
            return ComponentPatch::new(
                visible: visible,
                focus_target: TextLoadAction::Idle,
                prevent_default: state.prevent_default,
                commands: writer.finish(),
            )
        }
        if state.url_len > 0 {
            writer = writer.set_href(target: ui.raw, value: url.browser_string())
                .set_text(target: ui.title, value: filename(url))
        }
        writer = writer.repeat_begin(region: ui.code)
        if ready {
            let doc: Document = document(content)
            let mut at: u32 = 0
            let mut tokens: u32 = 0
            while at < doc.text.len() {
                let token = if tokens >= MAX_HIGHLIGHTED_RUNS {
                    Token::plain_tail(doc.text.len())
                } else {
                    next(doc, at)
                }
                writer = write_run(
                    writer: writer,
                    ui: ui,
                    key: at + 1,
                    text: doc.text.slice(start: at, end: token.end).view.browser_string(),
                    kind: token.kind,
                )
                at = token.end
                tokens = tokens + 1
            }
            writer = writer.repeat_end()
                .set_text(target: ui.gutter, value: line_numbers(state.gutter_ptr, doc.text))
        } else {
            writer = writer.repeat_end()
            writer = writer.set_text(target: ui.error_text, value: content.browser_string())
        }
        ComponentPatch::new(
            visible: visible,
            focus_target: TextLoadAction::Idle,
            prevent_default: state.prevent_default,
            commands: writer.finish(),
        )
    }
}
