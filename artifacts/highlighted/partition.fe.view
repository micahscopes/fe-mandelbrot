FEH1
7445

//! Deterministic blue-noise ranks, generated by tools/mb2-preview/generators/blue-noise.py.
//! A packed 16x16 inverse rank tile. Initialized once, reused without allocation.

use core::default::Default
use core::marker::Copy
use fmath::{PixelSample, from_i32, to_i32}
use ingot::orbit::PackedReference
use ingot::policy::iteration_limit

extern {
    const fn __bitcast<From, To>(_: From) -> To
}

pub fn order_word(_ index: u32) -> u32 {
    match index {
        0 => 1943330376,
        1 => 3928788513,
        2 => 2057377159,
        3 => 3787149511,
        4 => 1829590296,
        5 => 4148900789,
        6 => 2486151614,
        7 => 3238686979,
        8 => 1325361052,
        9 => 1407573046,
        10 => 2526071130,
        11 => 2326997505,
        12 => 385642472,
        13 => 3812732533,
        14 => 950561838,
        15 => 1754407903,
        16 => 1158661820,
        17 => 3263957308,
        18 => 2413491554,
        19 => 210305685,
        20 => 1698287439,
        21 => 3126601191,
        22 => 3035464241,
        23 => 2942937058,
        24 => 394140191,
        25 => 3679951683,
        26 => 2718186976,
        27 => 3179700439,
        28 => 1962545482,
        29 => 905877956,
        30 => 3357310128,
        31 => 1592021255,
        32 => 3424813127,
        33 => 2643710328,
        34 => 1530866102,
        35 => 3994347860,
        36 => 1928404394,
        37 => 1790015222,
        38 => 2667292215,
        39 => 3541058125,
        40 => 2144188715,
        41 => 3599475720,
        42 => 3227813924,
        43 => 3962630985,
        44 => 1561254273,
        45 => 2217192534,
        46 => 2535170288,
        47 => 3279770117,
        48 => 4174254681,
        49 => 3419781182,
        50 => 2070952756,
        51 => 1089446775,
        52 => 3947272729,
        53 => 3869241886,
        54 => 2909714307,
        55 => 2032579122,
        56 => 3506266956,
        57 => 1727309305,
        58 => 1629502154,
        59 => 321437581,
        60 => 1808084376,
        61 => 2245187805,
        62 => 1477140292,
        63 => 2433133312,
        _ => 0,
    }
}

pub fn order_block(_ block_index: u32) -> PackedReference {
    let i: u32 = block_index * 8
    PackedReference::from_words(
        order_word(i),
        order_word(i + 1),
        order_word(i + 2),
        order_word(i + 3),
        order_word(i + 4),
        order_word(i + 5),
        order_word(i + 6),
        order_word(i + 7),
    )
}

pub fn unpack_order_byte(_ block: PackedReference, _ rank: u32) -> u32 {
    let packed_order: u32 = block.word((rank >> 2) & 7)
    (packed_order >> ((rank & 3) * 8)) & 255
}

fn phase_offset(_ x: u32, _ y: u32, _ phases: u32) -> u32 {
    let a: f32 = from_i32(__bitcast<u32, i32>(x)) * 0.06711056
        + from_i32(__bitcast<u32, i32>(y)) * 0.00583715
    let inner: f32 = a - from_i32(to_i32(a))
    let b: f32 = inner * 52.9829189
    let noise: f32 = b - from_i32(to_i32(b))
    __bitcast<i32, u32>(to_i32(noise * from_i32(__bitcast<u32, i32>(phases))))
}

// IGN from Jorge Jimenez's 2014 presentation. Used only to decorrelate the
// bijective local phase permutations, not claimed to be a blue-noise mask.
pub fn phase_order(_ phase: u32, _ x: u32, _ y: u32, _ stride: u32) -> u32 {
    let phases: u32 = stride * stride
    let offset: u32 = phase_offset(x, y, phases)
    // gcd(2*stride+1,stride^2)=1: every local pixel is visited exactly once.
    (phase * (2 * stride + 1) + offset) % phases
}

pub fn phase_order_rect(_ phase: u32, _ x: u32, _ y: u32, _ sx: u32, _ sy: u32) -> u32 {
    let phases: u32 = sx * sy
    let offset: u32 = phase_offset(x, y, phases)
    // A rotation (or reverse rotation) is bijective for every rectangular grid.
    let direction: u32 = if (offset & 1) == 0 { 1 } else { phases - 1 }
    (phase * direction + offset) % phases
}

pub struct CohortPixel {
    pub x: u32,
    pub y: u32,
    pub index: u32,
    pub active: bool,
}

impl Copy for CohortPixel {}

impl Default for CohortPixel {
    fn default() -> Self {
        CohortPixel {
            x: 0,
            y: 0,
            index: 0,
            active: false,
        }
    }
}

impl CohortPixel {
    pub fn at(_ x: u32, _ y: u32, _ res: f32) -> Self {
        let in_bounds: bool = from_i32(__bitcast<u32, i32>(x)) < res
            && from_i32(__bitcast<u32, i32>(y)) < res
        CohortPixel {
            x: x,
            y: y,
            index: (y << 11) | x,
            active: in_bounds,
        }
    }

    pub fn sample(self) -> PixelSample {
        PixelSample::ordered_2x2(
            __bitcast<u32, i32>(self.x),
            __bitcast<u32, i32>(self.y),
        )
    }

    pub fn offset_sample(self, _ ox: f32, _ oy: f32) -> PixelSample {
        let base: PixelSample = self.sample()
        PixelSample {
            x: base.x + ox,
            y: base.y + oy,
        }
    }
}

pub fn seed_pixel(
    _ order_block: PackedReference,
    _ rank: u32,
    _ gx: u32,
    _ gy: u32,
    _ res: f32,
) -> CohortPixel {
    let stride: u32 = __bitcast<i32, u32>(to_i32((res + 511.0) / 512.0))
    let position: u32 = unpack_order_byte(order_block, rank)
    let tile_x: u32 = gx / 4
    let tile_y: u32 = gy / 4
    // Stable toroidal translations break coherent repetition between tiles.
    let sx: u32 = ((position & 15) + tile_x * 13 + tile_y * 7) & 15
    let sy: u32 = ((position >> 4) + tile_x * 5 + tile_y * 11) & 15
    let x: u32 = (tile_x * 16 + sx) * stride
    let y: u32 = (tile_y * 16 + sy) * stride
    CohortPixel::at(x, y, res)
}

pub struct RefinementSchedule {
    pub limit: u32,
    pub rounds: u32,
    pub sx: u32,
    pub sy: u32,
    pub phases: u32,
    pub aa_stride: u32,
}

impl Copy for RefinementSchedule {}

impl RefinementSchedule {
    pub fn for_view(_ zoom: f32, _ res: f32) -> Self {
        let limit: u32 = iteration_limit(zoom)
        let rounds: u32 = (limit + 2047) / 2048
        let sx: u32 = __bitcast<i32, u32>(to_i32((res + 127.0) / 128.0))
        let sy: u32 = __bitcast<i32, u32>(to_i32((res + 255.0) / 256.0))
        RefinementSchedule {
            limit: limit,
            rounds: rounds,
            sx: sx,
            sy: sy,
            phases: sx * sy,
            aa_stride: sy,
        }
    }

    pub fn refine_steps(self) -> u32 {
        self.rounds * self.phases
    }

    pub fn total_steps(self) -> u32 {
        self.refine_steps() + self.aa_stride * self.aa_stride
    }

    pub fn rect_pixel(self, _ cursor: u32, _ gx: u32, _ gy: u32, _ res: f32) -> CohortPixel {
        if cursor >= self.refine_steps() {
            return CohortPixel::default()
        }
        let phase: u32 = phase_order_rect(cursor / self.rounds, gx, gy, self.sx, self.sy)
        let x: u32 = gx * self.sx + phase % self.sx
        let y: u32 = gy * self.sy + phase / self.sx
        CohortPixel::at(x, y, res)
    }

    pub fn aa_pixel(self, _ cursor: u32, _ gx: u32, _ gy: u32, _ res: f32) -> CohortPixel {
        let start: u32 = self.refine_steps()
        let aa_phases: u32 = self.aa_stride * self.aa_stride
        if cursor < start || cursor >= start + aa_phases {
            return CohortPixel::default()
        }
        let phase: u32 = phase_order(cursor - start, gx, gy, self.aa_stride)
        let x: u32 = gx * self.aa_stride + phase % self.aa_stride
        let y: u32 = gy * self.aa_stride + phase / self.aa_stride
        CohortPixel::at(x, y, res)
    }
}
