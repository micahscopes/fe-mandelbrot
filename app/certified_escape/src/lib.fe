//! Exact dyadic interval arithmetic and local Mandelbrot checks.
//! This receives the witness; it is not a ZK proof or private verifier.
//! The deep-offset family uses an exact periodic reference; general regions
//! use strict escape or finite sufficient boundedness certificates.
//! Resident jobs reuse one scalar-word tape across incremental steps.
use core::{BrowserBytes, BrowserPtr, alloc_browser_bytes}

const STRIDE: u32 = 640
const SLOTS: u32 = 65
const EXP_LIMIT: i64 = 1000000000

struct D { slot: u32, len: u32, exp: i64, neg: bool, valid: bool }
impl core::marker::Copy for D {}
struct I { lo: D, hi: D }
impl core::marker::Copy for I {}
struct C { re: I, im: I }
impl core::marker::Copy for C {}
struct Engine { ptr: u32, bits: u32 }
impl core::marker::Copy for Engine {}

impl Engine {
    fn new(_ bits: u32) -> Self {
        Self {
            ptr: alloc_browser_bytes((SLOTS * STRIDE + 4) * 4).address(),
            bits: bits,
        }
    }
    fn load(self, _ slot: u32, _ index: u32) -> u32 {
        let p: BrowserPtr<u32> = BrowserPtr::from_u32(
            self.ptr + (slot * STRIDE + index) * 4,
        )
        p.read()
    }
    fn store(self, _ slot: u32, _ index: u32, _ value: u32) {
        let p: BrowserPtr<u32> = BrowserPtr::from_u32(
            self.ptr + (slot * STRIDE + index) * 4,
        )
        p.write(value)
    }
    fn zero(self) -> D {
        D { slot: 64, len: 0, exp: 0, neg: false, valid: true }
    }
    fn invalid(self) -> D {
        D { slot: 64, len: 0, exp: 0, neg: false, valid: false }
    }
    fn integer(self, _ slot: u32, _ value: i32, _ exp: i64) -> D {
        let neg = value < 0
        let mut magnitude: u32 = (if neg { -value } else { value }).downcast_truncate()
        let mut len: u32 = 0
        while magnitude != 0 {
            self.store(slot, len, magnitude & 8191)
            magnitude = magnitude >> 13
            len = len + 1
        }
        self.normal(
            D { slot: slot, len: len, exp: exp, neg: neg, valid: true },
        )
    }
    fn word(self, _ a: D, _ index: u32) -> u32 {
        if index < a.len {
            self.load(a.slot, index)
        } else {
            0
        }
    }
    fn top(self, _ a: D) -> i64 {
        if a.len == 0 { return 0 }
        let mut high = self.word(a, a.len - 1)
        let mut bits: i64 = 0
        while high != 0 {
            high = high >> 1
            bits = bits + 1
        }
        a.exp + ((a.len - 1) * 13) as i64 + bits
    }
    // Extract one base8192 digit after aligning to an arbitrary binary grid.
    fn digit(self, _ a: D, _ grid: i64, _ index: u32) -> u32 {
        let offset = grid + (index * 13) as i64 - a.exp
        if offset <= -13 { return 0 }
        if offset < 0 {
            return (self.word(a, 0) << (-offset).downcast_truncate()) & 8191
        }
        let positive: u64 = offset.downcast_truncate()
        let limb: u32 = (positive / 13).downcast_truncate()
        let shift: u32 = (positive % 13).downcast_truncate()
        let low = self.word(a, limb) >> shift
        if shift == 0 { return low }
        (low | (self.word(a, limb + 1) << (13 - shift))) & 8191
    }
    fn normal(self, _ value: D) -> D {
        let mut a = value
        if !a.valid || a.len > STRIDE || a.exp < -EXP_LIMIT || a.exp > EXP_LIMIT {
            return self.invalid()
        }
        while a.len > 0 && self.word(a, a.len - 1) == 0 {
            a.len = a.len - 1
        }
        if a.len == 0 {
            a.exp = 0
            a.neg = false
            return a
        }
        let mut whole: u32 = 0
        while self.word(a, whole) == 0 {
            whole = whole + 1
        }
        let mut low = self.word(a, whole)
        let mut shift: u32 = whole * 13
        while (low & 1) == 0 {
            shift = shift + 1
            low = low >> 1
        }
        let original = a
        let grid = a.exp + shift as i64
        let mut i: u32 = 0
        while i < a.len {
            self.store(a.slot, i, self.digit(original, grid, i))
            i = i + 1
        }
        a.exp = grid
        while a.len > 0 && self.word(a, a.len - 1) == 0 {
            a.len = a.len - 1
        }
        if a.exp < -EXP_LIMIT || a.exp > EXP_LIMIT {
            return self.invalid()
        }
        a
    }
    fn copy(self, _ slot: u32, _ a: D) -> D {
        let mut i: u32 = 0
        while i < a.len {
            self.store(slot, i, self.word(a, i))
            i = i + 1
        }
        D { slot: slot, len: a.len, exp: a.exp, neg: a.neg, valid: a.valid }
    }
    fn magnitude_cmp(self, _ a: D, _ b: D) -> i32 {
        if a.len == 0 {
            return if b.len == 0 { 0 } else { -1 }
        }
        if b.len == 0 { return 1 }
        let ta = self.top(a)
        let tb = self.top(b)
        if ta != tb {
            return if ta < tb { -1 } else { 1 }
        }
        let grid = if a.exp < b.exp { a.exp } else { b.exp }
        let span: u64 = (ta - grid + 12).downcast_truncate()
        let mut width: u32 = (span / 13).downcast_truncate()
        while width > 0 {
            width = width - 1
            let x = self.digit(a, grid, width)
            let y = self.digit(b, grid, width)
            if x != y {
                return if x < y { -1 } else { 1 }
            }
        }
        0
    }
    fn cmp(self, _ a: D, _ b: D) -> i32 {
        if a.neg != b.neg {
            return if a.neg { -1 } else { 1 }
        }
        let result = self.magnitude_cmp(a, b)
        if a.neg { -result } else { result }
    }
    fn sticky(self, _ a: D, _ dropped: i64) -> bool {
        if dropped <= 0 {
            return false
        }
        let mut i: u32 = 0
        while i < a.len {
            let remaining = dropped - (i * 13) as i64
            if remaining <= 0 {
                return false
            }
            let word = self.word(a, i)
            if remaining >= 13 {
                if word != 0 { return true }
            } else if (word & ((1 << remaining.downcast_truncate()) - 1)) != 0 {
                return true
            }
            i = i + 1
        }
        false
    }
    fn quantize(self, _ slot: u32, _ a: D, _ grid: i64, _ up: bool) -> D {
        if !a.valid {
            return self.invalid()
        }
        if a.len == 0 || grid <= a.exp {
            return self.copy(slot, a)
        }
        let increment = self.sticky(a, grid - a.exp) && (up != a.neg)
        let top = self.top(a)
        let span: u64 = (if top <= grid { 0 } else { top - grid + 12 }).downcast_truncate()
        let width: u32 = (span / 13).downcast_truncate()
        if width >= STRIDE {
            return self.invalid()
        }
        let mut carry: u32 = if increment { 1 } else { 0 }
        let mut i: u32 = 0
        while i < width {
            let total = self.digit(a, grid, i) + carry
            self.store(slot, i, total & 8191)
            carry = total >> 13
            i = i + 1
        }
        if carry != 0 {
            self.store(slot, i, carry)
            i = i + 1
        }
        self.normal(
            D { slot: slot, len: i, exp: grid, neg: a.neg, valid: true },
        )
    }
    fn rounded(self, _ slot: u32, _ a: D, _ up: bool) -> D {
        let grid = self.top(a) - self.bits as i64
        self.quantize(slot, a, grid, up)
    }
    fn add(self, _ slot: u32, _ a: D, _ b: D, _ up: bool) -> D {
        if !a.valid || !b.valid {
            return self.invalid()
        }
        if slot == 58
            || slot == 59
            || a.slot == 58
            || a.slot == 59
            || b.slot == 58
            || b.slot == 59 {
            return self.invalid()
        }
        if a.len == 0 {
            return self.rounded(slot, b, up)
        }
        if b.len == 0 {
            return self.rounded(slot, a, up)
        }
        if a.neg != b.neg && self.magnitude_cmp(a, b) == 0 {
            return self.copy(slot, self.zero())
        }
        let maximum = if self.top(a) > self.top(b) {
            self.top(a)
        } else {
            self.top(b)
        }
        let grid = maximum - self.bits as i64
        let x = self.quantize(58, a, grid, up)
        let y = self.quantize(59, b, grid, up)
        if !x.valid || !y.valid {
            return self.invalid()
        }
        let ordering = self.magnitude_cmp(x, y)
        let large = if ordering >= 0 { x } else { y }
        let small = if ordering >= 0 { y } else { x }
        let same = x.neg == y.neg
        let mut carry: u32 = 0
        let mut i: u32 = 0
        let width = (self.bits + 12) / 13 + 1
        while i < width {
            let left = self.digit(large, grid, i)
            let right = self.digit(small, grid, i)
            if same {
                let total = left + right + carry
                self.store(slot, i, total & 8191)
                carry = total >> 13
            } else {
                let total = left + 8192 - right - carry
                self.store(slot, i, total & 8191)
                carry = if total < 8192 { 1 } else { 0 }
            }
            i = i + 1
        }
        let result = self
            .normal(
                D { slot: slot, len: width, exp: grid, neg: large.neg, valid: true },
            )
        self.rounded(slot, result, up)
    }
    fn product(self, _ a: D, _ b: D) -> D {
        if !a.valid || !b.valid || a.slot == 60 || b.slot == 60 {
            return self.invalid()
        }
        if a.len == 0 || b.len == 0 {
            return self.zero()
        }
        let width = a.len + b.len
        if width >= STRIDE {
            return self.invalid()
        }
        let mut i: u32 = 0
        while i < width {
            self.store(60, i, 0)
            i = i + 1
        }
        i = 0
        while i < a.len {
            let mut carry: u32 = 0
            let mut j: u32 = 0
            while j < b.len {
                let total = self.load(60, i + j) + self.word(a, i) * self.word(b, j) + carry
                self.store(60, i + j, total & 8191)
                carry = total >> 13
                j = j + 1
            }
            self.store(60, i + b.len, carry)
            i = i + 1
        }
        self.normal(
            D { slot: 60, len: width, exp: a.exp + b.exp, neg: a.neg != b.neg, valid: true },
        )
    }
    fn multiply(self, _ slot: u32, _ a: D, _ b: D, _ up: bool) -> D {
        let exact = self.product(a, b)
        self.rounded(slot, exact, up)
    }
    fn add_interval(self, _ slot: u32, _ a: I, _ b: I) -> I {
        I { lo: self.add(slot, a.lo, b.lo, false), hi: self.add(slot + 1, a.hi, b.hi, true) }
    }
    fn mul_interval(self, _ slot: u32, _ a: I, _ b: I) -> I {
        let mut lo = self.zero()
        let mut hi = self.zero()
        let mut i: u32 = 0
        while i < 4 {
            let x = if i < 2 { a.lo } else { a.hi }
            let y = if (i & 1) == 0 { b.lo } else { b.hi }
            let exact = self.product(x, y)
            let low = self.rounded(52, exact, false)
            let high = self.rounded(53, exact, true)
            if !low.valid || !high.valid {
                return I { lo: self.invalid(), hi: self.invalid() }
            }
            if i == 0 || self.cmp(low, lo) < 0 {
                lo = self.copy(slot, low)
            }
            if i == 0 || self.cmp(high, hi) > 0 {
                hi = self.copy(slot + 1, high)
            }
            i = i + 1
        }
        I { lo: lo, hi: hi }
    }
    fn square_interval(self, _ slot: u32, _ a: I) -> I {
        let first = self.product(a.lo, a.lo)
        let mut lo = self.rounded(slot, first, false)
        let mut hi = self.rounded(slot + 1, first, true)
        let second = self.product(a.hi, a.hi)
        let lower = self.rounded(52, second, false)
        let upper = self.rounded(53, second, true)
        if !lo.valid || !hi.valid || !lower.valid || !upper.valid {
            return I { lo: self.invalid(), hi: self.invalid() }
        }
        if self.cmp(lower, lo) < 0 {
            lo = self.copy(slot, lower)
        }
        if self.cmp(upper, hi) > 0 {
            hi = self.copy(slot + 1, upper)
        }
        if self.cmp(a.lo, self.zero()) <= 0 && self.cmp(a.hi, self.zero()) >= 0 {
            lo = self.copy(slot, self.zero())
        }
        I { lo: lo, hi: hi }
    }
    fn plus(self, _ slot: u32, _ a: C, _ b: C) -> C {
        C { re: self.add_interval(slot, a.re, b.re), im: self.add_interval(slot + 2, a.im, b.im) }
    }
    fn copy_complex(self, _ slot: u32, _ a: C) -> C {
        C {
            re: I { lo: self.copy(slot, a.re.lo), hi: self.copy(slot + 1, a.re.hi) },
            im: I { lo: self.copy(slot + 2, a.im.lo), hi: self.copy(slot + 3, a.im.hi) },
        }
    }
}

fn negative(_ a: D) -> D {
    D { slot: a.slot, len: a.len, exp: a.exp, neg: a.len != 0 && !a.neg, valid: a.valid }
}
fn neg_interval(_ a: I) -> I {
    I { lo: negative(a.hi), hi: negative(a.lo) }
}
fn exact_interval(_ a: D) -> I {
    I { lo: a, hi: a }
}

pub struct RunRequest { pub depth: u32, pub precision: u32, pub max_steps: u32 }
pub struct RunResult { pub code: u32, pub step: u32, pub precision: u32, pub scratch_bytes: u32 }

pub fn certify(_ request: own RunRequest) -> RunResult {
    if request.precision < 32
        || request.precision > 4096
        || request.depth == 0
        || request.depth > 16384
        || request.max_steps == 0
        || request.max_steps > 10000 {
        return RunResult { code: 2, step: 0, precision: request.precision, scratch_bytes: 0 }
    }
    let e = Engine::new(request.precision)
    let one = e.integer(61, 1, 0)
    let four = e.integer(63, 1, 2)
    let tiny = e.integer(62, 1, -(request.depth as i64))
    let zero = exact_interval(e.zero())
    let offset = C { re: exact_interval(tiny), im: zero }
    let mut delta = C { re: zero, im: zero }
    let mut step: u32 = 0
    while step < request.max_steps {
        // Reference orbit:0,i,-1+i,-i,-1+i,-i,... . Multiplication by
        // these exact Gaussian integers is sign changes/addition only.
        let cross = if step == 0 {
            C { re: zero, im: zero }
        } else if step == 1 {
            C { re: neg_interval(delta.im), im: delta.re }
        } else if (step & 1) == 0 {
            C {
                re: e.add_interval(12, neg_interval(delta.re), neg_interval(delta.im)),
                im: e.add_interval(14, delta.re, neg_interval(delta.im)),
            }
        } else {
            C { re: delta.im, im: neg_interval(delta.re) }
        }
        let doubled = e.plus(24, cross, cross)
        let re_squared = e.square_interval(16, delta.re)
        let im_squared = e.square_interval(18, delta.im)
        let mixed = e.mul_interval(20, delta.re, delta.im)
        let square = C {
            re: e.add_interval(8, re_squared, neg_interval(im_squared)),
            im: e.add_interval(10, mixed, mixed),
        }
        let sum = e.plus(28, doubled, square)
        let next = e.plus(4, sum, offset)
        delta = e.copy_complex(0, next)
        step = step + 1
        let reference = if step == 1 {
            C { re: zero, im: exact_interval(one) }
        } else if (step & 1) == 0 {
            C { re: exact_interval(negative(one)), im: exact_interval(one) }
        } else {
            C { re: zero, im: exact_interval(negative(one)) }
        }
        let z = e.plus(32, reference, delta)
        let re_norm = e.square_interval(36, z.re)
        let im_norm = e.square_interval(38, z.im)
        let norm = e.add_interval(40, re_norm, im_norm)
        if !norm.lo.valid || !norm.hi.valid {
            return RunResult {
                code: 1,
                step: step,
                precision: request.precision,
                scratch_bytes: (SLOTS * STRIDE + 4) * 4,
            }
        }
        if e.cmp(norm.lo, four) > 0 {
            return RunResult {
                code: 0,
                step: step,
                precision: request.precision,
                scratch_bytes: (SLOTS * STRIDE + 4) * 4,
            }
        }
    }
    RunResult {
        code: 1,
        step: step,
        precision: request.precision,
        scratch_bytes: (SLOTS * STRIDE + 4) * 4,
    }
}

pub struct ArithmeticRequest {
    pub left: i32,
    pub left_exp: i32,
    pub right: i32,
    pub right_exp: i32,
    pub precision: u32,
    pub operation: u32,
}
pub struct ArithmeticResult {
    pub code: u32,
    pub lower: BrowserBytes,
    pub upper: BrowserBytes,
    pub lower_exp: i64,
    pub upper_exp: i64,
    pub lower_negative: bool,
    pub upper_negative: bool,
}
fn encoded(_ e: Engine, _ a: D) -> BrowserBytes {
    let ptr = alloc_browser_bytes(a.len * 4)
    let mut i: u32 = 0
    while i < a.len {
        let target: BrowserPtr<u32> = BrowserPtr::from_u32(ptr.address() + i * 4)
        target.write(e.word(a, i))
        i = i + 1
    }
    BrowserBytes { ptr: ptr.address(), len: a.len * 4 }
}
pub fn arithmetic(_ request: own ArithmeticRequest) -> ArithmeticResult {
    let e = Engine::new(
        if request.precision >= 2 && request.precision <= 4096 {
            request.precision
        } else {
            128
        },
    )
    let mut lo = e.invalid()
    let mut hi = e.invalid()
    if request.precision >= 2
        && request.precision <= 4096
        && request.left >= -1000000000
        && request.left <= 1000000000
        && request.right >= -1000000000
        && request.right <= 1000000000
        && request.operation <= 1 {
        let a = e.integer(0, request.left, request.left_exp as i64)
        let b = e.integer(1, request.right, request.right_exp as i64)
        if request.operation == 0 {
            lo = e.add(2, a, b, false)
            hi = e.add(3, a, b, true)
        } else {
            lo = e.multiply(2, a, b, false)
            hi = e.multiply(3, a, b, true)
        }
    }
    ArithmeticResult {
        code: if lo.valid && hi.valid { 0 } else { 2 },
        lower: encoded(e, lo),
        upper: encoded(e, hi),
        lower_exp: lo.exp,
        upper_exp: hi.exp,
        lower_negative: lo.neg,
        upper_negative: hi.neg,
    }
}
pub fn wasm_anchor(_ x: i32, _ y: i32, _ res: f32) -> u32 {
    0
}

pub struct WordArithmeticRequest {
    pub left: BrowserBytes,
    pub right: BrowserBytes,
    pub left_exp: i32,
    pub right_exp: i32,
    pub left_negative: bool,
    pub right_negative: bool,
    pub precision: u32,
    pub operation: u32,
}
fn read_words(_ e: Engine, _ slot: u32, _ bytes: BrowserBytes, _ negative: bool, _ exp: i32) -> D {
    if bytes.len > 316 * 4 || (bytes.len % 4) != 0 {
        return e.invalid()
    }
    let mut i: u32 = 0
    while i < bytes.len / 4 {
        let pointer: BrowserPtr<u32> = BrowserPtr::from_u32(bytes.ptr + i * 4)
        let word = pointer.read()
        if word >= 8192 {
            return e.invalid()
        }
        e.store(slot, i, word)
        i = i + 1
    }
    e.normal(
        D { slot: slot, len: i, exp: exp as i64, neg: negative, valid: true },
    )
}
pub fn arithmetic_words(_ request: own WordArithmeticRequest) -> ArithmeticResult {
    let e = Engine::new(
        if request.precision >= 2 && request.precision <= 4096 {
            request.precision
        } else {
            128
        },
    )
    let mut lo = e.invalid()
    let mut hi = e.invalid()
    if request.precision >= 2 && request.precision <= 4096 && request.operation <= 1 {
        let a = read_words(
            e,
            0,
            request.left,
            request.left_negative,
            request.left_exp,
        )
        let b = read_words(
            e,
            1,
            request.right,
            request.right_negative,
            request.right_exp,
        )
        if request.operation == 0 {
            lo = e.add(2, a, b, false)
            hi = e.add(3, a, b, true)
        } else {
            lo = e.multiply(2, a, b, false)
            hi = e.multiply(3, a, b, true)
        }
    }
    ArithmeticResult {
        code: if lo.valid && hi.valid { 0 } else { 2 },
        lower: encoded(e, lo),
        upper: encoded(e, hi),
        lower_exp: lo.exp,
        upper_exp: hi.exp,
        lower_negative: lo.neg,
        upper_negative: hi.neg,
    }
}

// Local general-region checker. This API receives a witness; it is NOT a ZK proof.
// Wire six exact dyadics: witness re/im, public center re/im, radius x/y.
// Each record is [sign, exponent-sign, exponent-magnitude, count, base8192 words].
pub struct RegionRequest {
    pub selection: BrowserBytes,
    pub shape: u32,
    pub claim: u32,
    pub precision: u32,
    pub max_steps: u32,
}
pub struct RegionResult { pub code: u32, pub step: u32, pub certificate: u32 }
struct Decoded { value: D, next: u32 }
fn wire_word(_ bytes: BrowserBytes, _ i: u32) -> u32 {
    let p: BrowserPtr<u32> = BrowserPtr::from_u32(bytes.ptr + i * 4)
    p.read()
}
fn decode_dyadic(_ e: Engine, _ slot: u32, _ bytes: BrowserBytes, _ cursor: u32) -> Decoded {
    let size = bytes.len / 4
    if cursor > size || size - cursor < 4 {
        return Decoded { value: e.invalid(), next: size + 1 }
    }
    let sign = wire_word(bytes, cursor)
    let exponent_sign = wire_word(bytes, cursor + 1)
    let magnitude = wire_word(bytes, cursor + 2)
    let count = wire_word(bytes, cursor + 3)
    if sign > 1
        || exponent_sign > 1
        || magnitude > 1000000000
        || count > 316
        || count > size - cursor - 4 {
        return Decoded { value: e.invalid(), next: size + 1 }
    }
    let mut i: u32 = 0
    while i < count {
        let word = wire_word(bytes, cursor + 4 + i)
        if word >= 8192 {
            return Decoded { value: e.invalid(), next: size + 1 }
        }
        e.store(slot, i, word)
        i = i + 1
    }
    let exp = if exponent_sign == 1 {
        -(magnitude as i64)
    } else {
        magnitude as i64
    }
    Decoded {
        value: e.normal(
            D { slot: slot, len: count, exp: exp, neg: sign == 1, valid: true },
        ),
        next: cursor + 4 + count,
    }
}
fn valid_interval(_ a: I) -> bool {
    a.lo.valid && a.hi.valid
}
fn point_interval(_ e: Engine, _ slot: u32, _ a: D) -> I {
    I { lo: e.rounded(slot, a, false), hi: e.rounded(slot + 1, a, true) }
}
fn norm_squared(_ e: Engine, _ a: C) -> I {
    let re = e.square_interval(36, a.re)
    let im = e.square_interval(38, a.im)
    e.add_interval(40, re, im)
}
// A finite sufficient certificate: |c|<=1/4 makes |z|<=1/2 invariant.
// Two further strict-interior tests use the main cardioid and period2 bulb.
// Source/formulas: mathr.co.uk/blog/2022-11-19_cardioid_and_bulb_checking.html
fn bounded_certificate(_ e: Engine, _ point: C) -> u32 {
    let one = e.integer(61, 1, 0)
    let sixteenth = e.integer(63, 1, -4)
    let norm = norm_squared(e, point)
    if valid_interval(norm) && e.cmp(norm.hi, sixteenth) <= 0 {
        return 1
    }
    let translated = C { re: e.add_interval(4, point.re, exact_interval(one)), im: point.im }
    let bulb = norm_squared(e, translated)
    if valid_interval(bulb) && e.cmp(bulb.hi, sixteenth) < 0 {
        return 2
    }
    let quarter = e.integer(62, 1, -2)
    let shifted = e.add_interval(4, point.re, exact_interval(negative(quarter)))
    let xs = e.square_interval(6, shifted)
    let ys = e.square_interval(8, point.im)
    let q = e.add_interval(10, xs, ys)
    let qx = e.add_interval(12, q, shifted)
    let lhs = e.mul_interval(14, q, qx)
    let rhs = e.mul_interval(16, ys, exact_interval(quarter))
    if valid_interval(lhs) && valid_interval(rhs) && e.cmp(lhs.hi, rhs.lo) < 0 {
        return 3
    }
    0
}
// A resident evaluation owns this tape for its complete lifetime. Native
// descriptor headers are explicitly encoded after the 65 scalar limb slots.
// GPU display reads scalar progress only; it never dereferences this pointer.
pub struct RegionJob {
    pub ptr: u32,
    pub precision: u32,
    pub max_steps: u32,
    pub step: u32,
    pub code: u32,
    pub certificate: u32,
}
impl core::marker::Copy for RegionJob {}

fn save_value(_ e: Engine, _ index: u32, _ value: D) {
    let at = index * 5
    e.store(65, at, value.len)
    e.store(65, at + 1, if value.exp < 0 { 1 } else { 0 })
    e.store(65, at + 2, (if value.exp < 0 { -value.exp } else { value.exp }).downcast_truncate())
    e.store(65, at + 3, if value.neg { 1 } else { 0 })
    e.store(65, at + 4, if value.valid { 1 } else { 0 })
}
fn load_value(_ e: Engine, _ index: u32, _ slot: u32) -> D {
    let at = index * 5
    let magnitude = e.load(65, at + 2) as i64
    D { slot: slot, len: e.load(65, at),
        exp: if e.load(65, at + 1) == 1 { -magnitude } else { magnitude },
        neg: e.load(65, at + 3) == 1, valid: e.load(65, at + 4) == 1 }
}
fn save_interval(_ e: Engine, _ index: u32, _ value: I) {
    save_value(e, index, value.lo)
    save_value(e, index + 1, value.hi)
}
fn load_interval(_ e: Engine, _ index: u32, _ slot: u32) -> I {
    I { lo: load_value(e, index, slot), hi: load_value(e, index + 1, slot + 1) }
}
fn prepare_region(_ e: Engine, _ pr: D, _ pi: D, _ cr: D, _ ci: D,
    _ rx: D, _ ry: D, _ shape: u32, _ claim: u32) -> RegionResult {
    if !pr.valid
        || !pi.valid
        || !cr.valid
        || !ci.valid
        || !rx.valid
        || !ry.valid
        || rx.neg
        || ry.neg
        || rx.len == 0
        || ry.len == 0 {
        return RegionResult { code: 2, step: 0, certificate: 0 }
    }
    if shape == 0 && e.cmp(rx, ry) != 0 {
        return RegionResult { code: 2, step: 0, certificate: 0 }
    }
    // Subtract input anchors before rounding to the working precision.
    // Otherwise 1+2^-256 and 1 collapse to the same 128-bit point.
    let input = Engine { ptr: e.ptr, bits: 8192 }
    let dx = I {
        lo: input.add(4, pr, negative(cr), false),
        hi: input.add(5, pr, negative(cr), true),
    }
    let dy = I {
        lo: input.add(6, pi, negative(ci), false),
        hi: input.add(7, pi, negative(ci), true),
    }
    if !valid_interval(dx) || !valid_interval(dy) {
        return RegionResult { code: 1, step: 0, certificate: 0 }
    }
    if shape == 1 {
        if e.cmp(dx.lo, rx) > 0
            || e.cmp(dx.hi, negative(rx)) < 0
            || e.cmp(dy.lo, ry) > 0
            || e.cmp(dy.hi, negative(ry)) < 0 {
            return RegionResult { code: 3, step: 0, certificate: 0 }
        }
        if e.cmp(dx.lo, negative(rx)) < 0
            || e.cmp(dx.hi, rx) > 0
            || e.cmp(dy.lo, negative(ry)) < 0
            || e.cmp(dy.hi, ry) > 0 {
            return RegionResult { code: 1, step: 0, certificate: 0 }
        }
    } else {
        let distance = norm_squared(e, C { re: dx, im: dy })
        let radius = e.square_interval(8, exact_interval(rx))
        if !valid_interval(distance) || !valid_interval(radius) {
            return RegionResult { code: 1, step: 0, certificate: 0 }
        }
        if e.cmp(distance.lo, radius.hi) > 0 {
            return RegionResult { code: 3, step: 0, certificate: 0 }
        }
        if e.cmp(distance.hi, radius.lo) > 0 {
            return RegionResult { code: 1, step: 0, certificate: 0 }
        }
    }
    let point = C { re: point_interval(e, 0, pr), im: point_interval(e, 2, pi) }
    if claim == 1 {
        let certificate = bounded_certificate(e, point)
        return RegionResult {
            code: if certificate == 0 { 1 } else { 0 },
            step: 0,
            certificate: certificate,
        }
    }
    save_interval(e, 0, point.re)
    save_interval(e, 2, point.im)
    let zero = exact_interval(e.zero())
    save_interval(e, 4, zero)
    save_interval(e, 6, zero)
    RegionResult { code: 4, step: 0, certificate: 0 }
}

impl RegionJob {
    pub fn new() -> Self {
        let ptr = alloc_browser_bytes((SLOTS * STRIDE + 128) * 4).address()
        Self { ptr: ptr, precision: 128, max_steps: 1, step: 0, code: 5, certificate: 0 }
    }
    fn engine(self) -> Engine {
        Engine { ptr: self.ptr, bits: self.precision }
    }
    fn completed(self, _ result: RegionResult) -> Self {
        Self { ptr: self.ptr, precision: self.precision, max_steps: self.max_steps,
            step: result.step, code: result.code, certificate: result.certificate }
    }
    pub fn result(self) -> RegionResult {
        RegionResult { code: self.code, step: self.step, certificate: self.certificate }
    }
    pub fn cancel(self) -> Self {
        self.completed(RegionResult { code: 5, step: 0, certificate: 0 })
    }
    pub fn begin(self, _ request: own RegionRequest) -> Self {
    if request.selection.len < 96
        || request.selection.len > 7680
        || request.selection.len % 4 != 0
        || request.shape > 1
        || request.claim > 1
        || request.precision < 32
        || request.precision > 4096
        || request.max_steps == 0
        || request.max_steps > 10000 {
        return self.completed(RegionResult { code: 2, step: 0, certificate: 0 })
    }

        let job = Self { ptr: self.ptr, precision: request.precision,
            max_steps: request.max_steps, step: 0, code: 4, certificate: 0 }
        let e = job.engine()
        let pr = decode_dyadic(e, 45, request.selection, 0)
        let pi = decode_dyadic(e, 46, request.selection, pr.next)
        let cr = decode_dyadic(e, 47, request.selection, pi.next)
        let ci = decode_dyadic(e, 48, request.selection, cr.next)
        let rx = decode_dyadic(e, 49, request.selection, ci.next)
        let ry = decode_dyadic(e, 50, request.selection, rx.next)
        if ry.next != request.selection.len / 4 {
            return job.completed(RegionResult { code: 2, step: 0, certificate: 0 })
        }
        job.completed(prepare_region(e, pr.value, pi.value, cr.value, ci.value,
            rx.value, ry.value, request.shape, request.claim))
    }
    pub fn advance(self, _ budget: u32) -> Self {
        if self.code != 4 { return self }
        let e = self.engine()
        let point = C { re: load_interval(e, 0, 0), im: load_interval(e, 2, 2) }
        let mut z = C { re: load_interval(e, 4, 24), im: load_interval(e, 6, 26) }
        let four = e.integer(63, 1, 2)
        let mut step = self.step
        let mut spent: u32 = 0
        while step < self.max_steps && spent < budget {
            let rr = e.square_interval(16, z.re)
            let ii = e.square_interval(18, z.im)
            let mixed = e.mul_interval(20, z.re, z.im)
            let square = C { re: e.add_interval(8, rr, neg_interval(ii)),
                im: e.add_interval(10, mixed, mixed) }
            let next = e.plus(4, square, point)
            z = e.copy_complex(24, next)
            step = step + 1
            spent = spent + 1
            let norm = norm_squared(e, z)
            if !valid_interval(norm) {
                return self.completed(RegionResult { code: 1, step: step, certificate: 0 })
            }
            if e.cmp(norm.lo, four) > 0 {
                return self.completed(RegionResult { code: 0, step: step, certificate: 4 })
            }
        }
        save_interval(e, 4, z.re)
        save_interval(e, 6, z.im)
        self.completed(RegionResult { code: if step == self.max_steps { 1 } else { 4 },
            step: step, certificate: 0 })
    }
}

pub fn evaluate_region(_ request: own RegionRequest) -> RegionResult {
    let mut job = RegionJob::new().begin(request)
    while job.code == 4 { job = job.advance(32) }
    job.result()
}

/// Exact meaning: sum(anchor[0..4]) + scale*offset, with every finite
/// binary32 interpreted as its exact dyadic value. There is no f32 product.
pub struct BinaryCoordinate { pub w0: f32, pub w1: f32, pub w2: f32, pub w3: f32 }
impl core::marker::Copy for BinaryCoordinate {}
pub struct BinaryPoint {
    pub re: BinaryCoordinate,
    pub im: BinaryCoordinate,
    pub scale: f32,
    pub u: f32,
    pub v: f32,
}
impl core::marker::Copy for BinaryPoint {}

pub struct BinaryRegion {
    pub witness: BinaryPoint,
    pub center: BinaryPoint,
    pub radius_x: f32,
    pub radius_y: f32,
    pub shape: u32,
    pub claim: u32,
    pub precision: u32,
    pub max_steps: u32,
}
impl core::marker::Copy for BinaryRegion {}
extern { const fn __bitcast<From, To>(_: From) -> To }
fn binary_value(_ e: Engine, _ slot: u32, _ value: f32) -> D {
    let bits = __bitcast<f32, u32>(value)
    let encoded_exp = (bits >> 23) & 255
    if encoded_exp == 255 { return e.invalid() }
    let magnitude = (bits & 8388607) | (if encoded_exp == 0 { 0 } else { 8388608 })
    let mantissa = __bitcast<u32, i32>(magnitude)
    let signed = if (bits >> 31) != 0 { -mantissa } else { mantissa }
    e.integer(slot, signed, if encoded_exp == 0 { -149 } else { (encoded_exp as i64) - 150 })
}
fn binary_coordinate(_ e: Engine, _ slot: u32, _ anchor: BinaryCoordinate,
    _ scale: f32, _ offset: f32) -> D {
    // A sum of four finite binary32s and one exact binary32 product spans
    // fewer than 600 bits. 1024 bits retains it exactly, independently of
    // the requested orbit precision. Source slots45..50 remain immutable.
    let exact = Engine { ptr: e.ptr, bits: 1024 }
    let a = binary_value(exact, 4, scale)
    let b = binary_value(exact, 5, offset)
    let mut value = exact.multiply(6, a, b, false)
    let t0 = binary_value(exact, 4, anchor.w0)
    let s0 = exact.add(8, value, t0, false)
    value = exact.copy(6, s0)
    let t1 = binary_value(exact, 4, anchor.w1)
    let s1 = exact.add(8, value, t1, false)
    value = exact.copy(6, s1)
    let t2 = binary_value(exact, 4, anchor.w2)
    let s2 = exact.add(8, value, t2, false)
    value = exact.copy(6, s2)
    let t3 = binary_value(exact, 4, anchor.w3)
    let s3 = exact.add(8, value, t3, false)
    value = exact.copy(6, s3)
    exact.copy(slot, value)
}
impl RegionJob {
    pub fn begin_binary(self, _ request: own BinaryRegion) -> Self {
        if request.shape > 1 || request.claim > 1 || request.precision < 32
            || request.precision > 4096 || request.max_steps == 0 || request.max_steps > 10000 {
            return self.completed(RegionResult { code: 2, step: 0, certificate: 0 })
        }
        let job = Self { ptr: self.ptr, precision: request.precision,
            max_steps: request.max_steps, step: 0, code: 4, certificate: 0 }
        let e = job.engine()
        let pr = binary_coordinate(e, 45, request.witness.re, request.witness.scale, request.witness.u)
        let pi = binary_coordinate(e, 46, request.witness.im, request.witness.scale, request.witness.v)
        let cr = binary_coordinate(e, 47, request.center.re, request.center.scale, request.center.u)
        let ci = binary_coordinate(e, 48, request.center.im, request.center.scale, request.center.v)
        let exact = Engine { ptr: e.ptr, bits: 1024 }
        let scale = binary_value(exact, 4, request.center.scale)
        let x = binary_value(exact, 5, request.radius_x)
        let rx = exact.multiply(49, scale, x, false)
        let y = binary_value(exact, 5, request.radius_y)
        let ry = exact.multiply(50, scale, y, false)
        job.completed(prepare_region(e, pr, pi, cr, ci, rx, ry, request.shape, request.claim))
    }
}

pub fn evaluate_binary(_ request: own BinaryRegion) -> RegionResult {
    let mut job = RegionJob::new().begin_binary(request)
    while job.code == 4 { job = job.advance(32) }
    job.result()
}
