//! Fe lexical colors, enriched with compiler-exported SCIP byte ranges.
//!
//! `FEH1` packs one semantic class byte per UTF-8 source byte, followed by the
//! exact source bytes.
use std::text::Utf8View

pub enum TokenKind {
    Plain,
    TypeName,
    Function,
    Property,
    Variable,
    Keyword,
    Comment,
    StringLit,
    Number,
}

impl Copy for TokenKind {}

impl TokenKind {
    pub fn from_scip_tag(_ tag: u8) -> Self {
        if tag == 49 {
            return Self::TypeName
        }
        if tag == 50 {
            return Self::Function
        }
        if tag == 51 {
            return Self::Property
        }
        if tag == 52 {
            return Self::Variable
        }
        Self::Plain
    }

    pub fn is_plain(self) -> bool {
        match self {
            Self::Plain => true,
            _ => false,
        }
    }

    pub fn is_type_name(self) -> bool {
        match self {
            Self::TypeName => true,
            _ => false,
        }
    }

    pub fn is_function(self) -> bool {
        match self {
            Self::Function => true,
            _ => false,
        }
    }

    pub fn is_property(self) -> bool {
        match self {
            Self::Property => true,
            _ => false,
        }
    }

    pub fn is_variable(self) -> bool {
        match self {
            Self::Variable => true,
            _ => false,
        }
    }

    pub fn is_keyword(self) -> bool {
        match self {
            Self::Keyword => true,
            _ => false,
        }
    }

    pub fn is_comment(self) -> bool {
        match self {
            Self::Comment => true,
            _ => false,
        }
    }

    pub fn is_string(self) -> bool {
        match self {
            Self::StringLit => true,
            _ => false,
        }
    }

    pub fn is_number(self) -> bool {
        match self {
            Self::Number => true,
            _ => false,
        }
    }
}

pub struct Document {
    pub text: Utf8View,
    pub kinds: Utf8View,
}

impl Copy for Document {}

pub struct Token {
    pub end: u32,
    pub kind: TokenKind,
}

impl Copy for Token {}

impl Token {
    pub fn plain_tail(_ end: u32) -> Self {
        Self {
            end: end,
            kind: TokenKind::Plain,
        }
    }
}

pub fn document(_ raw: Utf8View) -> Document {
    if raw.len() < 8 || !raw.slice(start: 0, end: 5).view.equals_literal([70, 69, 72, 49, 10]) {
        return Document {
            text: raw,
            kinds: Utf8View::empty(),
        }
    }
    let mut at: u32 = 5
    let mut count: u32 = 0
    while at < raw.len() && at < 12 && raw.byte(index: at) >= 48 && raw.byte(index: at) <= 57 {
        let value: u8 = raw.byte(index: at) - 48
        let wide: u32 = value as u32
        count = count * 10 + wide
        at = at + 1
    }
    let start: u32 = at + 1
    if at >= raw.len() || raw.byte(index: at) != 10 || count > 500000 || start + count * 2 + 1 != raw.len() {
        return Document {
            text: raw,
            kinds: Utf8View::empty(),
        }
    }
    Document {
        kinds: raw.slice(start: start, end: start + count).view,
        text: raw.slice(start: start + count + 1, end: raw.len()).view,
    }
}

fn letter(_ c: u8) -> bool {
    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c >= 128
}

fn digit(_ c: u8) -> bool {
    c >= 48 && c <= 57
}

fn name(_ c: u8) -> bool {
    letter(c) || digit(c)
}

pub fn next(_ doc: Document, _ start: u32) -> Token {
    let source = doc.text
    let c = source.byte(index: start)
    let mut end = start + 1
    let mut kind = TokenKind::Plain

    if c == 47 && end < source.len() && source.byte(index: end) == 47 {
        kind = TokenKind::Comment
        while end < source.len() && source.byte(index: end) != 10 {
            end = end + 1
        }
    } else {
        if c == 47 && end < source.len() && source.byte(index: end) == 42 {
            kind = TokenKind::Comment
            end = end + 1
            let mut depth: u32 = 1
            while end < source.len() && depth >0 {
                if end + 1 < source.len() && source.byte(index: end) == 47 && source.byte(index: end + 1) == 42 {
                    depth = depth + 1
                    end = end + 2
                } else {
                    if end + 1 < source.len() && source.byte(index: end) == 42 && source.byte(index: end + 1) == 47 {
                        depth = depth - 1
                        end = end + 2
                    } else {
                        end = end + 1
                    }
                }
            }
        } else {
            if c == 34 {
                kind = TokenKind::StringLit
                let mut done = false
                while end < source.len() && !done {
                    let value = source.byte(index: end)
                    end = end + 1
                    if value == 92 && end < source.len() {
                        end = end + 1
                    } else {
                        if value == 34 {
                            done = true
                        }
                    }
                }
            } else {
                if digit(c) {
                    kind = TokenKind::Number
                    while end < source.len() && (name(source.byte(index: end)) || source.byte(index: end) == 46) {
                        end = end + 1
                    }
                } else {
                    if letter(c) {
                        while end < source.len() && name(source.byte(index: end)) {
                            end = end + 1
                        }
                        let word = source.slice(start: start, end: end).view
                        if keyword(word) {
                            kind = TokenKind::Keyword
                        } else {
                            if primitive(word) {
                                kind = TokenKind::TypeName
                            } else {
                                if doc.kinds.len() > start {
                                    kind = TokenKind::from_scip_tag(doc.kinds.byte(index: start))
                                }
                            }
                        }
                    } else {
                        while end < source.len()
                            && !name(source.byte(index: end))
                            && source.byte(index: end) != 34
                            && source.byte(index: end) != 47
                        {
                            end = end + 1
                        }
                    }
                }
            }
        }
    }

    Token {
        end: end,
        kind: kind,
    }
}

fn keyword(_ word: Utf8View) -> bool {
    word.equals_literal([97, 99, 116, 111, 114])
        || word.equals_literal([97, 115])
        || word.equals_literal([98, 114, 101, 97, 107])
        || word.equals_literal([99, 111, 110, 115, 116])
        || word.equals_literal([99, 111, 110, 116, 105, 110, 117, 101])
        || word.equals_literal([99, 111, 110, 116, 114, 97, 99, 116])
        || word.equals_literal([100, 101, 114, 105, 118, 101])
        || word.equals_literal([101, 108, 115, 101])
        || word.equals_literal([101, 109, 105, 116])
        || word.equals_literal([101, 110, 117, 109])
        || word.equals_literal([101, 120, 116, 101, 114, 110])
        || word.equals_literal([102, 97, 108, 115, 101])
        || word.equals_literal([102, 110])
        || word.equals_literal([102, 111, 114])
        || word.equals_literal([105, 102])
        || word.equals_literal([105, 109, 112, 108])
        || word.equals_literal([105, 110])
        || word.equals_literal([108, 101, 116])
        || word.equals_literal([109, 97, 116, 99, 104])
        || word.equals_literal([109, 117, 116])
        || word.equals_literal([111, 119, 110])
        || word.equals_literal([112, 117, 98])
        || word.equals_literal([114, 101, 116, 117, 114, 110])
        || word.equals_literal([115, 101, 108, 102])
        || word.equals_literal([115, 116, 114, 117, 99, 116])
        || word.equals_literal([116, 114, 97, 105, 116])
        || word.equals_literal([116, 114, 117, 101])
        || word.equals_literal([116, 121, 112, 101])
        || word.equals_literal([117, 110, 115, 97, 102, 101])
        || word.equals_literal([117, 115, 101])
        || word.equals_literal([117, 115, 101, 115])
        || word.equals_literal([119, 104, 105, 108, 101])
        || word.equals_literal([119, 105, 116, 104])
        || word.equals_literal([117, 115, 105, 110, 103])
}

fn primitive(_ word: Utf8View) -> bool {
    word.equals_literal([83, 101, 108, 102])
        || word.equals_literal([98, 111, 111, 108])
        || word.equals_literal([117, 56])
        || word.equals_literal([117, 49, 54])
        || word.equals_literal([117, 51, 50])
        || word.equals_literal([117, 54, 52])
        || word.equals_literal([117, 49, 50, 56])
        || word.equals_literal([117, 50, 53, 54])
        || word.equals_literal([105, 56])
        || word.equals_literal([105, 49, 54])
        || word.equals_literal([105, 51, 50])
        || word.equals_literal([105, 54, 52])
        || word.equals_literal([105, 49, 50, 56])
        || word.equals_literal([105, 50, 53, 54])
        || word.equals_literal([117, 115, 105, 122, 101])
        || word.equals_literal([105, 115, 105, 122, 101])
        || word.equals_literal([102, 51, 50])
        || word.equals_literal([102, 54, 52])
}

#[test]
fn token_kind_scip_tag_and_lexical_classes() {
    assert(cond: TokenKind::from_scip_tag(48).is_plain())
    assert(cond: TokenKind::from_scip_tag(49).is_type_name())
    assert(cond: TokenKind::from_scip_tag(50).is_function())
    assert(cond: TokenKind::from_scip_tag(51).is_property())
    assert(cond: TokenKind::from_scip_tag(52).is_variable())
    assert(cond: TokenKind::from_scip_tag(53).is_plain())

    let tail = Token::plain_tail(4096)
    assert(cond: tail.end == 4096)
    assert(cond: tail.kind.is_plain())
    assert(cond: !tail.kind.is_keyword())

    assert(cond: letter(65) && letter(122) && letter(95) && letter(200))
    assert(cond: !letter(48) && digit(48) && digit(57) && name(57))
}
