//! Three bands: OKLCH hue sweep, OKLab blending, and lightness/chroma field.
//! The same perceptual_color ingot is used by the Mandelbrot renderer.
use std::webgpu::{FragmentSurface,GpuProgram,ResponsiveBacking,
    StandardSurfaceRecovery,SurfaceQuality,SurfaceRecovery,
    SurfaceTransition,WebGpuBackend}
use std::web::view::{ApplyParamBindings,Extent,Param,ParamBindingsProvider,
    Surface,SurfaceEvent,SurfaceState}
use fmath::{from_i32}
use perceptual_color::{oklch,blend,rgba}

struct ColorParams { hue:Param, chroma:Param, lightness:Param, res:Param }
struct ColorState { hue:f32, chroma:f32, lightness:f32, res:f32 }
impl SurfaceState for ColorState { type Params=ColorParams }
derive ApplyParamBindings for ColorState using ParamBindingsProvider<ColorParams>
const fn params() -> ColorParams {
    ColorParams {
        hue:Param::range(min:0.0,max:360.0,init:275.0).drag_x(per_px:0.5),
        chroma:Param::range(min:0.0,max:0.25,init:0.18),
        lightness:Param::range(min:0.1,max:0.95,init:0.65).drag_y(per_px:-0.001),
        res:Param::extent_x(),
    }
}
actor ColorDemo uses (GpuProgram<WebGpuBackend>,SurfaceQuality<ResponsiveBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>) {
    hue:f32, chroma:f32, lightness:f32, res:f32,
    const fn view() -> Surface<ColorParams> {
        Surface {extent:Extent::square(768),params:params()}
    }
    fn navigate(self,event:own SurfaceEvent) -> ColorState
        uses (SurfaceTransition) {
        ColorState {hue:self.hue,chroma:self.chroma,lightness:self.lightness,res:self.res}
            .apply_param_bindings(params(),event)
    }
    fn shade(self,px:i32,py:i32) -> i32 uses (FragmentSurface) {
        let x:f32=(from_i32(px)+0.5)/self.res
        let y:f32=(from_i32(py)+0.5)/self.res
        if y<0.3333333 {
            rgba(oklch(self.lightness,self.chroma,self.hue+x*360.0))
        } else {if y<0.6666667 {
            rgba(blend(oklch(self.lightness,self.chroma,self.hue),
                oklch(self.lightness,self.chroma,self.hue+140.0),x))
        } else {
            rgba(oklch(0.15+0.75*x,self.chroma*(y-0.6666667)*3.0,self.hue))
        }}
    }
}
