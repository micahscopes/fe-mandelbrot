//! Exact selected points retain the camera expansion and a factored dyadic
//! offset. f32 pointer normalization defines the binary grid; display-only
//! projection never replaces the stored mathematical point.
use algebra::{Complex, Vec2}
use fmath::{abs, sqrt, from_i32}
use precision::{Expansion, to_quad}
use precision::field::Limbs
use precision::fixed::{ from_qf_offset, from_f32, mul, add, sub, to_f32_bits}
use std::web::SurfaceContactEvent
use std::web::component_events::{PointerPhase, PointerDevice}
use ingot::policy::Camera

pub struct SelectionSettings {
    pub mode: f32,
    pub shape: f32,
    pub claim: f32,
    pub precision: f32,
    pub steps: f32,
    pub public_view: f32,
}
impl Copy for SelectionSettings {}

pub struct ExactPoint {
    pub anchor: Complex<Expansion<4>>,
    pub scale: f32,
    pub offset: Vec2<f32>,
}
impl Copy for ExactPoint {}

pub struct Selection {
    pub region: ExactPoint,
    pub radius: Vec2<f32>,
    pub region_shape: f32,
    pub has_region: bool,
    pub witness: ExactPoint,
    pub has_witness: bool,
    pub revision: u32,
    pub active: bool,
    pub pointer: u32,
    pub start: Vec2<f32>,
    pub end: Vec2<f32>,
    pub frame_origin: Vec2<f32>,
    pub frame_extent: Vec2<f32>,
    pub draft_camera: Camera,
    pub draft_shape: f32,
}
impl Copy for Selection {}

impl SelectionSettings {
    pub const fn initial() -> Self {
        Self { mode: 0.0, shape: 0.0, claim: 0.0, precision: 256.0,
            steps: 1024.0, public_view: 0.0 }
    }
}
impl Selection {
    pub const fn empty(_ camera: Camera) -> Self {
        let point = ExactPoint { anchor: Complex {
            re: camera.center.re.value, im: camera.center.im.value,
        }, scale: camera.zoom, offset: Vec2 { x: 0.0, y: 0.0 } }
        let zero = Vec2 { x: 0.0, y: 0.0 }
        Self { region: point, radius: zero, region_shape: 0.0, has_region: false,
            witness: point, has_witness: false, revision: 0,
            active: false, pointer: 0, start: zero, end: zero,
            frame_origin: zero, frame_extent: zero, draft_camera: camera, draft_shape: 0.0 }
    }
    pub fn invalidate(self) -> Self {
        let mut next = self
        // Revision is an identity, never a magnitude. Wrapping is explicit.
        next.revision = (self.revision & 2147483647) + 1
        next
    }
    pub fn cancel(self) -> Self {
        let mut next = self
        next.active = false
        next
    }
    fn draft_region(self) -> Self {
        let mut next = self
        let delta = self.end - self.start
        let circle = self.draft_shape < 0.5
        next.region = ExactPoint {
            anchor: self.draft_camera.center_value(), scale: self.draft_camera.zoom,
            offset: if circle { self.start } else { (self.start + self.end) * 0.5 },
        }
        let radius = sqrt(delta.x * delta.x + delta.y * delta.y)
        next.radius = if circle { Vec2 { x: radius, y: radius } }
            else { Vec2 { x: abs(delta.x) * 0.5, y: abs(delta.y) * 0.5 } }
        next.region_shape = self.draft_shape
        next
    }
    pub fn contact(self, _ camera: Camera, _ settings: SelectionSettings,
        _ event: own SurfaceContactEvent) -> Self {
        let sample = event.sample
        let origin = Vec2 { x: event.bounds.left, y: event.bounds.top }
        let extent = Vec2 { x: event.bounds.width, y: event.bounds.height }
        let valid = extent.x > 0.0 && extent.y > 0.0
            && extent.x < 100000.0 && extent.y < 100000.0
        if !valid { return self.cancel() }
        let local = Vec2 { x: (sample.client_x - origin.x) / extent.x,
            y: (sample.client_y - origin.y) / extent.y }
        let inside = local.x >= 0.0 && local.x <= 1.0 && local.y >= 0.0 && local.y <= 1.0
        let at = Vec2 { x: local.x * 2.0 - 1.0, y: 1.0 - local.y * 2.0 }
        let mut next = self
        match sample.phase {
            PointerPhase::Down => {
                if self.active || !sample.primary || (sample.buttons & 1) == 0 || !inside { return self }
                next.active = true
                next.pointer = sample.pointer_id
                next.start = at
                next.end = at
                next.frame_origin = origin
                next.frame_extent = extent
                next.draft_camera = camera
                next.draft_shape = settings.shape
                next
            }
            PointerPhase::Move => {
                if !self.active || self.pointer != sample.pointer_id { return self }
                let missing_up = match sample.device {
                    PointerDevice::Mouse => (sample.buttons & 1) == 0,
                    _ => false,
                }
                if missing_up || self.frame_origin != origin || self.frame_extent != extent
                    || self.draft_camera != camera || self.draft_shape != settings.shape {
                    return self.cancel()
                }
                next.end = at
                next
            }
            PointerPhase::Up => {
                if !self.active || self.pointer != sample.pointer_id { return self }
                next.active = false
                if !inside || self.frame_origin != origin || self.frame_extent != extent
                    || self.draft_camera != camera || self.draft_shape != settings.shape {
                    return next
                }
                next.end = at
                if settings.mode > 1.5 {
                    // The selected witness never edits the public region.
                    next.witness = ExactPoint { anchor: camera.center_value(),
                        scale: camera.zoom, offset: at }
                    next.has_witness = true
                } else {
                    let pixels = Vec2 { x: (at.x - self.start.x) * extent.x * 0.5,
                        y: (at.y - self.start.y) * extent.y * 0.5 }
                    if pixels.norm_squared() < 16.0 { return next }
                    next = next.draft_region()
                    if next.radius.x <= 0.0 || next.radius.y <= 0.0 { return self.cancel() }
                    next.has_region = true
                }
                next.invalidate()
            }
            _ => {
                if self.active && self.pointer == sample.pointer_id { self.cancel() }
                else { self }
            }
        }
    }
}

// Display-only fixed projection preserves cancellation before f32 conversion.
// L=14 supplies 169 fractional bits; the accepted camera zoom floor is >2^-90.
// Even a truncated product tail is far below a screen pixel. Never use this
// projection to reconstruct a certificate input.
fn projected_axis(_ anchor: Expansion<4>, _ scale: f32, _ offset: f32,
    _ current: Expansion<4>, _ zoom: f32) -> f32 {
    let (a0, a1, a2, a3) = to_quad(anchor)
    let (c0, c1, c2, c3) = to_quad(current)
    let (sa, a) = from_qf_offset<14>(a0, a1, a2, a3, 0.0)
    let (sc, c) = from_qf_offset<14>(c0, c1, c2, c3, 0.0)
    let (ss, scale_words) = from_f32<14>(scale)
    let (so, offset_words) = from_f32<14>(offset)
    let (sp, product) = mul<14>(ss, scale_words, so, offset_words)
    let (sd, delta) = sub<Limbs<14>>(sa, a, sc, c)
    let (sr, result) = add<Limbs<14>>(sd, delta, sp, product)
    __bitcast<u32, f32>(to_f32_bits<14>(sr, result)) / zoom
}
pub fn projected(_ point: ExactPoint, _ camera: Camera) -> Vec2<f32> {
    Vec2 {
        x: projected_axis(point.anchor.re, point.scale, point.offset.x, camera.center.re.value, camera.zoom),
        y: projected_axis(point.anchor.im, point.scale, point.offset.y, camera.center.im.value, camera.zoom),
    }
}

pub struct SelectionDisplay {
    pub center: Vec2<f32>,
    pub radii: Vec2<f32>,
    pub shape: f32,
    pub has_region: bool,
    pub witness: Vec2<f32>,
    pub has_witness: bool,
}
impl Copy for SelectionDisplay {}
impl SelectionDisplay {
    pub const fn empty() -> Self {
        Self { center: Vec2 { x: 0.0, y: 0.0 }, radii: Vec2 { x: 0.0, y: 0.0 },
            shape: 0.0, has_region: false, witness: Vec2 { x: 0.0, y: 0.0 }, has_witness: false }
    }
}
pub fn display_selection(_ selection: Selection, _ camera: Camera,
    _ settings: SelectionSettings) -> SelectionDisplay {
    let draft = selection.active && settings.mode > 0.5 && settings.mode < 1.5
    let s = if draft { selection.draft_region() } else { selection }
    let has_region = s.has_region || draft
    let has_witness = s.has_witness && settings.public_view < 0.5
    SelectionDisplay {
        center: if has_region { projected(s.region, camera) } else { Vec2 { x: 0.0, y: 0.0 } },
        radii: s.radius * (s.region.scale / camera.zoom),
        shape: s.region_shape, has_region: has_region,
        witness: if has_witness { projected(s.witness, camera) } else { Vec2 { x: 0.0, y: 0.0 } },
        has_witness: has_witness,
    }
}

extern { const fn __bitcast<From, To>(_: From) -> To }

pub fn overlay(_ s: SelectionDisplay, _ camera: Camera,
    _ px: i32, _ py: i32, _ background: i32) -> i32 {
    let unit = 2.0 / camera.res
    let at = Vec2 { x: (from_i32(px) + 0.5) * unit - 1.0,
        y: 1.0 - (from_i32(py) + 0.5) * unit }
    if s.has_region {
        let center = s.center
        let d = at - center
        let radii = s.radii
        let line = if s.shape < 0.5 {
            abs(sqrt(d.x * d.x + d.y * d.y) - radii.x) < unit * 1.5
        } else {
            (abs(abs(d.x) - radii.x) < unit * 1.5 && abs(d.y) <= radii.y + unit)
                || (abs(abs(d.y) - radii.y) < unit * 1.5 && abs(d.x) <= radii.x + unit)
        }
        if line { return __bitcast<u32, i32>(0xffffc264) }
    }
    if s.has_witness {
        let d = at - s.witness
        let ring = abs(sqrt(d.x * d.x + d.y * d.y) - unit * 5.0) < unit * 1.2
        let cross = (abs(d.x) < unit && abs(d.y) < unit * 8.0)
            || (abs(d.y) < unit && abs(d.x) < unit * 8.0)
        if ring || cross { return __bitcast<u32, i32>(0xff8fffef) }
    }
    background
}


pub fn binary_point(_ point: ExactPoint) -> certified::BinaryPoint {
    let (r0, r1, r2, r3) = to_quad(point.anchor.re)
    let (i0, i1, i2, i3) = to_quad(point.anchor.im)
    certified::BinaryPoint { re: certified::BinaryCoordinate { w0: r0, w1: r1, w2: r2, w3: r3 },
        im: certified::BinaryCoordinate { w0: i0, w1: i1, w2: i2, w3: i3 },
        scale: point.scale, u: point.offset.x, v: point.offset.y }
}
pub fn region_request(_ selection: Selection, _ settings: SelectionSettings) -> certified::BinaryRegion {
    certified::BinaryRegion { witness: binary_point(selection.witness), center: binary_point(selection.region),
        radius_x: selection.radius.x, radius_y: selection.radius.y,
        shape: if selection.region_shape < 0.5 { 0 } else { 1 },
        claim: if settings.claim < 0.5 { 0 } else { 1 },
        precision: fmath::to_i32(settings.precision).downcast_truncate(),
        max_steps: fmath::to_i32(settings.steps).downcast_truncate() }
}
