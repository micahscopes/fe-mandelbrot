//! Temporary GPU camera observations, enabled in shared URLs with ?trace=1.
//! A matching begin/end stamp distinguishes a completed pass from stale data.
use core::{BrowserBytes, BrowserPtr, Copy}
use std::webgpu::ReadbackWords
use precision::to_quad
use ingot::policy::Camera
use ingot::cache::{HistoryOffsets, ReferenceControl, ReprojectionTap, ViewCache}

extern { const fn __bitcast<From, To>(_: From) -> To }

pub const TRACE_WORDS: u32 = 14
pub const TRACE_SUFFIX_LEN: u32 = 128
pub struct TraceMessage { pub bytes: BrowserBytes }
impl Copy for TraceMessage {}

pub struct CameraTrace { pub enabled: bool, pub words: [u32; 14] }
impl Copy for CameraTrace {}

impl CameraTrace {
    pub const fn empty() -> Self { Self { enabled: false, words: [0; 14] } }
    pub fn accept(self, _ message: TraceMessage) -> Self {
        let mut next = self
        if message.bytes.len == TRACE_WORDS * 4 && (message.bytes.ptr & 3) == 0 {
            let mut i: u32 = 0
            while i < TRACE_WORDS {
                let word: BrowserPtr<u32> = BrowserPtr::from_u32(message.bytes.ptr + i * 4)
                next.words[i as usize] = word.read()
                i += 1
            }
        }
        next
    }
    pub fn encoded_byte(self, _ index: u32) -> u8 {
        if index == 0 { return 126 }
        if index == 1 { return 103 }
        if index == 2 { return 58 }
        let position = index - 3
        let slot = position % 9
        if slot == 8 { return 46 }
        let value = (self.words[(position / 9) as usize] >> ((7 - slot) * 4)) & 15
        (if value < 10 { value + 48 } else { value + 87 }).downcast_truncate()
    }
}

pub fn begin(_ output: ReadbackWords<TraceMessage, 14>, _ clock: f32, _ camera: Camera) {
    let (xr, xt, _, _) = to_quad(camera.center.re.value)
    let (yr, yt, _, _) = to_quad(camera.center.im.value)
    output.store(index: 0, value: __bitcast<f32, u32>(clock))
    output.store(index: 1, value: __bitcast<f32, u32>(xr))
    output.store(index: 2, value: __bitcast<f32, u32>(xt))
    output.store(index: 3, value: __bitcast<f32, u32>(yr))
    output.store(index: 4, value: __bitcast<f32, u32>(yt))
}

pub struct TraceFrame {
    pub clock: f32,
    pub offsets: HistoryOffsets,
    pub view: ViewCache,
    pub full: ViewCache,
    pub initial: ViewCache,
    pub reference: ReferenceControl,
    pub tap: ReprojectionTap,
}

pub fn finish(_ output: ReadbackWords<TraceMessage, 14>, _ frame: TraceFrame) {
    output.store(index: 5, value: __bitcast<f32, u32>(frame.offsets.full.re))
    output.store(index: 6, value: __bitcast<f32, u32>(frame.offsets.full.im))
    output.store(index: 7, value: __bitcast<f32, u32>(frame.offsets.initial.re))
    output.store(index: 8, value: __bitcast<f32, u32>(frame.offsets.initial.im))
    let cache_flags = frame.full.completed | (frame.initial.completed << 1)
        | ((frame.view.epoch & 65535) << 16)
    output.store(index: 9, value: cache_flags)
    let reference_flags = frame.reference.active_valid | (frame.reference.pending << 1)
        | (frame.reference.index << 2)
    output.store(index: 10, value: reference_flags)
    output.store(index: 11, value: __bitcast<f32, u32>(frame.tap.sx))
    output.store(index: 12, value: __bitcast<f32, u32>(frame.tap.sy))
    output.store(index: 13, value: __bitcast<f32, u32>(frame.clock))
}
