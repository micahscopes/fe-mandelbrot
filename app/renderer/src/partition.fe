//! Deterministic blue-noise ranks, generated by tools/mb2-preview/generators/blue-noise.py.
//! A packed 16x16 inverse rank tile. Initialized once, reused without allocation.

use fmath::{from_i32,to_i32}
extern { const fn __bitcast<From, To>(_: From) -> To }

pub fn order_word(_ index:u32) -> u32 {
    match index {
        0 => 1943330376,
        1 => 3928788513,
        2 => 2057377159,
        3 => 3787149511,
        4 => 1829590296,
        5 => 4148900789,
        6 => 2486151614,
        7 => 3238686979,
        8 => 1325361052,
        9 => 1407573046,
        10 => 2526071130,
        11 => 2326997505,
        12 => 385642472,
        13 => 3812732533,
        14 => 950561838,
        15 => 1754407903,
        16 => 1158661820,
        17 => 3263957308,
        18 => 2413491554,
        19 => 210305685,
        20 => 1698287439,
        21 => 3126601191,
        22 => 3035464241,
        23 => 2942937058,
        24 => 394140191,
        25 => 3679951683,
        26 => 2718186976,
        27 => 3179700439,
        28 => 1962545482,
        29 => 905877956,
        30 => 3357310128,
        31 => 1592021255,
        32 => 3424813127,
        33 => 2643710328,
        34 => 1530866102,
        35 => 3994347860,
        36 => 1928404394,
        37 => 1790015222,
        38 => 2667292215,
        39 => 3541058125,
        40 => 2144188715,
        41 => 3599475720,
        42 => 3227813924,
        43 => 3962630985,
        44 => 1561254273,
        45 => 2217192534,
        46 => 2535170288,
        47 => 3279770117,
        48 => 4174254681,
        49 => 3419781182,
        50 => 2070952756,
        51 => 1089446775,
        52 => 3947272729,
        53 => 3869241886,
        54 => 2909714307,
        55 => 2032579122,
        56 => 3506266956,
        57 => 1727309305,
        58 => 1629502154,
        59 => 321437581,
        60 => 1808084376,
        61 => 2245187805,
        62 => 1477140292,
        63 => 2433133312,
        _ => 0,
