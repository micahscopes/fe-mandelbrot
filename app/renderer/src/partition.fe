}

// IGN from Jorge Jimenez's 2014 presentation. Used only to decorrelate the
// bijective local phase permutations, not claimed to be a blue-noise mask.
pub fn phase_order(_ phase:u32,_ x:u32,_ y:u32,_ stride:u32) -> u32 {
    let a:f32=from_i32(__bitcast<u32,i32>(x))*0.06711056
        +from_i32(__bitcast<u32,i32>(y))*0.00583715
    let inner:f32=a-from_i32(to_i32(a))
    let b:f32=inner*52.9829189
    let noise:f32=b-from_i32(to_i32(b))
    let phases:u32=stride*stride
    let offset:u32=__bitcast<i32,u32>(to_i32(noise*from_i32(__bitcast<u32,i32>(phases))))
    // gcd(2*stride+1,stride^2)=1: every local pixel is visited exactly once.
    (phase*(2*stride+1)+offset)%phases
}


pub fn phase_order_rect(_ phase:u32,_ x:u32,_ y:u32,_ sx:u32,_ sy:u32) -> u32 {
    let a:f32=from_i32(__bitcast<u32,i32>(x))*0.06711056
        +from_i32(__bitcast<u32,i32>(y))*0.00583715
    let b:f32=(a-from_i32(to_i32(a)))*52.9829189
    let noise:f32=b-from_i32(to_i32(b))
    let phases:u32=sx*sy
    let offset:u32=__bitcast<i32,u32>(to_i32(noise*from_i32(__bitcast<u32,i32>(phases))))
    // A rotation (or reverse rotation) is bijective for every rectangular grid.
    let direction:u32=if (offset&1)==0 { 1 } else { phases-1 }
    (phase*direction+offset)%phases
}
