//! Perturbation Mandelbrot as a typed compute -> fragment graph.
//!
//! Fe owns bounded reference work, cache lifetime, quality transitions,
//! Gaussian presentation, native refinement and selective anti-aliasing.
//! A live Fixed<8> reference stays available while its replacement builds.

use std::webgpu::{
    ComputeInvocation,
    ComputeSurface as ReferencePass,
    FixedDispatch as Once,
    FragmentSurface as Display,
    GpuProgram as PassGraph,
    ContinuousFrames,
    StandardSurfaceRecovery,
    StorageBuffer as OrbitBuffer,
    SurfaceQuality,
    SurfaceRecovery,
    SurfaceScheduling,
    SurfaceTransition,
    Workgroup as Threads,
    WebGpuBackend,
}
use std::web::view::{
    Extent,
    Surface,
    SurfaceEvent,
}
use fmath::{PixelSample, abs, from_i32, to_i32, max, min}
use precision::fixed::{
    from_qf_offset,
    mandelbrot_advance8,
    to_f32_quad_bits,
    fixed_magnitude_from_words,
    fixed_magnitude_to_words,
}

extern {
    const fn __bitcast<From, To>(_: From) -> To
}

use ingot::policy::{
    Camera,
    MandelbrotParams,
    MandelbrotViewState,
    SurfaceStateEnvelope,
    SharpBacking,
    mandelbrot_params,
    initial_state,
    transition,
    iteration_limit,
    progress,
    preview_budget,
    blur_radius,
    sharpness,
    ZOOM_MIN,
}
use ingot::orbit::{
    ComplexQF32Bits,
    OrbitProgress,
    empty_progress,
    offset_sample,
    progress_color,
    progress_has_outcome,
    progress_is_escaped,
    progress_is_glitched,
    progress_is_presentable,
    progress_is_terminal,
    progress_outcome_flags,
    progress_reference_index,
    progress_with_presentable,
    sample_pixel,
    sample_progress,
    continue_pixel,
    ORBIT_CAPACITY,
    ORBIT_CENTER_INDEX,
    ORBIT_META_INDEX,
    PROGRESS_ESCAPED_BIT,
    PROGRESS_GLITCHED_BIT,
}
use ingot::partition::{CohortPixel, RefinementSchedule, order_block, unpack_order_byte, seed_pixel}
use ingot::image::{Color, color, packed, rgba, blend, contrast, sample, sample_snapshot, gaussian}
use ingot::cache::{ViewCache, ReferenceControl, ReferenceAnchor, SampleOracle, oracle_is_usable, same_camera}

actor SmoothPerturbationalMandelbrot uses (
    PassGraph<WebGpuBackend>, SurfaceQuality<SharpBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
) {
    orbit: OrbitBuffer<ComplexQF32Bits, ORBIT_CAPACITY>,
    pixels: OrbitBuffer<Color, 65536>,
    initial_pixels: OrbitBuffer<Color, 65536>,
    snapshot_oracle: OrbitBuffer<SampleOracle, 4194304>,
    horizontal: OrbitBuffer<Color, 65536>,
    blurred: OrbitBuffer<Color, 65536>,
    cache: OrbitBuffer<ViewCache, 3>,
    anchor: OrbitBuffer<ReferenceAnchor, 2>,
    reference: OrbitBuffer<ReferenceControl, 1>,
    reference_words: OrbitBuffer<u32, 16>,
    native_pixels: OrbitBuffer<u32, 4194304>,
    antialiased_pixels: OrbitBuffer<u32, 4194304>,
    progress_pixels: OrbitBuffer<OrbitProgress, 4194304>,
    snapshot_pixels: OrbitBuffer<u32, 4194304>,
    state: MandelbrotViewState,

    fn initial() -> SurfaceStateEnvelope uses (core::actor::InitialState) {
        initial_state()
    }

    const fn view() -> Surface<MandelbrotParams> {
        Surface {
            extent: Extent::square(2048),
            params: mandelbrot_params(),
        }
    }

    fn initialize_order(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 1, 1>, Once<1, 1, 1>>)
    {
        let r: ReferenceControl = self.reference.load(index: 0)
        if r.active_valid == 1 || r.pending == 1 { return }
        self.orbit.store(
            index: 16390 + invocation.global.x,
            value: order_block(invocation.global.x),
        )
    }

    // Validate a candidate against the latest view before doing more work.
    fn discard_stale_reference(self)
        uses (ReferencePass<Threads<1, 1, 1>, Once<1, 1, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let control: ReferenceControl = self.reference.load(index: 0)
        if control.pending == 0 || !s.is_input_settled() { return }
        let bank: u32 = if control.active == 0 { 1 } else { 0 }
        let candidate: ReferenceAnchor = self.anchor.load(index: bank)
        let (dx, dy) = candidate.delta_from(s)
        if candidate.limit < iteration_limit(s.zoom) || max(abs(dx), abs(dy)) > s.zoom * 0.5 {
            self.reference.store(index: 0, value: control.cancel_pending())
        }
    }

    fn build_reference(self)
        uses (ReferencePass<Threads<1, 1, 1>, Once<1, 1, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let previous: ViewCache = self.cache.load(index: 0)
        let age: f32 = s.input_age()
        let budget: u32 = preview_budget(s.zoom)
        let control: ReferenceControl = self.reference.load(index: 0)
        let display_age: f32 = control.display_age(s)
        let radius: f32 = blur_radius(display_age)
        self.cache.store(
            index: 0,
            value: previous.sync_with_view(s, budget, radius, display_age),
        )
        let active_anchor: ReferenceAnchor = self.anchor.load(index: control.active)
        let (dx, dy) = active_anchor.delta_from(s)
        let target: u32 = iteration_limit(s.zoom)
        let reusable: bool = control.active_valid == 1
            && active_anchor.limit >= target
            && abs(dx) <= s.zoom * 0.125
            && abs(dy) <= s.zoom * 0.125
        if control.pending == 0 && reusable { return }
        // Keep the active orbit available while a replacement advances in
        // bounded exact-integer batches. Pointer input never queues behind
        // an entire multi-thousand-step reference recurrence.
        if control.active_valid == 1 && age < 60.0 { return }
        let bank: u32 = 1 - control.active
        let base: u32 = bank * 8195
        if control.pending == 0 {
            self.anchor.store(
                index: bank,
                value: ReferenceAnchor::from_state(s, target, active_anchor.generation + 1),
            )
            let mut word: u32 = 0
            while word < 16 {
                self.reference_words.store(index: word, value: 0)
                word = word + 1
            }
            self.orbit.store(index: base, value: ComplexQF32Bits::zero())
            self.reference.store(index: 0, value: control.start_pending())
            return
        }
        let pending_anchor: ReferenceAnchor = self.anchor.load(index: bank)
        let (cx_s, cx) = from_qf_offset<8>(
            pending_anchor.x0,
            pending_anchor.x1,
            pending_anchor.x2,
            pending_anchor.x3,
            0.0,
        )
        let (cy_s, cy) = from_qf_offset<8>(
            pending_anchor.y0,
            pending_anchor.y1,
            pending_anchor.y2,
            pending_anchor.y3,
            0.0,
        )
        let mut x_words: [u32; 8] = [0; 8]
        let mut y_words: [u32; 8] = [0; 8]
        let mut w: usize = 0
        while w < 8 {
            let slot: u32 = w.downcast_truncate()
            x_words[w] = self.reference_words.load(index: slot)
            y_words[w] = self.reference_words.load(index: slot + 8)
            w = w + 1
        }
        let mut zx = fixed_magnitude_from_words<8>(x_words)
        let mut zy = fixed_magnitude_from_words<8>(y_words)
        let mut zx_s: u32 = control.zx_s
        let mut zy_s: u32 = control.zy_s
        let mut i: u32 = control.index
        let mut step: u32 = 0
        let mut escaped: u32 = 0
        while step < 64 && i < pending_anchor.limit && escaped == 0 {
            let (nx_s, nx, ny_s, ny, did_escape) = mandelbrot_advance8(zx_s, zx, zy_s, zy, cx_s, cx, cy_s, cy)
            let (x0, x1, x2, x3) = to_f32_quad_bits<8>(nx_s, nx)
            let (y0, y1, y2, y3) = to_f32_quad_bits<8>(ny_s, ny)
            self.orbit.store(
                index: base + i + 1,
                value: ComplexQF32Bits::from_quad_bits(x0, x1, x2, x3, y0, y1, y2, y3),
            )
            zx_s = nx_s
            zx = nx
            zy_s = ny_s
            zy = ny
            escaped = did_escape
            i = i + 1
            step = step + 1
        }
        if escaped == 1 || i >= pending_anchor.limit {
            let (x0, x1, x2, x3) = to_f32_quad_bits<8>(cx_s, cx)
            let (y0, y1, y2, y3) = to_f32_quad_bits<8>(cy_s, cy)
            self.orbit.store(
                index: base + ORBIT_CENTER_INDEX,
                value: ComplexQF32Bits::from_quad_bits(x0, x1, x2, x3, y0, y1, y2, y3),
            )
            self.orbit.store(
                index: base + ORBIT_META_INDEX,
                value: ComplexQF32Bits::metadata(i + 1, pending_anchor.limit),
            )
            self.reference.store(
                index: 0,
                value: ReferenceControl::publish(bank, i, zx_s, zy_s, s.clock),
            )
            let view: ViewCache = self.cache.load(index: 0)
            self.cache.store(index: 0, value: view.invalidate_for_new_reference())
        } else {
            let xs = fixed_magnitude_to_words<8>(zx)
            let ys = fixed_magnitude_to_words<8>(zy)
            let mut slot: usize = 0
            while slot < 8 {
                let index: u32 = slot.downcast_truncate()
                self.reference_words.store(index: index, value: xs[slot])
                self.reference_words.store(index: index + 8, value: ys[slot])
                slot = slot + 1
            }
            self.reference.store(index: 0, value: control.advance_pending(i, zx_s, zy_s))
        }
    }

    fn render_preview(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<32, 32, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let ref_state: ReferenceControl = self.reference.load(index: 0)
        if ref_state.active_valid == 0 { return }
        if self.cache.load(index: 0).preview_dirty == 0 { return }
        let x = invocation.global.x
        let y = invocation.global.y
        let px = to_i32(from_i32(__bitcast<u32, i32>(x)) * s.res / 256.0)
        let py = to_i32(from_i32(__bitcast<u32, i32>(y)) * s.res / 256.0)
        let full: ViewCache = self.cache.load(index: 1)
        let initial: ViewCache = self.cache.load(index: 2)
        let use_full: bool = full.completed == 1 && full.epoch >= initial.epoch
        let old: ViewCache = if use_full { full } else { initial }
        let (dx, dy) = old.delta_from(s)
        let u: f32 = (from_i32(px) + 0.5) * 2.0 / s.res - 1.0
        let v: f32 = 1.0 - (from_i32(py) + 0.5) * 2.0 / s.res
        let sx: f32 = ((dx + u * s.zoom) / max(old.zoom, ZOOM_MIN) + 1.0) * old.res * 0.5 - 0.5
        let sy: f32 = (1.0 - (dy + v * s.zoom) / max(old.zoom, ZOOM_MIN)) * old.res * 0.5 - 0.5
        let reusable: bool = old.completed == 1 && sx >= 0.0 && sy >= 0.0 && sx < old.res - 1.0 && sy < old.res - 1.0
        let cached: Color = if use_full {
            sample_snapshot(self.snapshot_pixels, sx, sy, old.res)
        } else {
            sample(self.initial_pixels, sx * 256.0 / max(old.res, 1.0), sy * 256.0 / max(old.res, 1.0))
        }
        let age: f32 = ref_state.display_age(s)
        if reusable && age < 60.0 {
            self.pixels.store(index: (y << 8) | x, value: cached)
            return
        }
        let computed = sample_progress(
            self.orbit,
            ref_state.active * 8195,
            s.camera(),
            PixelSample::ordered_2x2(px, py),
            preview_budget(s.zoom),
        )
        let bits = progress_color(computed)
        let current: Color = color(__bitcast<i32, u32>(bits))
        let result: Color = if reusable { blend(cached, current, progress(age, 60.0, 300.0)) } else { current }
        self.pixels.store(index: (y << 8) | x, value: result)
    }

    // Preserve the first settled preview before native refinement finishes.
    // Neither this image nor its camera metadata changes while input is live.
    fn cache_initial(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<32, 32, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let c: ViewCache = self.cache.load(index: 0)
        let old: ViewCache = self.cache.load(index: 2)
        let ref_state: ReferenceControl = self.reference.load(index: 0)
        if !ref_state.can_publish_initial(s, c.epoch, old.epoch) { return }
        let index: u32 = (invocation.global.y << 8) | invocation.global.x
        self.initial_pixels.store(index: index, value: self.pixels.load(index: index))
    }

    fn publish_initial(self) uses (ReferencePass<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let s: MandelbrotViewState = self.state
        let c: ViewCache = self.cache.load(index: 0)
        let old: ViewCache = self.cache.load(index: 2)
        let ref_state: ReferenceControl = self.reference.load(index: 0)
        if !ref_state.can_publish_initial(s, c.epoch, old.epoch) { return }
        self.cache.store(index: 2, value: c.as_published_initial())
    }

    fn blur_horizontal(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<32, 32, 1>>)
    {
        if self.cache.load(index: 0).blur_dirty == 0 { return }
        let sigma: f32 = self.reference.load(index: 0).blur_sigma(self.state)
        self.horizontal.store(
            index: (invocation.global.y << 8) | invocation.global.x,
            value: gaussian(self.pixels, invocation.global.x, invocation.global.y, sigma, false),
        )
    }

    fn blur_vertical(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<32, 32, 1>>)
    {
        if self.cache.load(index: 0).blur_dirty == 0 { return }
        let sigma: f32 = self.reference.load(index: 0).blur_sigma(self.state)
        self.blurred.store(
            index: (invocation.global.y << 8) | invocation.global.x,
            value: gaussian(self.horizontal, invocation.global.x, invocation.global.y, sigma, true),
        )
    }

    // Spatially interleaved phases cover the whole image, rather
    // than sweeping rectangles. Each orbit resumes its own saved recurrence.
    fn restore_oracle(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<16, 32, 1>>)
    {
        let s: MandelbrotViewState = self.state
        if !s.is_input_settled() { return }
        let c: ViewCache = self.cache.load(index: 0)
        let history: ViewCache = self.cache.load(index: 1)
        let schedule: RefinementSchedule = RefinementSchedule::for_view(s.zoom, s.res)
        if history.completed == 0 || history.budget < schedule.limit { return }
        if !same_camera(history, c) { return }
        let pixel: CohortPixel = schedule.rect_pixel(c.cursor, invocation.global.x, invocation.global.y, s.res)
        if !pixel.active { return }
        let saved: OrbitProgress = self.progress_pixels.load(index: pixel.index)
        if saved.is_presentable_in(c.epoch) { return }
        let deep: SampleOracle = self.snapshot_oracle.load(index: pixel.index)
        if !deep.is_usable() { return }
        let preserved: OrbitProgress = OrbitProgress::from_oracle(deep, c.epoch, s.clock)
        let base: u32 = __bitcast<i32, u32>(progress_color(preserved))
        self.progress_pixels.store(index: pixel.index, value: preserved)
        self.native_pixels.store(index: pixel.index, value: base)
        self.antialiased_pixels.store(index: pixel.index, value: if history.aa == s.antialias {
            self.snapshot_pixels.load(index: pixel.index)
        } else {
            base
        })
    }

    // A sparse, full-depth lattice reveals real results while the denser
    // checkpoints are still iterating. It shares their persistent buffers.
    fn seed_refinement(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<16, 16, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let ref_state: ReferenceControl = self.reference.load(index: 0)
        if !ref_state.can_refine(s) { return }
        let c: ViewCache = self.cache.load(index: 0)
        if c.cursor >= 16 || c.completed == 1 { return }
        let lane: u32 = (invocation.global.y % 4) * 4 + invocation.global.x % 4
        let rank: u32 = c.cursor * 16 + lane
        let block: ComplexQF32Bits = self.orbit.load(index: 16390 + (rank >> 5))
        let pixel: CohortPixel = seed_pixel(block, rank, invocation.global.x, invocation.global.y, s.res)
        if !pixel.active { return }
        let old: OrbitProgress = self.progress_pixels.load(index: pixel.index)
        if old.is_presentable_in(c.epoch) { return }
        let saved: OrbitProgress = if old.epoch == c.epoch { old } else { empty_progress(c.epoch) }
        let limit: u32 = iteration_limit(s.zoom)
        let next: OrbitProgress = continue_pixel(
            self.orbit,
            ref_state.active * 8195,
            s.camera(),
            PixelSample::ordered_2x2(__bitcast<u32, i32>(pixel.x), __bitcast<u32, i32>(pixel.y)),
            limit,
            limit,
            saved,
        )
        self.progress_pixels.store(index: pixel.index, value: next.with_fade_start(s.clock))
        let bits: u32 = __bitcast<i32, u32>(progress_color(next))
        self.native_pixels.store(index: pixel.index, value: bits)
        self.antialiased_pixels.store(index: pixel.index, value: bits)
    }

    fn refine_pixels(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<16, 32, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let ref_state: ReferenceControl = self.reference.load(index: 0)
        if !ref_state.can_refine(s) { return }
        let c: ViewCache = self.cache.load(index: 0)
        let schedule: RefinementSchedule = RefinementSchedule::for_view(s.zoom, s.res)
        let pixel: CohortPixel = schedule.rect_pixel(c.cursor, invocation.global.x, invocation.global.y, s.res)
        if !pixel.active { return }
        let old: OrbitProgress = self.progress_pixels.load(index: pixel.index)
        let saved: OrbitProgress = if old.epoch == c.epoch { old } else { empty_progress(c.epoch) }
        if saved.is_terminal(schedule.limit) { return }
        let next: OrbitProgress = continue_pixel(
            self.orbit,
            ref_state.active * 8195,
            s.camera(),
            PixelSample::ordered_2x2(__bitcast<u32, i32>(pixel.x), __bitcast<u32, i32>(pixel.y)),
            schedule.limit,
            2048,
            saved,
        )
        // Once terminal, z_re is free to hold the pixel's fade start time.
        let stored: OrbitProgress = if next.is_terminal(schedule.limit) {
            next.with_fade_start(s.clock)
        } else {
            next
        }
        self.progress_pixels.store(index: pixel.index, value: stored)
        let bits: u32 = __bitcast<i32, u32>(progress_color(next))
        self.native_pixels.store(index: pixel.index, value: bits)
        self.antialiased_pixels.store(index: pixel.index, value: bits)
    }

    fn antialias_pixels(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<32, 32, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let ref_state: ReferenceControl = self.reference.load(index: 0)
        if !ref_state.can_refine(s) { return }
        let c: ViewCache = self.cache.load(index: 0)
        let schedule: RefinementSchedule = RefinementSchedule::for_view(s.zoom, s.res)
        let pixel: CohortPixel = schedule.aa_pixel(c.cursor, invocation.global.x, invocation.global.y, s.res)
        if !pixel.active { return }
        let bits: u32 = self.native_pixels.load(index: pixel.index)
        let center: Color = color(bits)
        let xf: f32 = from_i32(__bitcast<u32, i32>(pixel.x))
        let yf: f32 = from_i32(__bitcast<u32, i32>(pixel.y))
        let left: u32 = __bitcast<i32, u32>(to_i32(max(0.0, xf - 1.0)))
        let right: u32 = __bitcast<i32, u32>(to_i32(min(s.res - 1.0, xf + 1.0)))
        let up: u32 = __bitcast<i32, u32>(to_i32(max(0.0, yf - 1.0)))
        let down: u32 = __bitcast<i32, u32>(to_i32(min(s.res - 1.0, yf + 1.0)))
        let edge: f32 = max(
            max(
                contrast(center, color(self.native_pixels.load(index: (pixel.y << 11) | left))),
                contrast(center, color(self.native_pixels.load(index: (pixel.y << 11) | right))),
            ),
            max(
                contrast(center, color(self.native_pixels.load(index: (up << 11) | pixel.x))),
                contrast(center, color(self.native_pixels.load(index: (down << 11) | pixel.x))),
            ),
        )
        if s.antialias >= 0.5 && edge > 0.12 {
            let camera: Camera = s.camera()
            let px: i32 = __bitcast<u32, i32>(pixel.x)
            let py: i32 = __bitcast<u32, i32>(pixel.y)
            let a: Color = color(__bitcast<i32, u32>(sample_pixel(
                self.orbit,
                ref_state.active * 8195,
                camera,
                offset_sample(px, py, 0.28, -0.28),
                schedule.limit,
            )))
            let b: Color = color(__bitcast<i32, u32>(sample_pixel(
                self.orbit,
                ref_state.active * 8195,
                camera,
                offset_sample(px, py, -0.28, 0.28),
                schedule.limit,
            )))
            self.antialiased_pixels.store(index: pixel.index, value: __bitcast<i32, u32>(packed(Color {
                l: (center.l + a.l + b.l) / 3.0,
                a: (center.a + a.a + b.a) / 3.0,
                b: (center.b + a.b + b.b) / 3.0,
            })))
        }
    }

    fn finish_refinement(self) uses (ReferencePass<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let s: MandelbrotViewState = self.state
        let ref_state: ReferenceControl = self.reference.load(index: 0)
        if !ref_state.can_refine(s) { return }
        let c: ViewCache = self.cache.load(index: 0)
        let end: u32 = RefinementSchedule::for_view(s.zoom, s.res).total_steps()
        if c.cursor >= end { return }
        self.cache.store(index: 0, value: c.advance_cursor(end))
    }

    fn cache_snapshot(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<32, 32, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let c: ViewCache = self.cache.load(index: 0)
        let snapshot: ViewCache = self.cache.load(index: 1)
        if c.completed == 0 || snapshot.epoch == c.epoch { return }
        // Copy only on publication. Small dispatch also makes the idle guard
        // cheap; coalesced lanes cover the fixed-stride image in 64 strips.
        let lane: u32 = (invocation.global.y << 8) | invocation.global.x
        let mut strip: u32 = 0
        while strip < 64 {
            let index: u32 = lane + (strip << 16)
            let x: u32 = index & 2047
            let y: u32 = index >> 11
            if from_i32(__bitcast<u32, i32>(x)) < s.res && from_i32(__bitcast<u32, i32>(y)) < s.res {
                self.snapshot_pixels.store(index: index, value: self.antialiased_pixels.load(index: index))
                let result: OrbitProgress = self.progress_pixels.load(index: index)
                self.snapshot_oracle.store(index: index, value: result.to_oracle())
            }
            strip = strip + 1
        }
    }

    fn publish_snapshot(self) uses (ReferencePass<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let c: ViewCache = self.cache.load(index: 0)
        if c.completed == 1 { self.cache.store(index: 1, value: c) }
    }

    fn display_preview(self, px: i32, py: i32) -> i32 uses (Display) {
        let s: MandelbrotViewState = self.state
        let x: u32 = __bitcast<i32, u32>(px) & 2047
        let y: u32 = __bitcast<i32, u32>(py) & 2047
        let index: u32 = (y << 11) | x
        let c: ViewCache = self.cache.load(index: 0)
        let reference_state: ReferenceControl = self.reference.load(index: 0)
        let reveal: f32 = sharpness(reference_state.display_age(s))
        let saved: OrbitProgress = self.progress_pixels.load(index: index)
        if saved.is_presentable_in(c.epoch) {
            let bits: u32 = self.antialiased_pixels.load(index: index)
            let amount: f32 = progress(s.clock - saved.fade_started_at(), 0.0, 350.0) * reveal
            if amount >= 1.0 { return rgba(color(bits)) }
            let coarse: Color = sample(self.blurred, from_i32(px) * 256.0 / s.res, from_i32(py) * 256.0 / s.res)
            return rgba(blend(coarse, color(bits), amount))
        }
        let coarse: Color = sample(self.blurred, from_i32(px) * 256.0 / s.res, from_i32(py) * 256.0 / s.res)
        {
            let stride: f32 = from_i32(to_i32((s.res + 511.0) / 512.0))
            let fx: f32 = from_i32(px)
            let fy: f32 = from_i32(py)
            let lx: f32 = from_i32(to_i32(fx / stride)) * stride
            let ly: f32 = from_i32(to_i32(fy / stride)) * stride
            let x0: u32 = __bitcast<i32, u32>(to_i32(lx)) & 2047
            let y0: u32 = __bitcast<i32, u32>(to_i32(ly)) & 2047
            let x1: u32 = __bitcast<i32, u32>(to_i32(ingot::image::min(lx + stride, s.res - 1.0))) & 2047
            let y1: u32 = __bitcast<i32, u32>(to_i32(ingot::image::min(ly + stride, s.res - 1.0))) & 2047
            let a: OrbitProgress = self.progress_pixels.load(index: ((y0 << 11) | x0) & 4194303)
            let b: OrbitProgress = self.progress_pixels.load(index: ((y0 << 11) | x1) & 4194303)
            let d: OrbitProgress = self.progress_pixels.load(index: ((y1 << 11) | x0) & 4194303)
            let e: OrbitProgress = self.progress_pixels.load(index: ((y1 << 11) | x1) & 4194303)
            let ready: bool = a.is_presentable_in(c.epoch)
                && b.is_presentable_in(c.epoch)
                && d.is_presentable_in(c.epoch)
                && e.is_presentable_in(c.epoch)
            if ready {
                let tx: f32 = (fx - lx) / stride
                let ty: f32 = (fy - ly) / stride
                let top: Color = blend(
                    color(self.native_pixels.load(index: ((y0 << 11) | x0) & 4194303)),
                    color(self.native_pixels.load(index: ((y0 << 11) | x1) & 4194303)),
                    tx,
                )
                let bottom: Color = blend(
                    color(self.native_pixels.load(index: ((y1 << 11) | x0) & 4194303)),
                    color(self.native_pixels.load(index: ((y1 << 11) | x1) & 4194303)),
                    tx,
                )
                let latest_fade: f32 = ingot::image::max(
                    ingot::image::max(a.fade_started_at(), b.fade_started_at()),
                    ingot::image::max(d.fade_started_at(), e.fade_started_at()),
                )
                let since: f32 = s.clock - latest_fade
                rgba(blend(coarse, blend(top, bottom, ty), progress(since, 0.0, 350.0) * reveal))
            } else {
                rgba(coarse)
            }
        }
    }

    fn navigate(self, event: own SurfaceEvent) -> SurfaceStateEnvelope
        uses (SurfaceTransition, SurfaceScheduling<ContinuousFrames>)
    {
        SurfaceStateEnvelope { state: transition(self.state, event) }
    }
}

#[test]
fn reference_checkpoint_roundtrips_every_limb() {
    let words: [u32; 8] = [0, 1, 8191, 17, 4096, 3, 8000, 2]
    let magnitude = fixed_magnitude_from_words<8>(words)
    let restored = fixed_magnitude_to_words<8>(magnitude)
    let mut i: usize = 0
    while i < 8 {
        assert(restored[i] == words[i])
        i = i + 1
    }
}

#[test]
fn orbit_progress_and_oracle_flags_roundtrip() {
    let initial_bits: u32 = 0
    assert(!progress_is_presentable(initial_bits))
    assert(!progress_is_escaped(initial_bits))
    assert(!progress_is_glitched(initial_bits))
    assert(!progress_has_outcome(initial_bits))
    assert(!progress_is_terminal(initial_bits, 0, 256))
    assert(progress_is_terminal(initial_bits, 256, 256))

    let escaped_bits: u32 = progress_with_presentable(42 | PROGRESS_ESCAPED_BIT)
    assert(progress_is_presentable(escaped_bits))
    assert(progress_is_escaped(escaped_bits))
    assert(!progress_is_glitched(escaped_bits))
    assert(progress_is_terminal(escaped_bits, 137, 256))
    assert(progress_reference_index(escaped_bits) == 42)

    let oracle_flags: u32 = progress_outcome_flags(escaped_bits)
    assert(oracle_is_usable(oracle_flags))
    let restored_bits: u32 = progress_with_presentable(oracle_flags)
    assert(progress_is_presentable(restored_bits))
    assert(progress_is_escaped(restored_bits))
    assert(!progress_is_glitched(restored_bits))
    assert(progress_reference_index(restored_bits) == 0)

    let glitched_flags: u32 = progress_outcome_flags(PROGRESS_GLITCHED_BIT)
    assert(!oracle_is_usable(glitched_flags))
}

#[test]
fn blue_noise_order_tile_is_bijective() {
    let mut sum: u32 = 0
    let mut sq_sum: u32 = 0
    let mut rank: u32 = 0
    while rank < 256 {
        let block: ComplexQF32Bits = order_block(rank >> 5)
        let pos: u32 = unpack_order_byte(block, rank)
        assert(pos < 256)
        sum = sum + pos
        sq_sum = sq_sum + pos * pos
        rank = rank + 1
    }
    assert(sum == 32640)
    assert(sq_sum == 5559680)
}
