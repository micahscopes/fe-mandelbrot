//! Perturbation Mandelbrot as a typed compute -> fragment graph.
//!
//! Fe owns bounded reference work, cache lifetime, quality transitions,
//! Gaussian presentation, native refinement and selective anti-aliasing.
//! A live Fixed<8> reference stays available while its replacement builds.

use std::webgpu::{
    ComputeInvocation,
    ComputeSurface as ReferencePass,
    FixedDispatch as Once,
    FragmentSurface as Display,
    GpuProgram as PassGraph,
    ContinuousFrames,
    StandardSurfaceRecovery,
    StorageBuffer as OrbitBuffer,
    SurfaceQuality,
    SurfaceRecovery,
    SurfaceScheduling,
    SurfaceTransition,
    Workgroup as Threads,
    WebGpuBackend,
}
use std::web::view::{Extent, Surface, SurfaceEvent}
use algebra::Vec2
use fmath::{PixelSample, abs, from_i32, to_i32, max, min}
use precision::fixed::{
    mandelbrot_advance8,
    to_f32_quad_bits,
    fixed_magnitude_from_words,
    fixed_magnitude_to_words,
}

extern {
    const fn __bitcast<From, To>(_: From) -> To
}

use ingot::policy::{
    Camera,
    MandelbrotParams,
    MandelbrotViewState,
    SurfaceStateEnvelope,
    SharpBacking,
    mandelbrot_params,
    initial_state,
    transition,
    iteration_limit,
    progress,
    preview_budget,
    blur_radius,
    sharpness,
    ZOOM_MIN,
}
use ingot::orbit::{
    Complex,
    OrbitProgress,
    PackedReference,
    ReferenceReal,
    ReferenceStep,
    clear_reference_checkpoint,
    continue_pixel,
    empty_progress,
    load_reference_checkpoint,
    progress_color,
    progress_has_outcome,
    progress_is_escaped,
    progress_is_glitched,
    progress_is_presentable,
    progress_is_terminal,
    progress_outcome_flags,
    progress_reference_index,
    progress_with_presentable,
    pack_progress_reference,
    reference_center,
    reference_step,
    sample_pixel,
    sample_progress,
    store_reference_checkpoint,
    ORBIT_CAPACITY,
    ORBIT_CENTER_INDEX,
    ORBIT_META_INDEX,
    PROGRESS_ESCAPED_BIT,
    PROGRESS_GLITCHED_BIT,
}
use ingot::partition::{
    CohortPixel,
    Pixel,
    RefinementSchedule,
    order_block,
    unpack_order_byte,
    seed_pixel,
}
use ingot::image::{
    BilinearTap,
    Color,
    unpack_lab,
    pack_lab,
    display_rgba,
    blend,
    blend_corners,
    contrast,
    lattice_tap,
    max as finite_max,
    sample,
    sample_snapshot,
    gaussian,
}
use ingot::cache::{
    ViewCache,
    ReferenceControl,
    ReferenceAnchor,
    SampleOracle,
    oracle_is_glitched,
    oracle_is_usable,
    same_camera,
}

actor SmoothPerturbationalMandelbrot uses (
    PassGraph<WebGpuBackend>,
    SurfaceQuality<SharpBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
) {
    orbit: OrbitBuffer<PackedReference, ORBIT_CAPACITY>,
    pixels: OrbitBuffer<Color, 65536>,
    initial_pixels: OrbitBuffer<Color, 65536>,
    snapshot_oracle: OrbitBuffer<SampleOracle, 4194304>,
    horizontal: OrbitBuffer<Color, 65536>,
    blurred: OrbitBuffer<Color, 65536>,
    cache: OrbitBuffer<ViewCache, 3>,
    anchor: OrbitBuffer<ReferenceAnchor, 2>,
    reference: OrbitBuffer<ReferenceControl, 1>,
    reference_words: OrbitBuffer<u32, 16>,
    native_pixels: OrbitBuffer<u32, 4194304>,
    antialiased_pixels: OrbitBuffer<u32, 4194304>,
    progress_pixels: OrbitBuffer<OrbitProgress, 4194304>,
    snapshot_pixels: OrbitBuffer<u32, 4194304>,
    state: MandelbrotViewState,

    fn initial() -> SurfaceStateEnvelope uses (core::actor::InitialState) {
        initial_state()
    }

    const fn view() -> Surface<MandelbrotParams> {
        Surface {
            extent: Extent::square(2048),
            params: mandelbrot_params(),
        }
    }

    fn initialize_order(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 1, 1>, Once<1, 1, 1>>)
    {
        let r: ReferenceControl = self.reference.load(index: 0)
        if r.active_valid == 1 || r.pending == 1 {
            return
        }
        self.orbit.store(
            index: 16390 + invocation.global.x,
            value: order_block(invocation.global.x),
        )
    }

    // Validate a candidate against the latest view before doing more work.
    fn discard_stale_reference(self)
        uses (ReferencePass<Threads<1, 1, 1>, Once<1, 1, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let control: ReferenceControl = self.reference.load(index: 0)
        if control.pending == 0 || !s.is_input_settled() {
            return
        }
        let bank: u32 = if control.active == 0 { 1 } else { 0 }
        let candidate: ReferenceAnchor = self.anchor.load(index: bank)
        let delta: Complex<f32> = candidate.delta_from(s)
        if candidate.limit < iteration_limit(s.camera.zoom)
            || max(abs(delta.re), abs(delta.im)) > s.camera.zoom * 0.5
        {
            self.reference.store(index: 0, value: control.cancel_pending())
        }
    }

    fn build_reference(self)
        uses (ReferencePass<Threads<1, 1, 1>, Once<1, 1, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let previous: ViewCache = self.cache.load(index: 0)
        let age: f32 = s.input_age()
        let budget: u32 = preview_budget(s.camera.zoom)
        let control: ReferenceControl = self.reference.load(index: 0)
        let display_age: f32 = control.display_age(s)
        let radius: f32 = blur_radius(display_age)
        self.cache.store(
            index: 0,
            value: previous.sync_with_view(s, budget, radius, display_age),
        )
        let active_anchor: ReferenceAnchor = self.anchor.load(index: control.active)
        let delta: Complex<f32> = active_anchor.delta_from(s)
        let target: u32 = iteration_limit(s.camera.zoom)
        let reusable: bool = control.active_valid == 1
            && active_anchor.limit >= target
            && abs(delta.re) <= s.camera.zoom * 0.125
            && abs(delta.im) <= s.camera.zoom * 0.125
        if control.pending == 0 && reusable {
            return
        }
        // Keep the active orbit available while a replacement advances in
        // bounded exact-integer batches. Pointer input never queues behind
        // an entire multi-thousand-step reference recurrence.
        if control.active_valid == 1 && age < 60.0 {
            return
        }
        let bank: u32 = 1 - control.active
        let base: u32 = bank * 8195
        if control.pending == 0 {
            self.anchor.store(
                index: bank,
                value: ReferenceAnchor::from_state(s, target, active_anchor.generation + 1),
            )
            clear_reference_checkpoint(self.reference_words)
            self.orbit.store(index: base, value: PackedReference::zero())
            self.reference.store(index: 0, value: control.start_pending())
            return
        }
        let pending_anchor: ReferenceAnchor = self.anchor.load(index: bank)
        let center: Complex<ReferenceReal> = reference_center(pending_anchor)
        let mut z: Complex<ReferenceReal> = load_reference_checkpoint(
            self.reference_words,
            control,
        )
        let mut i: u32 = control.index
        let mut step: u32 = 0
        let mut escaped: bool = false
        while step < 64 && i < pending_anchor.limit && !escaped {
            let result: ReferenceStep = reference_step(z, center)
            z = result.value
            escaped = result.escaped
            self.orbit.store(
                index: base + i + 1,
                value: PackedReference::from_fixed(z),
            )
            i = i + 1
            step = step + 1
        }
        if escaped || i >= pending_anchor.limit {
            self.orbit.store(
                index: base + ORBIT_CENTER_INDEX,
                value: PackedReference::from_fixed(center),
            )
            self.orbit.store(
                index: base + ORBIT_META_INDEX,
                value: PackedReference::from_metadata(i + 1, pending_anchor.limit),
            )
            self.reference.store(
                index: 0,
                value: ReferenceControl::publish(
                    bank,
                    i,
                    z.re.sign,
                    z.im.sign,
                    s.clock,
                ),
            )
            let view: ViewCache = self.cache.load(index: 0)
            self.cache.store(index: 0, value: view.invalidate_for_new_reference())
        } else {
            store_reference_checkpoint(self.reference_words, z)
            self.reference.store(
                index: 0,
                value: control.advance_pending(i, z.re.sign, z.im.sign),
            )
        }
    }

    fn render_preview(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<32, 32, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let ref_state: ReferenceControl = self.reference.load(index: 0)
        if ref_state.active_valid == 0 {
            return
        }
        if self.cache.load(index: 0).preview_dirty == 0 {
            return
        }
        let x: u32 = invocation.global.x
        let y: u32 = invocation.global.y
        let px: i32 = to_i32(from_i32(__bitcast<u32, i32>(x)) * s.camera.res / 256.0)
        let py: i32 = to_i32(from_i32(__bitcast<u32, i32>(y)) * s.camera.res / 256.0)
        let full: ViewCache = self.cache.load(index: 1)
        let initial: ViewCache = self.cache.load(index: 2)
        let use_full: bool = full.completed == 1 && full.epoch >= initial.epoch
        let old: ViewCache = if use_full { full } else { initial }
        let delta: Complex<f32> = old.delta_from(s)
        let u: f32 = (from_i32(px) + 0.5) * 2.0 / s.camera.res - 1.0
        let v: f32 = 1.0 - (from_i32(py) + 0.5) * 2.0 / s.camera.res
        let span: f32 = max(old.zoom, ZOOM_MIN)
        let sx: f32 = ((delta.re + u * s.camera.zoom) / span + 1.0) * old.res * 0.5 - 0.5
        let sy: f32 = (1.0 - (delta.im + v * s.camera.zoom) / span) * old.res * 0.5 - 0.5
        let reusable: bool = old.completed == 1
            && sx >= 0.0
            && sy >= 0.0
            && sx < old.res - 1.0
            && sy < old.res - 1.0
        let cached: Color = if use_full {
            sample_snapshot(self.snapshot_pixels, sx, sy, old.res)
        } else {
            let scale: f32 = 256.0 / max(old.res, 1.0)
            sample(self.initial_pixels, sx * scale, sy * scale)
        }
        let age: f32 = ref_state.display_age(s)
        if reusable && age < 60.0 {
            self.pixels.store(index: (y << 8) | x, value: cached)
            return
        }
        let computed: OrbitProgress = sample_progress(
            self.orbit,
            ref_state.active * 8195,
            s.camera,
            PixelSample::ordered_2x2(px, py),
            preview_budget(s.camera.zoom),
        )
        let current: Color = unpack_lab(progress_color(computed))
        let result: Color = if reusable {
            blend(cached, current, progress(age, 60.0, 300.0))
        } else {
            current
        }
        self.pixels.store(index: (y << 8) | x, value: result)
    }

    // Preserve the first settled preview before native refinement finishes.
    // Neither this image nor its camera metadata changes while input is live.
    fn cache_initial(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<32, 32, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let c: ViewCache = self.cache.load(index: 0)
        let old: ViewCache = self.cache.load(index: 2)
        let ref_state: ReferenceControl = self.reference.load(index: 0)
        if !ref_state.can_publish_initial(s, c.epoch, old.epoch) {
            return
        }
        let index: u32 = (invocation.global.y << 8) | invocation.global.x
        self.initial_pixels.store(
            index: index,
            value: self.pixels.load(index: index),
        )
    }

    fn publish_initial(self)
        uses (ReferencePass<Threads<1, 1, 1>, Once<1, 1, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let c: ViewCache = self.cache.load(index: 0)
        let old: ViewCache = self.cache.load(index: 2)
        let ref_state: ReferenceControl = self.reference.load(index: 0)
        if !ref_state.can_publish_initial(s, c.epoch, old.epoch) {
            return
        }
        self.cache.store(index: 2, value: c.as_published_initial())
    }

    fn blur_horizontal(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<32, 32, 1>>)
    {
        if self.cache.load(index: 0).blur_dirty == 0 {
            return
        }
        let sigma: f32 = self.reference.load(index: 0).blur_sigma(self.state)
        self.horizontal.store(
            index: (invocation.global.y << 8) | invocation.global.x,
            value: gaussian(
                self.pixels,
                invocation.global.x,
                invocation.global.y,
                sigma,
                false,
            ),
        )
    }

    fn blur_vertical(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<32, 32, 1>>)
    {
        if self.cache.load(index: 0).blur_dirty == 0 {
            return
        }
        let sigma: f32 = self.reference.load(index: 0).blur_sigma(self.state)
        self.blurred.store(
            index: (invocation.global.y << 8) | invocation.global.x,
            value: gaussian(
                self.horizontal,
                invocation.global.x,
                invocation.global.y,
                sigma,
                true,
            ),
        )
    }

    // Spatially interleaved phases cover the whole image, rather
    // than sweeping rectangles. Each orbit resumes its own saved recurrence.
    fn restore_oracle(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<16, 32, 1>>)
    {
        let s: MandelbrotViewState = self.state
        if !s.is_input_settled() {
            return
        }
        let c: ViewCache = self.cache.load(index: 0)
        let history: ViewCache = self.cache.load(index: 1)
        let schedule: RefinementSchedule = RefinementSchedule::for_view(s.camera.zoom, s.camera.res)
        if history.completed == 0 || history.budget < schedule.limit {
            return
        }
        if !same_camera(history, c) {
            return
        }
        let pixel: CohortPixel = schedule.rect_pixel(
            c.cursor,
            invocation.global.x,
            invocation.global.y,
            s.camera.res,
        )
        if !pixel.active {
            return
        }
        let index: u32 = pixel.index()
        let saved: OrbitProgress = self.progress_pixels.load(index: index)
        if saved.is_presentable_in(c.epoch) {
            return
        }
        let deep: SampleOracle = self.snapshot_oracle.load(index: index)
        if !deep.is_usable() {
            return
        }
        let preserved: OrbitProgress = OrbitProgress::from_oracle(deep, c.epoch, s.clock)
        let base: u32 = progress_color(preserved)
        self.progress_pixels.store(index: index, value: preserved)
        self.native_pixels.store(index: index, value: base)
        let antialiased: u32 = if history.aa == s.antialias {
            self.snapshot_pixels.load(index: index)
        } else {
            base
        }
        self.antialiased_pixels.store(index: index, value: antialiased)
    }

    // A sparse, full-depth lattice reveals real results while the denser
    // checkpoints are still iterating. It shares their persistent buffers.
    fn seed_refinement(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<16, 16, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let ref_state: ReferenceControl = self.reference.load(index: 0)
        if !ref_state.can_refine(s) {
            return
        }
        let c: ViewCache = self.cache.load(index: 0)
        if c.cursor >= 16 || c.completed == 1 {
            return
        }
        let lane: u32 = (invocation.global.y % 4) * 4 + invocation.global.x % 4
        let rank: u32 = c.cursor * 16 + lane
        let block: PackedReference = self.orbit.load(index: 16390 + (rank >> 5))
        let pixel: CohortPixel = seed_pixel(
            block,
            rank,
            invocation.global.x,
            invocation.global.y,
            s.camera.res,
        )
        if !pixel.active {
            return
        }
        let index: u32 = pixel.index()
        let old: OrbitProgress = self.progress_pixels.load(index: index)
        if old.is_presentable_in(c.epoch) {
            return
        }
        let saved: OrbitProgress = if old.epoch == c.epoch {
            old
        } else {
            empty_progress(c.epoch)
        }
        let limit: u32 = iteration_limit(s.camera.zoom)
        let next: OrbitProgress = continue_pixel(
            self.orbit,
            ref_state.active * 8195,
            s.camera,
            pixel.sample(),
            limit,
            limit,
            saved,
        )
        self.progress_pixels.store(
            index: index,
            value: next.with_fade_start(s.clock),
        )
        let bits: u32 = progress_color(next)
        self.native_pixels.store(index: index, value: bits)
        self.antialiased_pixels.store(index: index, value: bits)
    }

    fn refine_pixels(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<16, 32, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let ref_state: ReferenceControl = self.reference.load(index: 0)
        if !ref_state.can_refine(s) {
            return
        }
        let c: ViewCache = self.cache.load(index: 0)
        let schedule: RefinementSchedule = RefinementSchedule::for_view(s.camera.zoom, s.camera.res)
        let pixel: CohortPixel = schedule.rect_pixel(
            c.cursor,
            invocation.global.x,
            invocation.global.y,
            s.camera.res,
        )
        if !pixel.active {
            return
        }
        let index: u32 = pixel.index()
        let old: OrbitProgress = self.progress_pixels.load(index: index)
        let saved: OrbitProgress = if old.epoch == c.epoch {
            old
        } else {
            empty_progress(c.epoch)
        }
        if saved.is_terminal(schedule.limit) {
            return
        }
        let next: OrbitProgress = continue_pixel(
            self.orbit,
            ref_state.active * 8195,
            s.camera,
            pixel.sample(),
            schedule.limit,
            2048,
            saved,
        )
        // Once terminal, z_re is free to hold the pixel's fade start time.
        let stored: OrbitProgress = if next.is_terminal(schedule.limit) {
            next.with_fade_start(s.clock)
        } else {
            next
        }
        self.progress_pixels.store(index: index, value: stored)
        let bits: u32 = progress_color(next)
        self.native_pixels.store(index: index, value: bits)
        self.antialiased_pixels.store(index: index, value: bits)
    }

    fn antialias_pixels(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<32, 32, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let ref_state: ReferenceControl = self.reference.load(index: 0)
        if !ref_state.can_refine(s) {
            return
        }
        let c: ViewCache = self.cache.load(index: 0)
        let schedule: RefinementSchedule = RefinementSchedule::for_view(s.camera.zoom, s.camera.res)
        let pixel: CohortPixel = schedule.aa_pixel(
            c.cursor,
            invocation.global.x,
            invocation.global.y,
            s.camera.res,
        )
        if !pixel.active {
            return
        }
        let index: u32 = pixel.index()
        let bits: u32 = self.native_pixels.load(index: index)
        let center: Color = unpack_lab(bits)
        let (left_i, right_i, up_i, down_i) = pixel.pixel.clamped_neighbor_indices(s.camera.res)
        let edge: f32 = max(
            max(
                contrast(center, unpack_lab(self.native_pixels.load(index: left_i))),
                contrast(center, unpack_lab(self.native_pixels.load(index: right_i))),
            ),
            max(
                contrast(center, unpack_lab(self.native_pixels.load(index: up_i))),
                contrast(center, unpack_lab(self.native_pixels.load(index: down_i))),
            ),
        )
        if s.antialias >= 0.5 && edge > 0.12 {
            let camera: Camera = s.camera
            let base: u32 = ref_state.active * 8195
            let a: Color = unpack_lab(sample_pixel(
                self.orbit,
                base,
                camera,
                pixel.offset_sample(Vec2 { x: 0.28, y: -0.28 }),
                schedule.limit,
            ))
            let b: Color = unpack_lab(sample_pixel(
                self.orbit,
                base,
                camera,
                pixel.offset_sample(Vec2 { x: -0.28, y: 0.28 }),
                schedule.limit,
            ))
            let averaged: Color = ((center + a) + b) / 3.0
            self.antialiased_pixels.store(
                index: index,
                value: pack_lab(averaged),
            )
        }
    }

    fn finish_refinement(self)
        uses (ReferencePass<Threads<1, 1, 1>, Once<1, 1, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let ref_state: ReferenceControl = self.reference.load(index: 0)
        if !ref_state.can_refine(s) {
            return
        }
        let c: ViewCache = self.cache.load(index: 0)
        let end: u32 = RefinementSchedule::for_view(s.camera.zoom, s.camera.res).total_steps()
        if c.cursor >= end {
            return
        }
        self.cache.store(index: 0, value: c.advance_cursor(end))
    }

    fn cache_snapshot(self, invocation: ComputeInvocation)
        uses (ReferencePass<Threads<8, 8, 1>, Once<32, 32, 1>>)
    {
        let s: MandelbrotViewState = self.state
        let c: ViewCache = self.cache.load(index: 0)
        let snapshot: ViewCache = self.cache.load(index: 1)
        if c.completed == 0 || snapshot.epoch == c.epoch {
            return
        }
        // Copy only on publication. Small dispatch also makes the idle guard
        // cheap; coalesced lanes cover the fixed-stride image in 64 strips.
        let lane: u32 = (invocation.global.y << 8) | invocation.global.x
        let mut strip: u32 = 0
        while strip < 64 {
            let index: u32 = lane + (strip << 16)
            let pixel: Pixel = Pixel {
                x: index & 2047,
                y: index >> 11,
            }
            if pixel.in_extent(s.camera.res) {
                self.snapshot_pixels.store(
                    index: index,
                    value: self.antialiased_pixels.load(index: index),
                )
                let result: OrbitProgress = self.progress_pixels.load(index: index)
                self.snapshot_oracle.store(index: index, value: result.to_oracle())
            }
            strip = strip + 1
        }
    }

    fn publish_snapshot(self)
        uses (ReferencePass<Threads<1, 1, 1>, Once<1, 1, 1>>)
    {
        let c: ViewCache = self.cache.load(index: 0)
        if c.completed == 1 {
            self.cache.store(index: 1, value: c)
        }
    }

    fn display_preview(self, px: i32, py: i32) -> i32 uses (Display) {
        let s: MandelbrotViewState = self.state
        let pixel: Pixel = Pixel {
            x: __bitcast<i32, u32>(px) & 2047,
            y: __bitcast<i32, u32>(py) & 2047,
        }
        let index: u32 = pixel.native_index()
        let c: ViewCache = self.cache.load(index: 0)
        let reference_state: ReferenceControl = self.reference.load(index: 0)
        let reveal: f32 = sharpness(reference_state.display_age(s))
        let saved: OrbitProgress = self.progress_pixels.load(index: index)
        if saved.is_presentable_in(c.epoch) {
            let bits: u32 = self.antialiased_pixels.load(index: index)
            let amount: f32 = progress(s.clock - saved.fade_started_at(), 0.0, 350.0) * reveal
            if amount >= 1.0 {
                return display_rgba(unpack_lab(bits))
            }
            let coarse: Color = sample(
                self.blurred,
                from_i32(px) * 256.0 / s.camera.res,
                from_i32(py) * 256.0 / s.camera.res,
            )
            return display_rgba(blend(coarse, unpack_lab(bits), amount))
        }
        let coarse: Color = sample(
            self.blurred,
            from_i32(px) * 256.0 / s.camera.res,
            from_i32(py) * 256.0 / s.camera.res,
        )
        let stride: f32 = from_i32(to_i32((s.camera.res + 511.0) / 512.0))
        let tap: BilinearTap = lattice_tap(px, py, stride, s.camera.res - 1.0)
        let a: OrbitProgress = self.progress_pixels.load(index: tap.i00)
        let b: OrbitProgress = self.progress_pixels.load(index: tap.i10)
        let d: OrbitProgress = self.progress_pixels.load(index: tap.i01)
        let e: OrbitProgress = self.progress_pixels.load(index: tap.i11)
        let ready: bool = a.is_presentable_in(c.epoch)
            && b.is_presentable_in(c.epoch)
            && d.is_presentable_in(c.epoch)
            && e.is_presentable_in(c.epoch)
        if ready {
            let sparse: Color = blend_corners(
                unpack_lab(self.native_pixels.load(index: tap.i00)),
                unpack_lab(self.native_pixels.load(index: tap.i10)),
                unpack_lab(self.native_pixels.load(index: tap.i01)),
                unpack_lab(self.native_pixels.load(index: tap.i11)),
                tap.tx,
                tap.ty,
            )
            let latest_fade: f32 = finite_max(
                finite_max(a.fade_started_at(), b.fade_started_at()),
                finite_max(d.fade_started_at(), e.fade_started_at()),
            )
            let since: f32 = s.clock - latest_fade
            display_rgba(blend(coarse, sparse, progress(since, 0.0, 350.0) * reveal))
        } else {
            display_rgba(coarse)
        }
    }

    fn navigate(self, event: own SurfaceEvent) -> SurfaceStateEnvelope
        uses (SurfaceTransition, SurfaceScheduling<ContinuousFrames>)
    {
        SurfaceStateEnvelope {
            state: transition(self.state, event),
        }
    }
}

#[test]
fn reference_checkpoint_roundtrips_every_limb() {
    let words: [u32; 8] = [0, 1, 8191, 17, 4096, 3, 8000, 2]
    let magnitude = fixed_magnitude_from_words<8>(words)
    let restored = fixed_magnitude_to_words<8>(magnitude)
    let mut i: usize = 0
    while i < 8 {
        assert(restored[i] == words[i])
        i = i + 1
    }
}

#[test]
fn orbit_progress_and_oracle_flags_roundtrip() {
    let initial_bits: u32 = 0
    assert(!progress_is_presentable(initial_bits))
    assert(!progress_is_escaped(initial_bits))
    assert(!progress_is_glitched(initial_bits))
    assert(!progress_has_outcome(initial_bits))
    assert(!progress_is_terminal(initial_bits, 0, 256))
    assert(progress_is_terminal(initial_bits, 256, 256))

    let escaped_bits: u32 = progress_with_presentable(pack_progress_reference(42, 1, 0))
    assert(progress_is_presentable(escaped_bits))
    assert(progress_is_escaped(escaped_bits))
    assert(!progress_is_glitched(escaped_bits))
    assert(progress_is_terminal(escaped_bits, 137, 256))
    assert(progress_reference_index(escaped_bits) == 42)

    let oracle_flags: u32 = progress_outcome_flags(escaped_bits)
    assert(!oracle_is_glitched(oracle_flags))
    assert(oracle_is_usable(oracle_flags))
    let restored_bits: u32 = progress_with_presentable(oracle_flags)
    assert(progress_is_presentable(restored_bits))
    assert(progress_is_escaped(restored_bits))
    assert(!progress_is_glitched(restored_bits))
    assert(progress_reference_index(restored_bits) == 0)

    let glitched_bits: u32 = pack_progress_reference(19, 0, 1)
    let glitched_flags: u32 = progress_outcome_flags(glitched_bits)
    assert(oracle_is_glitched(glitched_flags))
    assert(!oracle_is_usable(glitched_flags))

    let presentable_interior: u32 = progress_with_presentable(0)
    assert(progress_is_presentable(presentable_interior))
    assert(progress_is_terminal(presentable_interior, 10, 256))
}

#[test]
fn blue_noise_order_tile_is_bijective() {
    let mut sum: u32 = 0
    let mut sq_sum: u32 = 0
    let mut rank: u32 = 0
    while rank < 256 {
        let block: PackedReference = order_block(rank >> 5)
        let pos: u32 = unpack_order_byte(block, rank)
        assert(pos < 256)
        sum = sum + pos
        sq_sum = sq_sum + pos * pos
        rank = rank + 1
    }
    assert(sum == 32640)
    assert(sq_sum == 5559680)
}

fn assert_step_matches_oracle(
    _ z: Complex<ReferenceReal>,
    _ center: Complex<ReferenceReal>,
) -> ReferenceStep {
    let result: ReferenceStep = reference_step(z, center)
    let (nx_s, nx, ny_s, ny, did_escape) = mandelbrot_advance8(
        z.re.sign,
        z.re.magnitude,
        z.im.sign,
        z.im.magnitude,
        center.re.sign,
        center.re.magnitude,
        center.im.sign,
        center.im.magnitude,
    )
    assert(result.escaped == (did_escape == 1))
    assert(result.value.re.sign == nx_s)
    assert(result.value.im.sign == ny_s)
    let actual_re: [u32; 8] = result.value.re.to_words()
    let actual_im: [u32; 8] = result.value.im.to_words()
    let expected_re: [u32; 8] = fixed_magnitude_to_words<8>(nx)
    let expected_im: [u32; 8] = fixed_magnitude_to_words<8>(ny)
    let mut i: usize = 0
    while i < 8 {
        assert(actual_re[i] == expected_re[i])
        assert(actual_im[i] == expected_im[i])
        i = i + 1
    }
    let packed: PackedReference = PackedReference::from_fixed(result.value)
    let (rx0, rx1, rx2, rx3) = to_f32_quad_bits<8>(nx_s, nx)
    let (iy0, iy1, iy2, iy3) = to_f32_quad_bits<8>(ny_s, ny)
    assert(packed.re_w0_bits == rx0)
    assert(packed.re_w1_bits == rx1)
    assert(packed.re_w2_bits == rx2)
    assert(packed.re_w3_bits == rx3)
    assert(packed.im_w0_bits == iy0)
    assert(packed.im_w1_bits == iy1)
    assert(packed.im_w2_bits == iy2)
    assert(packed.im_w3_bits == iy3)
    result
}

#[test]
fn reference_step_matches_mandelbrot_advance8_all_limbs_and_signs() {
    let re_words: [u32; 8] = [7123, 513, 8191, 2049, 4096, 17, 6001, 1]
    let im_words: [u32; 8] = [8001, 1023, 3333, 4095, 19, 7777, 2500, 0]
    let cx_words: [u32; 8] = [1234, 5678, 91, 4321, 8000, 77, 960, 1]
    let cy_words: [u32; 8] = [999, 2048, 4096, 8191, 13, 512, 2425, 0]
    let mut mask: u32 = 0
    while mask < 16 {
        let z: Complex<ReferenceReal> = Complex {
            re: ReferenceReal::from_words(mask & 1, re_words),
            im: ReferenceReal::from_words((mask >> 1) & 1, im_words),
        }
        let center: Complex<ReferenceReal> = Complex {
            re: ReferenceReal::from_words((mask >> 2) & 1, cx_words),
            im: ReferenceReal::from_words((mask >> 3) & 1, cy_words),
        }
        let _ = assert_step_matches_oracle(z, center)
        mask = mask + 1
    }
}

#[test]
fn reference_step_escape_cancellation_and_negative_zero() {
    // 1. Input already escaped (|z|^2 > 4): returns input unchanged with sign and all limbs intact.
    let escaped_z: Complex<ReferenceReal> = Complex {
        re: ReferenceReal::from_words(1, [5, 0, 0, 0, 0, 0, 0, 2]),
        im: ReferenceReal::from_words(1, [3, 0, 0, 0, 0, 0, 0, 0]),
    }
    let center: Complex<ReferenceReal> = Complex {
        re: ReferenceReal::from_words(1, [0, 0, 0, 0, 0, 0, 4096, 1]),
        im: ReferenceReal::from_words(0, [0, 0, 0, 0, 0, 0, 2048, 0]),
    }
    let escaped_step: ReferenceStep = assert_step_matches_oracle(escaped_z, center)
    assert(escaped_step.escaped)
    assert(escaped_step.value.re.sign == 1)
    assert(escaped_step.value.im.sign == 1)

    // 2. Boundary |z|^2 == 4 (antenna tip z = -2 + 0i): must NOT escape on input.
    let antenna: Complex<ReferenceReal> = Complex {
        re: ReferenceReal::from_words(1, [0, 0, 0, 0, 0, 0, 0, 2]),
        im: ReferenceReal::zero(),
    }
    let antenna_center: Complex<ReferenceReal> = Complex {
        re: ReferenceReal::from_words(1, [0, 0, 0, 0, 0, 0, 0, 2]),
        im: ReferenceReal::zero(),
    }
    let antenna_step: ReferenceStep = assert_step_matches_oracle(antenna, antenna_center)
    assert(!antenna_step.escaped)

    // 3. Near-cancellation (z.re ≈ z.im across all 8 limbs, differing by 1 LSB).
    let cancel_z: Complex<ReferenceReal> = Complex {
        re: ReferenceReal::from_words(1, [4001, 7000, 123, 4567, 890, 1234, 5555, 0]),
        im: ReferenceReal::from_words(0, [4000, 7000, 123, 4567, 890, 1234, 5555, 0]),
    }
    let _ = assert_step_matches_oracle(cancel_z, center)

    // 4. Exact zero and negative-zero sign semantics.
    let neg_zero_z: Complex<ReferenceReal> = Complex {
        re: ReferenceReal::from_words(1, [0; 8]),
        im: ReferenceReal::from_words(1, [0; 8]),
    }
    let neg_zero_center: Complex<ReferenceReal> = Complex {
        re: ReferenceReal::from_words(1, [0; 8]),
        im: ReferenceReal::from_words(0, [0; 8]),
    }
    let _ = assert_step_matches_oracle(neg_zero_z, neg_zero_center)
}

#[test]
fn reference_step_resumed_64_step_batches_match_oracle() {
    let center: Complex<ReferenceReal> = Complex {
        re: ReferenceReal::from_words(1, [111, 222, 333, 444, 555, 666, 4800, 0]),
        im: ReferenceReal::from_words(0, [777, 888, 999, 1111, 2222, 3333, 2100, 0]),
    }
    let mut z_batch: Complex<ReferenceReal> = Complex::default()
    let mut step: u32 = 0
    while step < 64 {
        let result: ReferenceStep = assert_step_matches_oracle(z_batch, center)
        assert(!result.escaped)
        z_batch = result.value
        step = step + 1
    }
    // Simulate checkpoint save and resume at 64 steps, then advance another 64 steps.
    let saved_re: [u32; 8] = z_batch.re.to_words()
    let saved_im: [u32; 8] = z_batch.im.to_words()
    let mut z_resumed: Complex<ReferenceReal> = Complex {
        re: ReferenceReal::from_words(z_batch.re.sign, saved_re),
        im: ReferenceReal::from_words(z_batch.im.sign, saved_im),
    }
    while step < 128 {
        let result: ReferenceStep = assert_step_matches_oracle(z_resumed, center)
        assert(!result.escaped)
        z_resumed = result.value
        step = step + 1
    }
}

#[test]
fn pixel_indices_and_packed_defaults_preserve_invariants() {
    let inactive: CohortPixel = CohortPixel::default()
    let expected_origin: Pixel = Pixel { x: 0, y: 0 }
    assert(!inactive.active)
    assert(inactive.pixel == expected_origin)
    assert(inactive.index() == 0)

    let coarse: Pixel = Pixel { x: 255, y: 127 }
    assert(coarse.coarse_index() == ((127 << 8) | 255))

    let fine: Pixel = Pixel { x: 2047, y: 1023 }
    assert(fine.native_index() == ((1023 << 11) | 2047))

    let zero_ref: PackedReference = PackedReference::zero()
    let mut slot: u32 = 0
    while slot < 8 {
        assert(zero_ref.word(slot) == 0)
        slot = slot + 1
    }

    let meta: PackedReference = PackedReference::from_metadata(513, 4096)
    let decoded = meta.decode_metadata()
    assert(decoded.valid_samples == 513)
    assert(decoded.limit == 4096)
    let mut tail: u32 = 2
    while tail < 8 {
        assert(meta.word(tail) == 0)
        tail = tail + 1
    }
}
