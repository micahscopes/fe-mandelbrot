//! Perturbation arithmetic and resumable pixel checkpoints.
//! Escape and cancellation rules are shared by preview, refinement and AA.
use core::default::Default
use core::marker::Copy
use core::ops::{Add, Eq, Sub}
use std::webgpu::StorageBuffer as OrbitBuffer
use fmath::{abs, max, PixelSample}
use ingot::cache::{ReferenceAnchor, ReferenceControl, SampleOracle}
use ingot::palette::{escape_palette, interior, glitch}
use ingot::policy::Camera
use precision::{Expansion, from_quad, sub, to_quad, two_sum}
use precision::field::{Limbs, Zero}
use precision::fixed::{
    add as fixed_add,
    escaped as fixed_escaped,
    fixed_magnitude_from_words,
    fixed_magnitude_to_words,
    from_qf_offset,
    mul as fixed_mul,
    sqr as fixed_sqr,
    sub as fixed_sub,
    to_f32_quad_bits,
}

extern {
    const fn __bitcast<From, To>(_: From) -> To
}

pub const ORBIT_SAMPLES: usize = 8195
// Eight suffix records hold the immutable packed blue-noise ordering.
pub const ORBIT_CAPACITY: usize = 16398
pub const ORBIT_CENTER_INDEX: u32 = 8193
pub const ORBIT_META_INDEX: u32 = 8194
pub const INVALID_REFERENCE: u32 = 2143289344

pub const PROGRESS_REF_MASK: u32 = 536870911
pub const PROGRESS_PRESENTABLE_BIT: u32 = 536870912
pub const PROGRESS_GLITCHED_BIT: u32 = 1073741824
pub const PROGRESS_ESCAPED_BIT: u32 = 2147483648
pub const PROGRESS_OUTCOME_MASK: u32 = 3221225472

pub fn progress_reference_index(_ reference_i: u32) -> u32 {
    reference_i & PROGRESS_REF_MASK
}

pub fn progress_is_presentable(_ reference_i: u32) -> bool {
    (reference_i & PROGRESS_PRESENTABLE_BIT) != 0
}

pub fn progress_is_glitched(_ reference_i: u32) -> bool {
    (reference_i & PROGRESS_GLITCHED_BIT) != 0
}

pub fn progress_is_escaped(_ reference_i: u32) -> bool {
    (reference_i & PROGRESS_ESCAPED_BIT) != 0
}

pub fn progress_has_outcome(_ reference_i: u32) -> bool {
    (reference_i & PROGRESS_OUTCOME_MASK) != 0
}

pub fn progress_is_terminal(_ reference_i: u32, _ iteration: u32, _ limit: u32) -> bool {
    iteration >= limit || progress_has_outcome(reference_i)
}

pub fn progress_outcome_flags(_ reference_i: u32) -> u32 {
    reference_i & PROGRESS_OUTCOME_MASK
}

pub fn progress_with_presentable(_ reference_i: u32) -> u32 {
    reference_i | PROGRESS_PRESENTABLE_BIT
}

/// A complex value over any real representation `T` (`f32`, `Expansion<4>`, or `ReferenceReal`).
pub struct Complex<T> {
    pub re: T,
    pub im: T,
}

impl<T: Copy> Copy for Complex<T> {}

impl<T: Default> Default for Complex<T> {
    fn default() -> Self {
        Self {
            re: T::default(),
            im: T::default(),
        }
    }
}

impl<T: Eq> Eq for Complex<T> {
    fn eq(self, _ other: Self) -> bool {
        self.re == other.re && self.im == other.im
    }
}

impl<T: Add<Output = T>> Add for Complex<T> {
    fn add(own self, _ other: own Self) -> Self {
        Self {
            re: self.re + other.re,
            im: self.im + other.im,
        }
    }
}

impl<T: Sub<Output = T>> Sub for Complex<T> {
    fn sub(own self, _ other: own Self) -> Self {
        Self {
            re: self.re - other.re,
            im: self.im - other.im,
        }
    }
}

impl Complex<f32> {
    pub fn norm_squared(self) -> f32 {
        self.re * self.re + self.im * self.im
    }

    pub fn is_non_finite(self) -> bool {
        non_finite(self.re) || non_finite(self.im)
    }
}

/// Exact sign-magnitude `Fixed<8>` coordinate used in the reference recurrence.
/// Keeping recursive `Limbs<8>` inside the value avoids per-operation array
/// conversions while preserving exact sign and negative-zero semantics.
pub struct ReferenceReal {
    pub sign: u32,
    pub magnitude: Limbs<8>,
}

impl Copy for ReferenceReal {}

impl Default for ReferenceReal {
    fn default() -> Self {
        Self {
            sign: 0,
            magnitude: <Limbs<8> as Zero>::zero(),
        }
    }
}

impl ReferenceReal {
    pub fn zero() -> Self {
        Self::default()
    }

    pub fn from_quad(_ w0: f32, _ w1: f32, _ w2: f32, _ w3: f32) -> Self {
        let (sign, magnitude) = from_qf_offset<8>(w0, w1, w2, w3, 0.0)
        Self {
            sign: sign,
            magnitude: magnitude,
        }
    }

    pub fn from_expansion(_ value: Expansion<4>) -> Self {
        let (w0, w1, w2, w3) = to_quad(value)
        Self::from_quad(w0, w1, w2, w3)
    }

    pub fn from_words(_ sign: u32, _ words: [u32; 8]) -> Self {
        Self {
            sign: sign,
            magnitude: fixed_magnitude_from_words<8>(words),
        }
    }

    pub fn to_words(self) -> [u32; 8] {
        fixed_magnitude_to_words<8>(self.magnitude)
    }

    pub fn to_quad_bits(self) -> (u32, u32, u32, u32) {
        to_f32_quad_bits<8>(self.sign, self.magnitude)
    }

    pub fn square(self) -> Self {
        let (sign, magnitude) = fixed_sqr<8>(self.sign, self.magnitude)
        Self {
            sign: sign,
            magnitude: magnitude,
        }
    }

    pub fn multiply(self, _ other: Self) -> Self {
        let (sign, magnitude) = fixed_mul<8>(
            self.sign,
            self.magnitude,
            other.sign,
            other.magnitude,
        )
        Self {
            sign: sign,
            magnitude: magnitude,
        }
    }

    pub fn escaped(self) -> bool {
        fixed_escaped<8>(self.magnitude) == 1
    }
}

impl Add for ReferenceReal {
    fn add(own self, _ other: own Self) -> Self {
        let (sign, magnitude) = fixed_add<Limbs<8>>(
            self.sign,
            self.magnitude,
            other.sign,
            other.magnitude,
        )
        Self {
            sign: sign,
            magnitude: magnitude,
        }
    }
}

impl Sub for ReferenceReal {
    fn sub(own self, _ other: own Self) -> Self {
        let (sign, magnitude) = fixed_sub<Limbs<8>>(
            self.sign,
            self.magnitude,
            other.sign,
            other.magnitude,
        )
        Self {
            sign: sign,
            magnitude: magnitude,
        }
    }
}

pub struct ReferenceStep {
    pub value: Complex<ReferenceReal>,
    pub escaped: bool,
}

impl Copy for ReferenceStep {}

/// Advance one exact `Complex<ReferenceReal>` orbit sample by `z^2 + center`,
/// returning the input `z` unchanged when `|z|^2 > 4`.
pub fn reference_step(
    _ z: Complex<ReferenceReal>,
    _ center: Complex<ReferenceReal>,
) -> ReferenceStep {
    let xx: ReferenceReal = z.re.square()
    let yy: ReferenceReal = z.im.square()
    if (xx + yy).escaped() {
        ReferenceStep {
            value: z,
            escaped: true,
        }
    } else {
        let xy: ReferenceReal = z.re.multiply(z.im)
        let real: ReferenceReal = (xx - yy) + center.re
        let imag: ReferenceReal = (xy + xy) + center.im
        ReferenceStep {
            value: Complex {
                re: real,
                im: imag,
            },
            escaped: false,
        }
    }
}

pub fn reference_center(_ anchor: ReferenceAnchor) -> Complex<ReferenceReal> {
    Complex {
        re: ReferenceReal::from_quad(
            anchor.x0,
            anchor.x1,
            anchor.x2,
            anchor.x3,
        ),
        im: ReferenceReal::from_quad(
            anchor.y0,
            anchor.y1,
            anchor.y2,
            anchor.y3,
        ),
    }
}

pub fn clear_reference_checkpoint(_ words: OrbitBuffer<u32, 16>) {
    let mut slot: u32 = 0
    while slot < 16 {
        words.store(index: slot, value: 0)
        slot = slot + 1
    }
}

pub fn load_reference_checkpoint(
    _ words: OrbitBuffer<u32, 16>,
    _ control: ReferenceControl,
) -> Complex<ReferenceReal> {
    let mut re_words: [u32; 8] = [0; 8]
    let mut im_words: [u32; 8] = [0; 8]
    let mut i: usize = 0
    while i < 8 {
        let slot: u32 = i.downcast_truncate()
        re_words[i] = words.load(index: slot)
        im_words[i] = words.load(index: slot + 8)
        i = i + 1
    }
    Complex {
        re: ReferenceReal::from_words(control.zx_s, re_words),
        im: ReferenceReal::from_words(control.zy_s, im_words),
    }
}

pub fn store_reference_checkpoint(
    _ words: OrbitBuffer<u32, 16>,
    _ z: Complex<ReferenceReal>,
) {
    let re_words: [u32; 8] = z.re.to_words()
    let im_words: [u32; 8] = z.im.to_words()
    let mut i: usize = 0
    while i < 8 {
        let slot: u32 = i.downcast_truncate()
        words.store(index: slot, value: re_words[i])
        words.store(index: slot + 8, value: im_words[i])
        i = i + 1
    }
}

pub struct ReferenceMetadata {
    pub valid_samples: u32,
    pub limit: u32,
}

impl Copy for ReferenceMetadata {}

pub struct PackedReference {
    pub re_w0_bits: u32,
    pub re_w1_bits: u32,
    pub re_w2_bits: u32,
    pub re_w3_bits: u32,
    pub im_w0_bits: u32,
    pub im_w1_bits: u32,
    pub im_w2_bits: u32,
    pub im_w3_bits: u32,
}

impl Copy for PackedReference {}

impl Default for PackedReference {
    fn default() -> Self {
        Self::from_words(0, 0, 0, 0, 0, 0, 0, 0)
    }
}

impl PackedReference {
    pub fn zero() -> Self {
        Self::default()
    }

    pub fn from_words(
        _ rx0: u32,
        _ rx1: u32,
        _ rx2: u32,
        _ rx3: u32,
        _ iy0: u32,
        _ iy1: u32,
        _ iy2: u32,
        _ iy3: u32,
    ) -> Self {
        PackedReference {
            re_w0_bits: rx0,
            re_w1_bits: rx1,
            re_w2_bits: rx2,
            re_w3_bits: rx3,
            im_w0_bits: iy0,
            im_w1_bits: iy1,
            im_w2_bits: iy2,
            im_w3_bits: iy3,
        }
    }

    pub fn from_fixed(_ value: Complex<ReferenceReal>) -> Self {
        let (rx0, rx1, rx2, rx3) = value.re.to_quad_bits()
        let (iy0, iy1, iy2, iy3) = value.im.to_quad_bits()
        Self::from_words(rx0, rx1, rx2, rx3, iy0, iy1, iy2, iy3)
    }

    pub fn from_metadata(_ valid_samples: u32, _ limit: u32) -> Self {
        let mut packed: Self = Self::default()
        packed.re_w0_bits = valid_samples
        packed.re_w1_bits = limit
        packed
    }

    pub fn decode_metadata(self) -> ReferenceMetadata {
        ReferenceMetadata {
            valid_samples: self.re_w0_bits,
            limit: self.re_w1_bits,
        }
    }

    pub fn is_invalid(self) -> bool {
        self.re_w0_bits == INVALID_REFERENCE || self.im_w0_bits == INVALID_REFERENCE
    }

    pub fn decode(self) -> Complex<Expansion<4>> {
        Complex {
            re: from_quad(
                __bitcast(self.re_w0_bits),
                __bitcast(self.re_w1_bits),
                __bitcast(self.re_w2_bits),
                __bitcast(self.re_w3_bits),
            ),
            im: from_quad(
                __bitcast(self.im_w0_bits),
                __bitcast(self.im_w1_bits),
                __bitcast(self.im_w2_bits),
                __bitcast(self.im_w3_bits),
            ),
        }
    }

    pub fn word(self, _ slot: u32) -> u32 {
        match slot & 7 {
            0 => self.re_w0_bits,
            1 => self.re_w1_bits,
            2 => self.re_w2_bits,
            3 => self.re_w3_bits,
            4 => self.im_w0_bits,
            5 => self.im_w1_bits,
            6 => self.im_w2_bits,
            _ => self.im_w3_bits,
        }
    }

    pub fn re_expansion(self) -> Expansion<4> {
        self.decode().re
    }

    pub fn im_expansion(self) -> Expansion<4> {
        self.decode().im
    }
}

pub fn offset_sample(_ px: i32, _ py: i32, _ ox: f32, _ oy: f32) -> PixelSample {
    let base: PixelSample = PixelSample::ordered_2x2(px, py)
    PixelSample { x: base.x + ox, y: base.y + oy }
}

fn invalid_reference(_ sample: PackedReference) -> bool {
    sample.is_invalid()
}

fn non_finite(_ value: f32) -> bool {
    value - value != 0.0
}

/// Collapse an exact four-word reference plus the pixel delta without losing
/// the reference tail when `w0` and `delta` nearly cancel. The ordinary
/// `w0 + w1 + w2 + w3 + delta` ordering discards every low word before the
/// cancellation happens, which poisons both bailout and center reanchoring.
fn reference_plus_delta(_ w0: f32, _ w1: f32, _ w2: f32, _ w3: f32, _ delta: f32) -> f32 {
    let (s0, e0) = two_sum(w0, delta)
    let (s1, e1) = two_sum(s0, w1)
    let (s2, e2) = two_sum(s1, w2)
    let (s3, e3) = two_sum(s2, w3)
    s3 + (((e3 + e2) + e1) + e0)
}

/// Compute the initial complex perturbation `dc` for a sample relative to the
/// active reference center stored at `base + ORBIT_CENTER_INDEX`.
fn pixel_delta_from_reference(
    _ orbit: OrbitBuffer<PackedReference, ORBIT_CAPACITY>,
    _ base: u32,
    _ camera: Camera,
    _ sample: PixelSample,
) -> (f32, f32) {
    let point = sample.plane(camera.res)
    let center_reference: PackedReference = orbit.load(index: base + ORBIT_CENTER_INDEX)
    let center_remainder_re = sub<4>(camera.center_x, center_reference.re_expansion())
    let center_remainder_im = sub<4>(camera.center_y, center_reference.im_expansion())
    let (dc_re_w0, dc_re_w1, dc_re_w2, dc_re_w3) = to_quad(center_remainder_re)
    let (dc_im_w0, dc_im_w1, dc_im_w2, dc_im_w3) = to_quad(center_remainder_im)
    let dc_re: f32 = reference_plus_delta(
        dc_re_w0,
        dc_re_w1,
        dc_re_w2,
        dc_re_w3,
        point.u * camera.zoom,
    )
    let dc_im: f32 = reference_plus_delta(
        dc_im_w0,
        dc_im_w1,
        dc_im_w2,
        dc_im_w3,
        point.v * camera.zoom,
    )
    (dc_re, dc_im)
}

/// A uniform iteration budget computed once by the reference pass. The pixel
/// pass reads the result from orbit metadata and does no depth probing.
pub fn sample_pixel(
    _ orbit: OrbitBuffer<PackedReference, ORBIT_CAPACITY>,
    _ base: u32,
    _ camera: Camera,
    _ sample: PixelSample,
    _ budget: u32,
) -> i32 {
    progress_color(sample_progress(orbit, base, camera, sample, budget))
}

pub fn sample_progress(
    _ orbit: OrbitBuffer<PackedReference, ORBIT_CAPACITY>,
    _ base: u32,
    _ camera: Camera,
    _ sample: PixelSample,
    _ budget: u32,
) -> OrbitProgress {
    // The same one-orbit ordered refinement as the exact renderer. This is
    // deliberately not naive 4x supersampling: escaped samples terminate
    // early, and unfinished native samples resume from GPU checkpoints.
    let (dc_re, dc_im) = pixel_delta_from_reference(orbit, base, camera, sample)
    let metadata: ReferenceMetadata = orbit.load(index: base + ORBIT_META_INDEX).decode_metadata()
    let max_iter: u32 = if budget < metadata.limit {
        budget
    } else {
        metadata.limit
    }
    advance_progress(orbit, base, dc_re, dc_im, max_iter, max_iter, empty_progress(0))
}

pub struct OrbitProgress {
    pub dz_re: f32,
    pub dz_im: f32,
    pub z_re: f32,
    pub z_im: f32,
    pub reference_i: u32,
    pub iteration: u32,
    pub epoch: u32,
    pub magnitude: f32,
}

impl Copy for OrbitProgress {}

impl OrbitProgress {
    pub fn reference_index(self) -> u32 {
        self.reference_i & PROGRESS_REF_MASK
    }

    pub fn is_presentable(self) -> bool {
        (self.reference_i & PROGRESS_PRESENTABLE_BIT) != 0
    }

    pub fn is_presentable_in(self, _ epoch: u32) -> bool {
        self.epoch == epoch && self.is_presentable()
    }

    pub fn is_glitched(self) -> bool {
        (self.reference_i & PROGRESS_GLITCHED_BIT) != 0
    }

    pub fn is_escaped(self) -> bool {
        (self.reference_i & PROGRESS_ESCAPED_BIT) != 0
    }

    pub fn has_outcome(self) -> bool {
        (self.reference_i & PROGRESS_OUTCOME_MASK) != 0
    }

    pub fn is_terminal(self, _ limit: u32) -> bool {
        self.iteration >= limit || self.has_outcome()
    }

    pub fn outcome_flags(self) -> u32 {
        self.reference_i & PROGRESS_OUTCOME_MASK
    }

    /// While non-terminal, `z_re` holds the live real coordinate for rebasing;
    /// once presentable, `z_re` holds the timestamp at which the pixel's fade started.
    pub fn fade_started_at(self) -> f32 {
        self.z_re
    }

    pub fn with_fade_start(self, _ clock: f32) -> Self {
        let mut next: Self = self
        next.z_re = clock
        next.reference_i = self.reference_i | PROGRESS_PRESENTABLE_BIT
        next
    }

    pub fn to_oracle(self) -> SampleOracle {
        SampleOracle {
            iteration: self.iteration,
            magnitude: self.magnitude,
            flags: self.outcome_flags(),
        }
    }

    pub fn from_oracle(_ oracle: SampleOracle, _ epoch: u32, _ clock: f32) -> Self {
        OrbitProgress {
            dz_re: 0.0,
            dz_im: 0.0,
            z_re: clock,
            z_im: 0.0,
            reference_i: oracle.flags | PROGRESS_PRESENTABLE_BIT,
            iteration: oracle.iteration,
            epoch: epoch,
            magnitude: oracle.magnitude,
        }
    }
}

pub fn empty_progress(_ epoch: u32) -> OrbitProgress {
    OrbitProgress {
        dz_re: 0.0,
        dz_im: 0.0,
        z_re: 0.0,
        z_im: 0.0,
        reference_i: 0,
        iteration: 0,
        epoch: epoch,
        magnitude: 4.0,
    }
}

fn advance_progress(
    _ orbit: OrbitBuffer<PackedReference, ORBIT_CAPACITY>,
    _ base: u32,
    _ dc_re: f32,
    _ dc_im: f32,
    _ max_iter: u32,
    _ batch: u32,
    _ saved: OrbitProgress,
) -> OrbitProgress {
    let valid_samples: u32 = orbit.load(index: base + ORBIT_META_INDEX).decode_metadata().valid_samples
    let mut dz_re = saved.dz_re
    let mut dz_im = saved.dz_im
    let mut z_re = saved.z_re
    let mut z_im = saved.z_im
    let mut reference_i = saved.reference_index()
    let mut escaped: u32 = if saved.is_escaped() { 1 } else { 0 }
    let mut glitched: u32 = if saved.is_glitched() { 1 } else { 0 }
    let mut escape_magnitude = saved.magnitude
    let mut i = saved.iteration
    let mut steps: u32 = 0
    while i < max_iter && steps < batch && escaped == 0 && glitched == 0 {
        if escaped == 0 && glitched == 0 {
            if reference_i + 1 >= valid_samples {
                reference_i = 0
                dz_re = z_re
                dz_im = z_im
            }
            let reference: PackedReference = orbit.load(index: base + reference_i)
            let next_reference: PackedReference = orbit.load(index: base + reference_i + 1)
            if invalid_reference(reference) || invalid_reference(next_reference) {
                glitched = 1
            } else {
                let ref_re_w0: f32 = __bitcast(reference.re_w0_bits)
                let ref_re_w1: f32 = __bitcast(reference.re_w1_bits)
                let ref_re_w2: f32 = __bitcast(reference.re_w2_bits)
                let ref_re_w3: f32 = __bitcast(reference.re_w3_bits)
                let ref_im_w0: f32 = __bitcast(reference.im_w0_bits)
                let ref_im_w1: f32 = __bitcast(reference.im_w1_bits)
                let ref_im_w2: f32 = __bitcast(reference.im_w2_bits)
                let ref_im_w3: f32 = __bitcast(reference.im_w3_bits)
                let next_ref_re_w0: f32 = __bitcast(next_reference.re_w0_bits)
                let next_ref_re_w1: f32 = __bitcast(next_reference.re_w1_bits)
                let next_ref_re_w2: f32 = __bitcast(next_reference.re_w2_bits)
                let next_ref_re_w3: f32 = __bitcast(next_reference.re_w3_bits)
                let next_ref_im_w0: f32 = __bitcast(next_reference.im_w0_bits)
                let next_ref_im_w1: f32 = __bitcast(next_reference.im_w1_bits)
                let next_ref_im_w2: f32 = __bitcast(next_reference.im_w2_bits)
                let next_ref_im_w3: f32 = __bitcast(next_reference.im_w3_bits)
                let linear_re_w0: f32 = ref_re_w0 * dz_re - ref_im_w0 * dz_im
                let linear_re_tail: f32 = ref_re_w1 * dz_re - ref_im_w1 * dz_im
                    + ref_re_w2 * dz_re - ref_im_w2 * dz_im
                    + ref_re_w3 * dz_re - ref_im_w3 * dz_im
                let linear_im_w0: f32 = ref_re_w0 * dz_im + ref_im_w0 * dz_re
                let linear_im_tail: f32 = ref_re_w1 * dz_im
                    + ref_im_w1 * dz_re
                    + ref_re_w2 * dz_im
                    + ref_im_w2 * dz_re
                    + ref_re_w3 * dz_im
                    + ref_im_w3 * dz_re
                let next_dz_re: f32 = 2.0 * linear_re_w0
                    + 2.0 * linear_re_tail
                    + (dz_re * dz_re - dz_im * dz_im)
                    + dc_re
                let next_dz_im: f32 = 2.0 * linear_im_w0
                    + 2.0 * linear_im_tail
                    + 2.0 * dz_re * dz_im
                    + dc_im
                let target_re: f32 = reference_plus_delta(
                    next_ref_re_w0,
                    next_ref_re_w1,
                    next_ref_re_w2,
                    next_ref_re_w3,
                    next_dz_re,
                )
                let target_im: f32 = reference_plus_delta(
                    next_ref_im_w0,
                    next_ref_im_w1,
                    next_ref_im_w2,
                    next_ref_im_w3,
                    next_dz_im,
                )
                let magnitude: f32 = target_re * target_re + target_im * target_im
                let delta_magnitude: f32 = next_dz_re * next_dz_re + next_dz_im * next_dz_im
                // Rebase whenever the absolute orbit is smaller than its
                // current perturbation. This keeps the next delta small
                // and is the useful cancellation condition, rather than
                // waiting for a five-order-of-magnitude collapse.
                let cancellation: bool = magnitude < delta_magnitude
                let ambiguous_escape: bool = magnitude > 4.0
                    && abs(magnitude - 4.0) <= 0.000004 * max(1.0, magnitude)

                if non_finite(next_dz_re)
                    || non_finite(next_dz_im)
                    || non_finite(magnitude)
                    || ambiguous_escape {
                    glitched = 1
                } else {
                    dz_re = next_dz_re
                    dz_im = next_dz_im
                    z_re = target_re
                    z_im = target_im
                    if magnitude > 4.0 {
                        escaped = 1
                        escape_magnitude = magnitude
                    } else {
                        if cancellation {
                            reference_i = 0
                            dz_re = z_re
                            dz_im = z_im
                        } else {
                            reference_i = reference_i + 1
                        }
                    }
                }
            }
        }
        i = i + 1
        steps = steps + 1
    }

    OrbitProgress {
        dz_re: dz_re,
        dz_im: dz_im,
        z_re: z_re,
        z_im: z_im,
        reference_i: reference_i | (escaped << 31) | (glitched << 30),
        iteration: i,
        epoch: saved.epoch,
        magnitude: escape_magnitude,
    }
}

pub fn progress_color(_ saved: OrbitProgress) -> i32 {
    if saved.is_glitched() {
        glitch()
    } else {
        if saved.is_escaped() {
            escape_palette(saved.iteration.downcast_truncate(), saved.magnitude)
        } else {
            interior()
        }
    }
}

pub fn continue_pixel(
    _ orbit: OrbitBuffer<PackedReference, ORBIT_CAPACITY>,
    _ base: u32,
    _ camera: Camera,
    _ sample: PixelSample,
    _ budget: u32,
    _ steps: u32,
    _ saved: OrbitProgress,
) -> OrbitProgress {
    let (dc_re, dc_im) = pixel_delta_from_reference(orbit, base, camera, sample)
    advance_progress(orbit, base, dc_re, dc_im, budget, steps, saved)
}
