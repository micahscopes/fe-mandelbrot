//! Perturbation arithmetic and resumable pixel checkpoints.
//! Escape and cancellation rules are shared by preview, refinement and AA.
use core::default::Default
use core::marker::Copy
use core::ops::{Add, Eq, Sub}
use std::webgpu::StorageBuffer
pub use algebra::Complex
use fmath::{abs, max, PixelSample}
use ingot::cache::{ReferenceAnchor, ReferenceControl, SampleOracle}
use ingot::palette::{escape_palette, interior, glitch}
use ingot::policy::Camera
use precision::{Expansion, from_quad, to_quad, two_sum}
use precision::array_fixed::ArrayFixed

extern {
    const fn __bitcast<From, To>(_: From) -> To
}

pub const ORBIT_SAMPLES: usize = 8195
// Eight suffix records hold the immutable packed blue-noise ordering.
pub const ORBIT_CAPACITY: usize = 16398
pub const ORBIT_CENTER_INDEX: u32 = 8193
pub const ORBIT_META_INDEX: u32 = 8194
pub const INVALID_REFERENCE: u32 = 2143289344

pub const PROGRESS_REF_MASK: u32 = 536870911
pub const PROGRESS_PRESENTABLE_BIT: u32 = 536870912
pub const PROGRESS_GLITCHED_BIT: u32 = 1073741824
pub const PROGRESS_ESCAPED_BIT: u32 = 2147483648
pub const PROGRESS_OUTCOME_MASK: u32 = 3221225472

pub fn progress_reference_index(_ reference_i: u32) -> u32 {
    reference_i & PROGRESS_REF_MASK
}

pub fn progress_is_presentable(_ reference_i: u32) -> bool {
    (reference_i & PROGRESS_PRESENTABLE_BIT) != 0
}

pub fn progress_is_glitched(_ reference_i: u32) -> bool {
    (reference_i & PROGRESS_GLITCHED_BIT) != 0
}

pub fn progress_is_escaped(_ reference_i: u32) -> bool {
    (reference_i & PROGRESS_ESCAPED_BIT) != 0
}

pub fn progress_has_outcome(_ reference_i: u32) -> bool {
    (reference_i & PROGRESS_OUTCOME_MASK) != 0
}

pub fn progress_is_terminal(_ reference_i: u32, _ iteration: u32, _ limit: u32) -> bool {
    iteration >= limit || progress_has_outcome(reference_i) || progress_is_presentable(reference_i)
}

pub fn progress_outcome_flags(_ reference_i: u32) -> u32 {
    reference_i & PROGRESS_OUTCOME_MASK
}

pub fn progress_with_presentable(_ reference_i: u32) -> u32 {
    reference_i | PROGRESS_PRESENTABLE_BIT
}

pub fn pack_progress_reference(_ reference_i: u32, _ escaped: u32, _ glitched: u32) -> u32 {
    (reference_i & PROGRESS_REF_MASK) | (escaped << 31) | (glitched << 30)
}

pub fn is_non_finite_complex(_ value: Complex<f32>) -> bool {
    non_finite(value.re) || non_finite(value.im)
}

/// Exact 91-fractional-bit reference value, interpreted by bounded array loops.
/// Sign and limb serialization remain explicit at the existing buffer boundary.
pub struct ReferenceReal { value: ArrayFixed<8> }

impl Copy for ReferenceReal {}

impl Default for ReferenceReal {
    fn default() -> Self { Self::zero() }
}

impl ReferenceReal {
    pub fn zero() -> Self { Self { value: ArrayFixed<8>::zero() } }

    pub fn from_quad(_ w0: f32, _ w1: f32, _ w2: f32, _ w3: f32) -> Self {
        Self::from_expansion(precision::from_quad(w0, w1, w2, w3))
    }

    pub fn from_expansion(_ value: Expansion<4>) -> Self {
        Self { value: ArrayFixed<8>::from_expansion(value) }
    }

    pub fn from_words(_ sign: u32, _ words: [u32; 8]) -> Self {
        assert(sign <= 1)
        Self { value: ArrayFixed<8>::from_digits(sign == 1, words) }
    }

    pub fn assign_quad(mut self, _ w0: f32, _ w1: f32, _ w2: f32, _ w3: f32) {
        self.value.assign_quad(w0, w1, w2, w3)
    }
    pub fn assign_copy(mut self, _ other: Self) { self.value.assign_copy(other.value) }
    pub fn assign_sum(mut self, _ left: Self, _ right: Self) {
        self.value.assign_sum(left.value, right.value)
    }
    pub fn assign_difference(mut self, _ left: Self, _ right: Self) {
        let mut negated: ArrayFixed<8> = ArrayFixed<8>::zero()
        negated.assign_negated(right.value)
        self.value.assign_sum(left.value, negated)
    }
    pub fn assign_product(mut self, _ left: Self, _ right: Self) {
        self.value.assign_product(left.value, right.value)
    }
    pub fn digit(self, _ index: u32) -> u32 { self.value.digit(index) }

    pub fn sign(self) -> u32 { self.value.sign() }
    pub fn to_words(self) -> [u32; 8] { self.value.to_digits() }
    pub fn to_quad_bits(self) -> (u32, u32, u32, u32) { self.value.to_quad_bits() }
    pub fn square(self) -> Self { self.multiply(self) }
    pub fn multiply(self, _ other: Self) -> Self { Self { value: self.value * other.value } }
    pub fn escaped(self) -> bool { self.value.magnitude_exceeds_four() }
}

impl Add for ReferenceReal {
    fn add(own self, _ other: own Self) -> Self { Self { value: self.value + other.value } }
}

impl Sub for ReferenceReal {
    fn sub(own self, _ other: own Self) -> Self { Self { value: self.value - other.value } }
}

pub struct ReferenceStep { pub value: Complex<ReferenceReal>, pub escaped: bool }

impl Copy for ReferenceStep {}

/// Advance one exact `Complex<ReferenceReal>` orbit sample by `z^2 + center`
/// in place. Returns true, leaving `z` unchanged, when `|z|^2 > 4`.
/// Device code uses this form: see the device note in precision::array_fixed.
pub fn reference_step_in_place(
    _ z: mut Complex<ReferenceReal>,
    _ center: Complex<ReferenceReal>,
) -> bool {
    let mut xx: ReferenceReal = ReferenceReal::zero()
    xx.assign_product(z.re, z.re)
    let mut yy: ReferenceReal = ReferenceReal::zero()
    yy.assign_product(z.im, z.im)
    let mut radius: ReferenceReal = ReferenceReal::zero()
    radius.assign_sum(xx, yy)
    if radius.escaped() {
        true
    } else {
        let mut xy: ReferenceReal = ReferenceReal::zero()
        xy.assign_product(z.re, z.im)
        let mut difference: ReferenceReal = ReferenceReal::zero()
        difference.assign_difference(xx, yy)
        let mut real: ReferenceReal = ReferenceReal::zero()
        real.assign_sum(difference, center.re)
        let mut twice: ReferenceReal = ReferenceReal::zero()
        twice.assign_sum(xy, xy)
        let mut imag: ReferenceReal = ReferenceReal::zero()
        imag.assign_sum(twice, center.im)
        z.re.assign_copy(real)
        z.im.assign_copy(imag)
        false
    }
}

/// Value form of `reference_step_in_place`, for host-side use and tests.
pub fn reference_step(
    _ z: Complex<ReferenceReal>,
    _ center: Complex<ReferenceReal>,
) -> ReferenceStep {
    let mut next: Complex<ReferenceReal> = z
    let escaped: bool = reference_step_in_place(mut next, center)
    ReferenceStep { value: next, escaped: escaped }
}

pub fn assign_reference_center(_ center: mut Complex<ReferenceReal>, _ anchor: ReferenceAnchor) {
    let (rx0, rx1, rx2, rx3) = to_quad(anchor.center.re)
    let (iy0, iy1, iy2, iy3) = to_quad(anchor.center.im)
    center.re.assign_quad(rx0, rx1, rx2, rx3)
    center.im.assign_quad(iy0, iy1, iy2, iy3)
}

pub fn reference_center(_ anchor: ReferenceAnchor) -> Complex<ReferenceReal> {
    let mut center: Complex<ReferenceReal> = Complex::default()
    assign_reference_center(mut center, anchor)
    center
}

pub fn clear_reference_checkpoint(_ words: StorageBuffer<u32, 16>) {
    let mut slot: u32 = 0
    while slot < 16 {
        words.store(index: slot, value: 0)
        slot = slot + 1
    }
}

pub fn load_reference_checkpoint_into(
    _ z: mut Complex<ReferenceReal>,
    _ words: StorageBuffer<u32, 16>,
    _ control: ReferenceControl,
) {
    // Literal arrays, no loop: see the device note in precision::array_fixed.
    let re_words: [u32; 8] = [
        words.load(index: 0), words.load(index: 1), words.load(index: 2), words.load(index: 3),
        words.load(index: 4), words.load(index: 5), words.load(index: 6), words.load(index: 7),
    ]
    let im_words: [u32; 8] = [
        words.load(index: 8), words.load(index: 9), words.load(index: 10), words.load(index: 11),
        words.load(index: 12), words.load(index: 13), words.load(index: 14), words.load(index: 15),
    ]
    z.re = ReferenceReal::from_words(control.zx_s, re_words)
    z.im = ReferenceReal::from_words(control.zy_s, im_words)
}

pub fn load_reference_checkpoint(
    _ words: StorageBuffer<u32, 16>,
    _ control: ReferenceControl,
) -> Complex<ReferenceReal> {
    let mut z: Complex<ReferenceReal> = Complex::default()
    load_reference_checkpoint_into(mut z, words, control)
    z
}

pub fn store_reference_checkpoint(_ words: StorageBuffer<u32, 16>, _ z: Complex<ReferenceReal>) {
    let mut i: u32 = 0
    while i < 8 {
        words.store(index: i, value: z.re.digit(i))
        words.store(index: i + 8, value: z.im.digit(i))
        i = i + 1
    }
}

pub struct ReferenceMetadata { pub valid_samples: u32, pub limit: u32 }

impl Copy for ReferenceMetadata {}

#[derive(Default)]
pub struct PackedReference {
    pub re_w0_bits: u32,
    pub re_w1_bits: u32,
    pub re_w2_bits: u32,
    pub re_w3_bits: u32,
    pub im_w0_bits: u32,
    pub im_w1_bits: u32,
    pub im_w2_bits: u32,
    pub im_w3_bits: u32,
}

impl Copy for PackedReference {}

impl PackedReference {
    pub fn zero() -> Self {
        Self::default()
    }
    pub fn from_words(
        _ rx0: u32,
        _ rx1: u32,
        _ rx2: u32,
        _ rx3: u32,
        _ iy0: u32,
        _ iy1: u32,
        _ iy2: u32,
        _ iy3: u32,
    ) -> Self {
        PackedReference {
            re_w0_bits: rx0,
            re_w1_bits: rx1,
            re_w2_bits: rx2,
            re_w3_bits: rx3,
            im_w0_bits: iy0,
            im_w1_bits: iy1,
            im_w2_bits: iy2,
            im_w3_bits: iy3,
        }
    }
    pub fn from_fixed(_ value: Complex<ReferenceReal>) -> Self {
        let (rx0, rx1, rx2, rx3) = value.re.to_quad_bits()
        let (iy0, iy1, iy2, iy3) = value.im.to_quad_bits()
        Self::from_words(rx0, rx1, rx2, rx3, iy0, iy1, iy2, iy3)
    }
    pub fn from_metadata(_ valid_samples: u32, _ limit: u32) -> Self {
        let mut packed: Self = Self::default()
        packed.re_w0_bits = valid_samples
        packed.re_w1_bits = limit
        packed
    }
    pub fn decode_metadata(self) -> ReferenceMetadata {
        ReferenceMetadata { valid_samples: self.re_w0_bits, limit: self.re_w1_bits }
    }
    /// The reference header's spare words carry this frame's camera delta.
    /// The valid-count and limit words retain their existing ABI positions.
    pub fn with_center_offset(self, _ offset: Complex<f32>) -> Self {
        let mut next = self
        next.re_w2_bits = __bitcast<f32, u32>(offset.re)
        next.re_w3_bits = __bitcast<f32, u32>(offset.im)
        next
    }
    pub fn center_offset(self) -> Complex<f32> {
        Complex { re: __bitcast(self.re_w2_bits), im: __bitcast(self.re_w3_bits) }
    }
    pub fn is_invalid(self) -> bool {
        self.re_w0_bits == INVALID_REFERENCE || self.im_w0_bits == INVALID_REFERENCE
    }
    pub fn decode(self) -> Complex<Expansion<4>> {
        Complex {
            re: from_quad(
                __bitcast(self.re_w0_bits),
                __bitcast(self.re_w1_bits),
                __bitcast(self.re_w2_bits),
                __bitcast(self.re_w3_bits),
            ),
            im: from_quad(
                __bitcast(self.im_w0_bits),
                __bitcast(self.im_w1_bits),
                __bitcast(self.im_w2_bits),
                __bitcast(self.im_w3_bits),
            ),
        }
    }
    pub fn word(self, _ slot: u32) -> u32 {
        match slot & 7 {
            0 => self.re_w0_bits,
            1 => self.re_w1_bits,
            2 => self.re_w2_bits,
            3 => self.re_w3_bits,
            4 => self.im_w0_bits,
            5 => self.im_w1_bits,
            6 => self.im_w2_bits,
            _ => self.im_w3_bits,
        }
    }
}

pub fn offset_sample(_ px: i32, _ py: i32, _ ox: f32, _ oy: f32) -> PixelSample {
    let base: PixelSample = PixelSample::ordered_2x2(px, py)
    PixelSample { x: base.x + ox, y: base.y + oy }
}

fn non_finite(_ value: f32) -> bool {
    value - value != 0.0
}

/// Collapse an exact four-word reference plus the pixel delta without losing
/// the reference tail when `w0` and `delta` nearly cancel. The ordinary
/// `w0 + w1 + w2 + w3 + delta` ordering discards every low word before the
/// cancellation happens, which poisons both bailout and center reanchoring.
fn reference_plus_delta(_ w0: f32, _ w1: f32, _ w2: f32, _ w3: f32, _ delta: f32) -> f32 {
    let (s0, e0) = two_sum(w0, delta)
    let (s1, e1) = two_sum(s0, w1)
    let (s2, e2) = two_sum(s1, w2)
    let (s3, e3) = two_sum(s2, w3)
    s3 + (((e3 + e2) + e1) + e0)
}

pub fn expansion_plus_delta(_ reference: Expansion<4>, _ delta: f32) -> f32 {
    let (w0, w1, w2, w3) = to_quad(reference)
    reference_plus_delta(w0, w1, w2, w3, delta)
}

pub fn reference_with_delta(_ reference: Complex<Expansion<4>>, _ delta: Complex<f32>) -> Complex<
    f32,
> {
    Complex {
        re: expansion_plus_delta(reference.re, delta.re),
        im: expansion_plus_delta(reference.im, delta.im),
    }
}

/// Advance the single-precision orbit perturbation `delta` around `reference`
/// by `2 * reference * delta + delta^2 + dc`, preserving the exact ordered
/// head/tail association across the four-word reference expansion.
pub fn perturb(
    _ reference: Complex<Expansion<4>>,
    _ delta: Complex<f32>,
    _ dc: Complex<f32>,
) -> Complex<f32> {
    let (r0, r1, r2, r3) = to_quad(reference.re)
    let (i0, i1, i2, i3) = to_quad(reference.im)
    let linear_re_w0: f32 = r0 * delta.re - i0 * delta.im
    let re_tail_12: f32 = r1 * delta.re - i1 * delta.im + r2 * delta.re - i2 * delta.im
    let linear_re_tail: f32 = re_tail_12 + r3 * delta.re - i3 * delta.im
    let linear_im_w0: f32 = r0 * delta.im + i0 * delta.re
    let im_tail_12: f32 = r1 * delta.im + i1 * delta.re + r2 * delta.im + i2 * delta.re
    let linear_im_tail: f32 = im_tail_12 + r3 * delta.im + i3 * delta.re
    Complex {
        re: 2.0 * linear_re_w0
            + 2.0 * linear_re_tail
            + (delta.re * delta.re - delta.im * delta.im)
            + dc.re,
        im: 2.0 * linear_im_w0 + 2.0 * linear_im_tail + 2.0 * delta.re * delta.im + dc.im,
    }
}

/// Compute the initial complex perturbation `dc` for a sample relative to the
/// active reference center stored at `base + ORBIT_CENTER_INDEX`.
pub fn pixel_delta_from_reference(
    _ orbit: StorageBuffer<PackedReference, ORBIT_CAPACITY>,
    _ base: u32,
    _ camera: Camera,
    _ sample: PixelSample,
) -> Complex<f32> {
    let point = sample.plane(camera.res)
    let offset = orbit.load(index: base + ORBIT_META_INDEX).center_offset()
    let plane_offset = camera.plane_offset(Complex { re: point.u, im: point.v })
    offset + plane_offset
}

/// A uniform iteration budget computed once by the reference pass. The pixel
/// pass reads the result from orbit metadata and does no depth probing.
pub fn sample_pixel(
    _ orbit: StorageBuffer<PackedReference, ORBIT_CAPACITY>,
    _ base: u32,
    _ camera: Camera,
    _ sample: PixelSample,
    _ budget: u32,
) -> u32 {
    progress_color(sample_progress(orbit, base, camera, sample, budget))
}

pub fn sample_progress(
    _ orbit: StorageBuffer<PackedReference, ORBIT_CAPACITY>,
    _ base: u32,
    _ camera: Camera,
    _ sample: PixelSample,
    _ budget: u32,
) -> OrbitProgress {
    // The same one-orbit ordered refinement as the exact renderer. This is
    // deliberately not naive 4x supersampling: escaped samples terminate
    // early, and unfinished native samples resume from GPU checkpoints.
    let dc: Complex<f32> = pixel_delta_from_reference(orbit, base, camera, sample)
    let metadata: ReferenceMetadata = orbit.load(index: base + ORBIT_META_INDEX).decode_metadata()
    let max_iter: u32 = if budget < metadata.limit {
        budget
    } else {
        metadata.limit
    }
    advance_progress(orbit, base, dc, max_iter, max_iter, empty_progress(0))
}

pub struct OrbitProgress {
    pub dz_re: f32,
    pub dz_im: f32,
    pub z_re: f32,
    pub z_im: f32,
    pub reference_i: u32,
    pub iteration: u32,
    pub epoch: u32,
    pub magnitude: f32,
}

impl Copy for OrbitProgress {}

impl OrbitProgress {
    pub fn delta(self) -> Complex<f32> {
        Complex { re: self.dz_re, im: self.dz_im }
    }
    pub fn position(self) -> Complex<f32> {
        Complex { re: self.z_re, im: self.z_im }
    }
    pub fn from_continuation(
        _ delta: Complex<f32>,
        _ position: Complex<f32>,
        _ reference_i: u32,
        _ iteration: u32,
        _ epoch: u32,
        _ magnitude: f32,
    ) -> Self {
        OrbitProgress {
            dz_re: delta.re,
            dz_im: delta.im,
            z_re: position.re,
            z_im: position.im,
            reference_i: reference_i,
            iteration: iteration,
            epoch: epoch,
            magnitude: magnitude,
        }
    }
    pub fn reference_index(self) -> u32 {
        progress_reference_index(self.reference_i)
    }
    pub fn is_presentable(self) -> bool {
        progress_is_presentable(self.reference_i)
    }
    pub fn is_presentable_in(self, _ epoch: u32) -> bool {
        self.epoch == epoch && self.is_presentable()
    }
    pub fn is_glitched(self) -> bool {
        progress_is_glitched(self.reference_i)
    }
    pub fn is_escaped(self) -> bool {
        progress_is_escaped(self.reference_i)
    }
    pub fn has_outcome(self) -> bool {
        progress_has_outcome(self.reference_i)
    }
    pub fn is_terminal(self, _ limit: u32) -> bool {
        progress_is_terminal(self.reference_i, self.iteration, limit)
    }
    pub fn outcome_flags(self) -> u32 {
        progress_outcome_flags(self.reference_i)
    }

    /// While non-terminal, `z_re` holds the live real coordinate for rebasing;
    /// once presentable, `z_re` holds the timestamp at which the pixel's fade started.
    pub fn fade_started_at(self) -> f32 {
        self.z_re
    }
    pub fn with_fade_start(self, _ clock: f32) -> Self {
        let mut next: Self = self
        next.z_re = clock
        next.reference_i = progress_with_presentable(self.reference_i)
        next
    }
    pub fn to_oracle(self) -> SampleOracle {
        SampleOracle {
            iteration: self.iteration,
            magnitude: self.magnitude,
            flags: self.outcome_flags(),
        }
    }
    pub fn from_oracle(_ oracle: SampleOracle, _ epoch: u32, _ clock: f32) -> Self {
        OrbitProgress::from_continuation(
            Complex::default(),
            Complex::default(),
            oracle.flags,
            oracle.iteration,
            epoch,
            oracle.magnitude,
        )
            .with_fade_start(clock)
    }
}

pub fn empty_progress(_ epoch: u32) -> OrbitProgress {
    OrbitProgress::from_continuation(Complex::default(), Complex::default(), 0, 0, epoch, 4.0)
}

fn advance_progress(
    _ orbit: StorageBuffer<PackedReference, ORBIT_CAPACITY>,
    _ base: u32,
    _ dc: Complex<f32>,
    _ max_iter: u32,
    _ batch: u32,
    _ saved: OrbitProgress,
) -> OrbitProgress {
    if saved.is_presentable() {
        saved
    } else {
        let valid_samples: u32 = orbit
            .load(index: base + ORBIT_META_INDEX)
            .decode_metadata()
            .valid_samples
        let mut delta: Complex<f32> = saved.delta()
        let mut z: Complex<f32> = saved.position()
        let mut reference_i: u32 = saved.reference_index()
        let mut escaped: u32 = if saved.is_escaped() { 1 } else { 0 }
        let mut glitched: u32 = if saved.is_glitched() { 1 } else { 0 }
        let mut escape_magnitude: f32 = saved.magnitude
        let mut i: u32 = saved.iteration
        let mut steps: u32 = 0
        while i < max_iter && steps < batch && escaped == 0 && glitched == 0 {
            if reference_i + 1 >= valid_samples {
                reference_i = 0
                delta = z
            }
            let packed_reference: PackedReference = orbit.load(index: base + reference_i)
            let packed_next: PackedReference = orbit.load(index: base + reference_i + 1)
            if packed_reference.is_invalid() || packed_next.is_invalid() {
                glitched = 1
            } else {
                let reference: Complex<Expansion<4>> = packed_reference.decode()
                let next_reference: Complex<Expansion<4>> = packed_next.decode()
                let next_delta: Complex<f32> = perturb(reference, delta, dc)
                let target: Complex<f32> = reference_with_delta(next_reference, next_delta)
                let magnitude: f32 = target.norm_squared()
                let delta_magnitude: f32 = next_delta.norm_squared()
                // Rebase whenever the absolute orbit is smaller than its
                // current perturbation. This keeps the next delta small
                // and is the useful cancellation condition, rather than
                // waiting for a five-order-of-magnitude collapse.
                let cancellation: bool = magnitude < delta_magnitude
                let ambiguous_escape: bool = magnitude > 4.0
                    && abs(magnitude - 4.0) <= 0.000004 * max(1.0, magnitude)

                if is_non_finite_complex(next_delta) || non_finite(magnitude) || ambiguous_escape {
                    glitched = 1
                } else {
                    delta = next_delta
                    z = target
                    if magnitude > 4.0 {
                        escaped = 1
                        escape_magnitude = magnitude
                    } else if cancellation {
                        reference_i = 0
                        delta = z
                    } else {
                        reference_i = reference_i + 1
                    }
                }
            }
            i = i + 1
            steps = steps + 1
        }

        OrbitProgress::from_continuation(
            delta,
            z,
            pack_progress_reference(reference_i, escaped, glitched),
            i,
            saved.epoch,
            escape_magnitude,
        )
    }
}

#[derive(Eq, Default)]
pub struct PrefixIndices { pub active: bool, pub rebases: bool, pub reference_i: u32 }

impl Copy for PrefixIndices {}

pub fn resolve_prefix_step(
    _ reference_i: u32,
    _ iteration: u32,
    _ max_iter: u32,
    _ valid_samples: u32,
    _ prefix_only: bool,
) -> PrefixIndices {
    let prefix_limit: u32 = if valid_samples > 0 {
        valid_samples - 1
    } else {
        0
    }
    let step_limit: u32 = if prefix_only && prefix_limit < max_iter {
        prefix_limit
    } else {
        max_iter
    }
    let idx: u32 = progress_reference_index(reference_i)
    if progress_is_terminal(reference_i, iteration, step_limit) {
        PrefixIndices { active: false, rebases: false, reference_i: idx }
    } else if idx + 1 >= valid_samples {
        if prefix_only || valid_samples < 2 {
            PrefixIndices { active: false, rebases: false, reference_i: idx }
        } else {
            PrefixIndices { active: true, rebases: true, reference_i: 0 }
        }
    } else {
        PrefixIndices { active: true, rebases: false, reference_i: idx }
    }
}

pub struct PrefixStep { pub active: bool, pub progress: OrbitProgress }

impl Copy for PrefixStep {}

/// Check whether `saved` can advance another step within `max_iter` and the
/// valid reference sample count `valid_samples`. When `prefix_only` is true,
/// reaching the end of the currently built reference prefix stops without
/// rebasing or reading unwritten suffix entries; when `prefix_only` is false,
/// reaching the end of an escaped reference orbit rebases `delta = z` at `0`.
pub fn prepare_reference_step(
    _ saved: OrbitProgress,
    _ max_iter: u32,
    _ valid_samples: u32,
    _ prefix_only: bool,
) -> PrefixStep {
    let resolved: PrefixIndices = resolve_prefix_step(
        saved.reference_i,
        saved.iteration,
        max_iter,
        valid_samples,
        prefix_only,
    )
    if !resolved.active {
        PrefixStep { active: false, progress: saved }
    } else if resolved.rebases {
        let z: Complex<f32> = saved.position()
        PrefixStep {
            active: true,
            progress: OrbitProgress::from_continuation(
                z,
                z,
                0,
                saved.iteration,
                saved.epoch,
                saved.magnitude,
            ),
        }
    } else {
        PrefixStep { active: true, progress: saved }
    }
}

/// Advance one prepared `OrbitProgress` state by one perturbation step around
/// `(packed_reference, packed_next)` with initial pixel delta `dc`.
pub fn advance_progress_step(
    _ saved: OrbitProgress,
    _ dc: Complex<f32>,
    _ packed_reference: PackedReference,
    _ packed_next: PackedReference,
) -> OrbitProgress {
    let mut delta: Complex<f32> = saved.delta()
    let mut z: Complex<f32> = saved.position()
    let mut reference_i: u32 = saved.reference_index()
    let mut escaped: u32 = if saved.is_escaped() { 1 } else { 0 }
    let mut glitched: u32 = if saved.is_glitched() { 1 } else { 0 }
    let mut escape_magnitude: f32 = saved.magnitude
    if packed_reference.is_invalid() || packed_next.is_invalid() {
        glitched = 1
    } else {
        let reference: Complex<Expansion<4>> = packed_reference.decode()
        let next_reference: Complex<Expansion<4>> = packed_next.decode()
        let next_delta: Complex<f32> = perturb(reference, delta, dc)
        let target: Complex<f32> = reference_with_delta(next_reference, next_delta)
        let magnitude: f32 = target.norm_squared()
        let delta_magnitude: f32 = next_delta.norm_squared()
        let cancellation: bool = magnitude < delta_magnitude
        let ambiguous_escape: bool = magnitude > 4.0
            && abs(magnitude - 4.0) <= 0.000004 * max(1.0, magnitude)

        if is_non_finite_complex(next_delta) || non_finite(magnitude) || ambiguous_escape {
            glitched = 1
        } else {
            delta = next_delta
            z = target
            if magnitude > 4.0 {
                escaped = 1
                escape_magnitude = magnitude
            } else if cancellation {
                reference_i = 0
                delta = z
            } else {
                reference_i = reference_i + 1
            }
        }
    }
    OrbitProgress::from_continuation(
        delta,
        z,
        pack_progress_reference(reference_i, escaped, glitched),
        saved.iteration + 1,
        saved.epoch,
        escape_magnitude,
    )
}

fn advance_preview_progress(
    _ orbit: StorageBuffer<PackedReference, ORBIT_CAPACITY>,
    _ base: u32,
    _ dc: Complex<f32>,
    _ max_iter: u32,
    _ batch: u32,
    _ prefix_only: bool,
    _ saved: OrbitProgress,
) -> OrbitProgress {
    let valid_samples: u32 = orbit
        .load(index: base + ORBIT_META_INDEX)
        .decode_metadata()
        .valid_samples
    let mut current: OrbitProgress = saved
    let mut steps: u32 = 0
    while steps < batch {
        let prepared: PrefixStep = prepare_reference_step(
            current,
            max_iter,
            valid_samples,
            prefix_only,
        )
        if !prepared.active {
            steps = batch
        } else {
            let state: OrbitProgress = prepared.progress
            let ref_i: u32 = state.reference_index()
            let packed_reference: PackedReference = orbit.load(index: base + ref_i)
            let packed_next: PackedReference = orbit.load(index: base + ref_i + 1)
            current = advance_progress_step(state, dc, packed_reference, packed_next)
            steps = steps + 1
        }
    }
    current
}

pub fn progress_color(_ saved: OrbitProgress) -> u32 {
    if saved.is_glitched() {
        glitch()
    } else if saved.is_escaped() {
        escape_palette(saved.iteration, saved.magnitude)
    } else {
        interior()
    }
}

pub fn continue_pixel(
    _ orbit: StorageBuffer<PackedReference, ORBIT_CAPACITY>,
    _ base: u32,
    _ camera: Camera,
    _ sample: PixelSample,
    _ budget: u32,
    _ steps: u32,
    _ saved: OrbitProgress,
) -> OrbitProgress {
    let dc: Complex<f32> = pixel_delta_from_reference(orbit, base, camera, sample)
    advance_progress(orbit, base, dc, budget, steps, saved)
}

pub fn continue_preview_pixel(
    _ orbit: StorageBuffer<PackedReference, ORBIT_CAPACITY>,
    _ base: u32,
    _ camera: Camera,
    _ sample: PixelSample,
    _ max_iter: u32,
    _ steps: u32,
    _ prefix_only: bool,
    _ saved: OrbitProgress,
) -> OrbitProgress {
    let dc: Complex<f32> = pixel_delta_from_reference(orbit, base, camera, sample)
    advance_preview_progress(orbit, base, dc, max_iter, steps, prefix_only, saved)
}
