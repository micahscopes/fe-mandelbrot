//! Raw contacts become whole camera transformations in Fe.
//! Membership and viewport changes reanchor without terminal motion.
use core::marker::Copy
use core::ops::Eq
use algebra::Vec2
use gestures::{Contacts, Gesture, Viewport}
use std::web::SurfaceContactEvent
use ingot::policy::{Camera, MandelbrotViewState, initial_camera}

/// The explorer uses two contacts; the shared recognizer supports any capacity.
pub struct GestureSession {
    pub contacts: Contacts<2>,
    /// The last observed CSS frame. Its initial zero extent is unmeasured;
    /// it never participates in a normalization or camera transformation.
    pub viewport: Viewport,
    pub baseline_contacts: Contacts<2>,
    pub baseline_camera: Camera,
}

impl Copy for GestureSession {}

impl GestureSession {
    pub fn reanchor(self, _ camera: Camera) -> Self {
        let mut next = self
        next.baseline_contacts = self.contacts
        next.baseline_camera = camera
        next
    }
    pub const fn empty() -> Self {
        let zero = Vec2 { x: 0.0, y: 0.0 }
        Self {
            contacts: Contacts::empty(), viewport: Viewport { origin: zero, extent: zero },
            baseline_contacts: Contacts::empty(), baseline_camera: initial_camera(),
        }
    }
}

pub fn contact_transition(_ state: MandelbrotViewState, _ event: own SurfaceContactEvent) -> MandelbrotViewState {
    let mut next = state
    let sample = event.sample
    let frame = Viewport {
        origin: Vec2 { x: event.bounds.left, y: event.bounds.top },
        extent: Vec2 { x: event.bounds.width, y: event.bounds.height },
    }
    let same_frame = next.gesture.viewport == frame
    let measurable = frame.extent.x > 0.0 && frame.extent.y > 0.0
    let update = if measurable {
        next.gesture.contacts.update_from(next.gesture.baseline_contacts, sample, frame)
    } else {
        next.gesture.contacts.update(sample)
    }
    next.gesture.contacts = update.contacts
    match update.gesture {
        Gesture::Ignored => next,
        gesture => {
            next.gesture.viewport = frame
            next.clock = sample.timestamp
            next.last_input = sample.timestamp
            next.drag_active = if next.gesture.contacts.count() > 0 { 1.0 } else { 0.0 }
            match gesture {
                Gesture::Motion(motion) => {
                    // A resized or hidden frame must first establish a new
                    // anchor. Contact cleanup remains independent of bounds.
                    if same_frame && frame.extent.x > 0.0 && frame.extent.y > 0.0 {
                        next = next.with_camera(next.gesture.baseline_camera.follow(motion, frame))
                    } else {
                        next.gesture.baseline_contacts = next.gesture.contacts
                        next.gesture.baseline_camera = next.camera
                    }
                },
                _ => {
                    next.gesture.baseline_contacts = next.gesture.contacts
                    next.gesture.baseline_camera = next.camera
                },
            }
            next.refresh_readout()
        },
    }
}
