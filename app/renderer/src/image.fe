//! Color buffers, interpolation and a dense separable Gaussian filter.
use core::marker::Copy
use std::webgpu::StorageBuffer as OrbitBuffer
use fmath::{abs, floor, from_i32, to_i32}

extern {
    const fn __bitcast<From, To>(_: From) -> To
}

// Color/coordinate operands here are finite by construction. Keep their
// ordinary comparisons in Fe instead of the general IEEE total-order helpers.
// clamp still propagates NaNs to the existing saturating conversion boundary.
pub fn min(_ a: f32, _ b: f32) -> f32 {
    if a < b { a } else { b }
}

pub fn max(_ a: f32, _ b: f32) -> f32 {
    if a > b { a } else { b }
}

fn clamp(_ value: f32, _ low: f32, _ high: f32) -> f32 {
    if value < low {
        low
    } else {
        if value > high { high } else { value }
    }
}

pub use perceptual_color::{
    Color,
    Oklch,
    color,
    packed,
    rgba,
    unpack_lab,
    pack_lab,
    display_rgba,
    blend,
}

pub fn contrast(_ a: Color, _ b: Color) -> f32 {
    max(2.0 * abs(a.l - b.l), max(4.0 * abs(a.a - b.a), 4.0 * abs(a.b - b.b)))
}

/// Four-corner indices and fractional weights for bilinear interpolation.
/// Keeps active coordinate clamping separate from physical row stride (`1 << row_shift`).
pub struct BilinearTap {
    pub i00: u32,
    pub i10: u32,
    pub i01: u32,
    pub i11: u32,
    pub tx: f32,
    pub ty: f32,
}

impl Copy for BilinearTap {}

pub fn bilinear_tap(_ x: f32, _ y: f32, _ max_coord: f32, _ row_shift: u32) -> BilinearTap {
    let u: f32 = clamp(x, 0.0, max_coord)
    let v: f32 = clamp(y, 0.0, max_coord)
    let fx: f32 = floor(u)
    let fy: f32 = floor(v)
    let x0: u32 = __bitcast<i32, u32>(to_i32(fx))
    let y0: u32 = __bitcast<i32, u32>(to_i32(fy))
    let x1: u32 = __bitcast<i32, u32>(to_i32(min(fx + 1.0, max_coord)))
    let y1: u32 = __bitcast<i32, u32>(to_i32(min(fy + 1.0, max_coord)))
    BilinearTap {
        i00: (y0 << row_shift) | x0,
        i10: (y0 << row_shift) | x1,
        i01: (y1 << row_shift) | x0,
        i11: (y1 << row_shift) | x1,
        tx: u - fx,
        ty: v - fy,
    }
}

pub fn lattice_tap(_ px: i32, _ py: i32, _ step: f32, _ max_coord: f32) -> BilinearTap {
    let fx: f32 = from_i32(px)
    let fy: f32 = from_i32(py)
    let lx: f32 = from_i32(to_i32(fx / step)) * step
    let ly: f32 = from_i32(to_i32(fy / step)) * step
    let x0: u32 = __bitcast<i32, u32>(to_i32(lx)) & 2047
    let y0: u32 = __bitcast<i32, u32>(to_i32(ly)) & 2047
    let x1: u32 = __bitcast<i32, u32>(to_i32(min(lx + step, max_coord))) & 2047
    let y1: u32 = __bitcast<i32, u32>(to_i32(min(ly + step, max_coord))) & 2047
    BilinearTap {
        i00: ((y0 << 11) | x0) & 4194303,
        i10: ((y0 << 11) | x1) & 4194303,
        i01: ((y1 << 11) | x0) & 4194303,
        i11: ((y1 << 11) | x1) & 4194303,
        tx: (fx - lx) / step,
        ty: (fy - ly) / step,
    }
}

pub fn blend_corners(
    _ c00: Color,
    _ c10: Color,
    _ c01: Color,
    _ c11: Color,
    _ tx: f32,
    _ ty: f32,
) -> Color {
    blend(blend(c00, c10, tx), blend(c01, c11, tx), ty)
}

// Adjacent taps avoid the comb pattern made by spreading a small kernel.
// q approximates exp(-1/(2*sigma^2)); the Gaussian weights then advance
// with two multiplies per tap. Each axis is normalized independently.
pub fn gaussian(
    _ image: OrbitBuffer<Color, 65536>,
    _ x: u32,
    _ y: u32,
    _ sigma: f32,
    _ vertical: bool,
) -> Color {
    let center: Color = image.load(index: (y << 8) | x)
    if sigma < 0.05 {
        return center
    }
    let width: f32 = min(sigma, 10.0)
    let radius: i32 = to_i32(width * 3.0 + 0.999)
    let mut q: f32 = 1.0 / (1.0 + 0.5 / (width * width * 256.0))
    let mut power: u32 = 0
    while power < 8 {
        q = q * q
        power = power + 1
    }
    let ratio: f32 = q * q
    let mut factor: f32 = q
    let mut weight: f32 = 1.0
    let mut total: f32 = 1.0
    let mut lightness: f32 = center.l
    let mut axis_a: f32 = center.a
    let mut b: f32 = center.b
    let xf: f32 = from_i32(__bitcast<u32, i32>(x))
    let yf: f32 = from_i32(__bitcast<u32, i32>(y))
    let mut tap: i32 = 1
    while tap <= radius {
        weight = weight * factor
        factor = factor * ratio
        let distance: f32 = from_i32(tap)
        let ax: u32 = if vertical {
            x
        } else {
            __bitcast<i32, u32>(to_i32(max(0.0, xf - distance)))
        }
        let bx: u32 = if vertical {
            x
        } else {
            __bitcast<i32, u32>(to_i32(min(255.0, xf + distance)))
        }
        let ay: u32 = if vertical {
            __bitcast<i32, u32>(to_i32(max(0.0, yf - distance)))
        } else {
            y
        }
        let by: u32 = if vertical {
            __bitcast<i32, u32>(to_i32(min(255.0, yf + distance)))
        } else {
            y
        }
        let a: Color = image.load(index: (ay << 8) | ax)
        let c: Color = image.load(index: (by << 8) | bx)
        lightness = lightness + (a.l + c.l) * weight
        axis_a = axis_a + (a.a + c.a) * weight
        b = b + (a.b + c.b) * weight
        total = total + 2.0 * weight
        tap = tap + 1
    }
    Color { l: lightness / total, a: axis_a / total, b: b / total }
}

pub fn sample(_ image: OrbitBuffer<Color, 65536>, _ x: f32, _ y: f32) -> Color {
    let tap: BilinearTap = bilinear_tap(x, y, 255.0, 8)
    blend_corners(
        image.load(index: tap.i00),
        image.load(index: tap.i10),
        image.load(index: tap.i01),
        image.load(index: tap.i11),
        tap.tx,
        tap.ty,
    )
}

pub fn sample_snapshot(
    _ image: OrbitBuffer<u32, 4194304>,
    _ x: f32,
    _ y: f32,
    _ side: f32,
) -> Color {
    let tap: BilinearTap = bilinear_tap(x, y, side - 1.0, 11)
    blend_corners(
        unpack_lab(image.load(index: tap.i00)),
        unpack_lab(image.load(index: tap.i10)),
        unpack_lab(image.load(index: tap.i01)),
        unpack_lab(image.load(index: tap.i11)),
        tap.tx,
        tap.ty,
    )
}
