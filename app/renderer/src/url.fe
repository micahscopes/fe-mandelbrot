use core::{BrowserPtr, BrowserString, Copy}
use core::default::Default
use core::ops::Eq
use std::text::Utf8View
use std::web::navigation::parse_location
use ingot::policy::{
    MandelbrotViewState,
    Camera,
    Coordinate,
    BackingRequest,
    initial_view,
    CENTER_X_MIN,
    CENTER_X_MAX,
    CENTER_Y_MIN,
    CENTER_Y_MAX,
    ZOOM_MIN,
    ZOOM_MAX,
}

use algebra::Complex
use precision::{from_quad, to_quad}
use ingot::interaction::GestureSession

extern {
    const fn __bitcast<From, To>(_: From) -> To
}

// Version 2 canonical URL fragment format (120 ASCII bytes):
// `#v1:<cx0>.<cx1>.<cx2>.<cx3>:<cy0>.<cy1>.<cy2>.<cy3>:<zoom>:<res>:<aa>`
// Version 2 appends `:<orientation-re>:<orientation-im>`; version 1 restores identity.
// Each field is an exact 8-digit lowercase hexadecimal IEEE-754 f32 word,
// preserving all finite bit patterns including signed zero (-0.0 = 0x80000000).
pub const URL_V1_ENCODED_LEN: u32 = 102
pub const URL_ENCODED_LEN: u32 = 120

pub const F32_ZERO_BITS: u32 = 0x00000000 // +0.0
pub const F32_NEG_ZERO_BITS: u32 = 0x80000000 // -0.0
pub const F32_ONE_BITS: u32 = 0x3f800000 // 1.0
pub const F32_RES_512_BITS: u32 = 0x44000000 // 512.0
pub const F32_RES_1024_BITS: u32 = 0x44800000 // 1024.0
pub const F32_RES_2048_BITS: u32 = 0x45000000 // 2048.0

/// Exact IEEE-754 bit words of a four-word expansion (`QuadFloat`).
pub struct QuadWordBits {
    pub w0: u32,
    pub w1: u32,
    pub w2: u32,
    pub w3: u32,
}

impl Copy for QuadWordBits {}
derive Eq for QuadWordBits
derive Default for QuadWordBits

impl QuadWordBits {
    pub fn expansion(self) -> precision::Expansion<4> {
        from_quad(
            __bitcast<u32, f32>(self.w0),
            __bitcast<u32, f32>(self.w1),
            __bitcast<u32, f32>(self.w2),
            __bitcast<u32, f32>(self.w3),
        )
    }
}

/// Meaningful user-facing view state persisted in the URL fragment (`#v1:...`).
/// Excludes transient clocks, drag flags, and derived magnification readouts.
pub struct PersistedView {
    pub center_x: QuadWordBits,
    pub center_y: QuadWordBits,
    pub zoom_bits: u32,
    pub res_bits: u32,
    pub antialias_bits: u32,
    pub orientation_re_bits: u32,
    pub orientation_im_bits: u32,
}

impl Copy for PersistedView {}
derive Eq for PersistedView
derive Default for PersistedView

/// Camera and parameter domain bounds derived from `ingot::policy`.
pub struct PersistedBounds {
    pub center_x_min_bits: u32,
    pub center_x_max_bits: u32,
    pub center_y_min_bits: u32,
    pub center_y_max_bits: u32,
    pub zoom_min_bits: u32,
    pub zoom_max_bits: u32,
}

impl Copy for PersistedBounds {}
derive Eq for PersistedBounds

pub struct DecodedPersistedView {
    pub view: PersistedView,
    pub valid: bool,
}

impl Copy for DecodedPersistedView {}
derive Eq for DecodedPersistedView

/// Generic surface location synchronization event lowered to `fe_surface_location_v1`.
pub use std::web::view::SurfaceLocationEvent

pub fn raw_f32_bits(_ value: f32) -> u32 {
    __bitcast<f32, u32>(value)
}

pub fn is_finite_f32_bits(_ raw: u32) -> bool {
    ((raw >> 23) & 255) != 255
}

fn unsigned_zero_bits(_ raw: u32) -> u32 {
    if (raw & 2147483647) == 0 {
        0
    } else {
        raw
    }
}

/// Sign-magnitude IEEE-754 numeric ordering on finite f32 bit patterns (`left <= right`),
/// treating `-0.0` and `+0.0` as numerically equal for range bounds while preserving raw bits elsewhere.
pub fn f32_bits_le(_ left: u32, _ right: u32) -> bool {
    let a: u32 = unsigned_zero_bits(left)
    let b: u32 = unsigned_zero_bits(right)
    let a_neg: bool = (a >> 31) != 0
    let b_neg: bool = (b >> 31) != 0
    if a_neg && !b_neg {
        return true
    }
    if !a_neg && b_neg {
        return false
    }
    if !a_neg && !b_neg {
        return a <= b
    }
    a >= b
}

pub fn f32_bits_in_range(_ value_bits: u32, _ min_bits: u32, _ max_bits: u32) -> bool {
    is_finite_f32_bits(value_bits)
        && f32_bits_le(min_bits, value_bits)
        && f32_bits_le(value_bits, max_bits)
}

/// Exact IEEE-754 binary32 non-overlapping pair condition (`round_to_nearest_even(hi + lo) == hi`):
/// `|lo| <= 0.5 * ulp(hi)` (with tie-to-even when `|lo| == 0.5 * ulp(hi)`).
pub fn f32_bits_non_overlapping(_ hi_bits: u32, _ lo_bits: u32) -> bool {
    let hi_mag: u32 = hi_bits & 2147483647
    let lo_mag: u32 = lo_bits & 2147483647
    if lo_mag == 0 {
        return true
    }
    if hi_mag == 0 {
        return false
    }
    let hi_exp: u32 = (hi_mag >> 23) & 255
    if hi_exp <= 1 {
        return false
    }
    let half_ulp_mag: u32 = if hi_exp > 24 {
        (hi_exp - 24) << 23
    } else {
        1 << (hi_exp - 2)
    }
    lo_mag < half_ulp_mag || (lo_mag == half_ulp_mag && (hi_bits & 1) == 0)
}

fn first_nonzero_is_negative(_ w1: u32, _ w2: u32, _ w3: u32) -> bool {
    if (w1 & 2147483647) != 0 {
        return (w1 >> 31) != 0
    }
    if (w2 & 2147483647) != 0 {
        return (w2 >> 31) != 0
    }
    if (w3 & 2147483647) != 0 {
        return (w3 >> 31) != 0
    }
    false
}

fn first_nonzero_is_positive(_ w1: u32, _ w2: u32, _ w3: u32) -> bool {
    if (w1 & 2147483647) != 0 {
        return (w1 >> 31) == 0
    }
    if (w2 & 2147483647) != 0 {
        return (w2 >> 31) == 0
    }
    if (w3 & 2147483647) != 0 {
        return (w3 >> 31) == 0
    }
    false
}

/// Derive camera domain bounds directly from `ingot::policy` constants.
pub fn policy_persisted_bounds() -> PersistedBounds {
    PersistedBounds {
        center_x_min_bits: raw_f32_bits(CENTER_X_MIN),
        center_x_max_bits: raw_f32_bits(CENTER_X_MAX),
        center_y_min_bits: raw_f32_bits(CENTER_Y_MIN),
        center_y_max_bits: raw_f32_bits(CENTER_Y_MAX),
        zoom_min_bits: raw_f32_bits(ZOOM_MIN),
        zoom_max_bits: raw_f32_bits(ZOOM_MAX),
    }
}

/// Derive the default persisted view directly from `policy::initial_view()`,
/// preserving the current backing resolution when valid.
pub fn default_persisted_view(_ current_res: f32) -> PersistedView {
    let mut base: PersistedView = PersistedView::from_state(initial_view())
    let current_res_bits: u32 = raw_f32_bits(current_res)
    if f32_bits_in_range(current_res_bits, F32_ONE_BITS, F32_RES_2048_BITS) {
        base.res_bits = current_res_bits
    } else {
        base.res_bits = F32_RES_512_BITS
    }
    base
}

impl PersistedView {
    pub fn from_state(_ state: MandelbrotViewState) -> Self {
        let (x0, x1, x2, x3) = to_quad(state.camera.center.re.value)
        let (y0, y1, y2, y3) = to_quad(state.camera.center.im.value)
        Self {
            center_x: QuadWordBits {
                w0: raw_f32_bits(x0),
                w1: raw_f32_bits(x1),
                w2: raw_f32_bits(x2),
                w3: raw_f32_bits(x3),
            },
            center_y: QuadWordBits {
                w0: raw_f32_bits(y0),
                w1: raw_f32_bits(y1),
                w2: raw_f32_bits(y2),
                w3: raw_f32_bits(y3),
            },
            zoom_bits: raw_f32_bits(state.camera.zoom),
            res_bits: raw_f32_bits(state.camera.res),
            antialias_bits: raw_f32_bits(state.antialias),
            orientation_re_bits: raw_f32_bits(state.camera.orientation.re),
            orientation_im_bits: raw_f32_bits(state.camera.orientation.im),
        }
    }

    pub fn apply_to(self, _ base: MandelbrotViewState) -> MandelbrotViewState {
        let zoom: f32 = __bitcast<u32, f32>(self.zoom_bits)
        let mut next: MandelbrotViewState = base
        next.camera = Camera {
            center: Complex {
                re: Coordinate { value: self.center_x.expansion() },
                im: Coordinate { value: self.center_y.expansion() },
            },
            zoom: zoom,
            res: __bitcast<u32, f32>(self.res_bits),
            orientation: Complex { re: __bitcast<u32, f32>(self.orientation_re_bits), im: __bitcast<u32, f32>(self.orientation_im_bits) },
        }
        next.gesture = GestureSession::empty()
        next.antialias = __bitcast<u32, f32>(self.antialias_bits)
        next.drag_active = 0.0
        next.magnification = 3.0 / zoom
        next
    }

    pub fn word(self, _ field: u32) -> u32 {
        match field {
            0 => self.center_x.w0
            1 => self.center_x.w1
            2 => self.center_x.w2
            3 => self.center_x.w3
            4 => self.center_y.w0
            5 => self.center_y.w1
            6 => self.center_y.w2
            7 => self.center_y.w3
            8 => self.zoom_bits
            9 => self.res_bits
            10 => self.antialias_bits
            11 => self.orientation_re_bits
            _ => self.orientation_im_bits
        }
    }

    pub fn with_word(self, _ field: u32, _ word: u32) -> Self {
        let mut out: Self = self
        match field {
            0 => { out.center_x.w0 = word }
            1 => { out.center_x.w1 = word }
            2 => { out.center_x.w2 = word }
            3 => { out.center_x.w3 = word }
            4 => { out.center_y.w0 = word }
            5 => { out.center_y.w1 = word }
            6 => { out.center_y.w2 = word }
            7 => { out.center_y.w3 = word }
            8 => { out.zoom_bits = word }
            9 => { out.res_bits = word }
            10 => { out.antialias_bits = word }
            11 => { out.orientation_re_bits = word }
            _ => { out.orientation_im_bits = word }
        }
        out
    }

    /// Denotation of the encoded `#v1:...` string as a pure function `index (0..102) -> u8`.
    pub fn encoded_byte(self, _ index: u32) -> u8 {
        if index < 4 {
            return expected_prefix_byte(index)
        }
        let rel: u32 = index - 4
        let field: u32 = rel / 9
        let slot: u32 = rel % 9
        if slot == 8 {
            return expected_separator(field)
        }
        let word: u32 = self.word(field)
        let shift: u32 = (7 - slot) * 4
        hex_digit(word >> shift)
    }
}

/// Validate the full canonical `Expansion<4>` contract within `[lower_bits, upper_bits]`:
/// 1. Every limb `w0..w3` is finite.
/// 2. The primary word `w0` lies within `[lower_bits, upper_bits]`.
/// 3. Adjacent words satisfy the Dekker/Priest non-overlapping rounding-error invariant:
///    `(w0 + w1) == w0`, `(w1 + w2) == w1`, and `(w2 + w3) == w2` in IEEE-754 binary32,
///    which prevents finite-but-huge low words from shifting `w0` or poisoning expansion math.
/// 4. At exact boundary endpoints (`w0 == lower_bits` or `w0 == upper_bits`), low words cannot
///    push the expansion sum outside `[lower_bits, upper_bits]`.
fn is_valid_quad(_ q: QuadWordBits, _ lower_bits: u32, _ upper_bits: u32) -> bool {
    if !f32_bits_in_range(q.w0, lower_bits, upper_bits)
        || !is_finite_f32_bits(q.w1)
        || !is_finite_f32_bits(q.w2)
        || !is_finite_f32_bits(q.w3)
    {
        return false
    }
    if !f32_bits_non_overlapping(q.w0, q.w1)
        || !f32_bits_non_overlapping(q.w1, q.w2)
        || !f32_bits_non_overlapping(q.w2, q.w3)
    {
        return false
    }
    let w0: u32 = unsigned_zero_bits(q.w0)
    if w0 == unsigned_zero_bits(lower_bits) && first_nonzero_is_negative(q.w1, q.w2, q.w3) {
        return false
    }
    if w0 == unsigned_zero_bits(upper_bits) && first_nonzero_is_positive(q.w1, q.w2, q.w3) {
        return false
    }
    true
}

/// Resolutions are positive whole pixel counts. Restricting the exponent
/// before building the fractional mask keeps every shift within u32 width.
fn is_whole_resolution(_ bits: u32) -> bool {
    let exponent: u32 = (bits >> 23) & 255
    if exponent < 127 || exponent > 138 { return false }
    let fractional_bits: u32 = 150 - exponent
    (bits & ((1 << fractional_bits) - 1)) == 0
}

pub fn is_valid_persisted_view(_ view: PersistedView, _ bounds: PersistedBounds) -> bool {
    is_valid_quad(view.center_x, bounds.center_x_min_bits, bounds.center_x_max_bits)
        && is_valid_quad(view.center_y, bounds.center_y_min_bits, bounds.center_y_max_bits)
        && f32_bits_in_range(view.zoom_bits, bounds.zoom_min_bits, bounds.zoom_max_bits)
        && f32_bits_in_range(view.res_bits, F32_ONE_BITS, F32_RES_2048_BITS)
        && is_whole_resolution(view.res_bits)
        && f32_bits_in_range(view.antialias_bits, F32_ZERO_BITS, F32_ONE_BITS)
        && valid_orientation(view.orientation_re_bits, view.orientation_im_bits)
}

/// Retain exact orientation bits on restore; rejecting invalid bases is safer
/// than silently renormalizing a saved view onto a different sample lattice.
fn valid_orientation(_ re_bits: u32, _ im_bits: u32) -> bool {
    if !is_finite_f32_bits(re_bits) || !is_finite_f32_bits(im_bits) { return false }
    let re: f32 = __bitcast<u32, f32>(re_bits)
    let im: f32 = __bitcast<u32, f32>(im_bits)
    let norm = re * re + im * im
    norm >= 0.99999 && norm <= 1.00001
}

fn expected_prefix_byte(_ index: u32) -> u8 {
    match index {
        0 => 35 // '#'
        1 => 118 // 'v'
        2 => 50 // '2'
        _ => 58 // ':'
    }
}

fn expected_separator(_ field: u32) -> u8 {
    if field == 0 || field == 1 || field == 2 || field == 4 || field == 5 || field == 6 {
        46 // '.'
    } else {
        58 // ':'
    }
}

fn hex_digit(_ nybble: u32) -> u8 {
    match nybble & 15 {
        0 => 48
        1 => 49
        2 => 50
        3 => 51
        4 => 52
        5 => 53
        6 => 54
        7 => 55
        8 => 56
        9 => 57
        10 => 97
        11 => 98
        12 => 99
        13 => 100
        14 => 101
        _ => 102
    }
}

fn parse_hex_nybble(_ byte: u8) -> u32 {
    if byte >= 48 && byte <= 57 {
        return (byte - 48) as u32
    }
    if byte >= 97 && byte <= 102 {
        return (byte - 87) as u32
    }
    if byte >= 65 && byte <= 70 {
        return (byte - 55) as u32
    }
    16
}

/// Pure streaming left-fold decoder for `#v1:...` URL fragments.
pub struct UrlDecodeState {
    pub view: PersistedView,
    pub current_word: u32,
    pub valid: bool,
    pub version: u32,
}

impl Copy for UrlDecodeState {}

impl UrlDecodeState {
    pub fn initial() -> Self {
        let mut view = PersistedView::default()
        view.orientation_re_bits = F32_ONE_BITS
        Self {
            version: 2,
            view: view,
            current_word: 0,
            valid: true,
        }
    }

    pub fn step(self, _ index: u32, _ byte: u8) -> Self {
        if !self.valid || index >= URL_ENCODED_LEN {
            return Self {
                version: self.version,
                view: self.view,
                current_word: 0,
                valid: false,
            }
        }
        if index == 2 {
            return Self { version: if byte == 49 { 1 } else { 2 }, view: self.view,
                current_word: 0, valid: byte == 49 || byte == 50 }
        }
        if index < 4 {
            return Self {
                version: self.version,
                view: self.view,
                current_word: 0,
                valid: byte == expected_prefix_byte(index),
            }
        }
        let rel: u32 = index - 4
        let field: u32 = rel / 9
        let slot: u32 = rel % 9
        if slot == 8 {
            return Self {
                version: self.version,
                view: self.view,
                current_word: 0,
                valid: byte == expected_separator(field),
            }
        }
        let nybble: u32 = parse_hex_nybble(byte)
        if nybble >= 16 {
            return Self {
                version: self.version,
                view: self.view,
                current_word: 0,
                valid: false,
            }
        }
        let base: u32 = if slot == 0 { 0 } else { self.current_word }
        let next_word: u32 = (base << 4) | nybble
        if slot == 7 {
            if !is_finite_f32_bits(next_word) {
                return Self {
                    version: self.version,
                    view: self.view,
                    current_word: 0,
                    valid: false,
                }
            }
            return Self {
                version: self.version,
                view: self.view.with_word(field, next_word),
                current_word: 0,
                valid: true,
            }
        }
        Self {
            version: self.version,
            view: self.view,
            current_word: next_word,
            valid: true,
        }
    }

    pub fn finish(
        self,
        _ len: u32,
        _ fallback: PersistedView,
        _ bounds: PersistedBounds,
    ) -> DecodedPersistedView {
        if !self.valid || len != (if self.version == 1 { URL_V1_ENCODED_LEN } else { URL_ENCODED_LEN })
            || !is_valid_persisted_view(self.view, bounds) {
            return DecodedPersistedView {
                view: fallback,
                valid: false,
            }
        }
        DecodedPersistedView {
            view: self.view,
            valid: true,
        }
    }
}

pub fn roundtrip_persisted_view(
    _ view: PersistedView,
    _ fallback: PersistedView,
    _ bounds: PersistedBounds,
) -> DecodedPersistedView {
    let mut decoder: UrlDecodeState = UrlDecodeState::initial()
    let mut i: u32 = 0
    while i < URL_ENCODED_LEN {
        decoder = decoder.step(i, view.encoded_byte(i))
        i = i + 1
    }
    decoder.finish(URL_ENCODED_LEN, fallback, bounds)
}

pub fn roundtrip_with_mutated_byte(
    _ view: PersistedView,
    _ mutate_index: u32,
    _ mutate_byte: u8,
    _ len: u32,
    _ fallback: PersistedView,
    _ bounds: PersistedBounds,
) -> DecodedPersistedView {
    let mut decoder: UrlDecodeState = UrlDecodeState::initial()
    let mut i: u32 = 0
    while i < len {
        let b: u8 = if i == mutate_index {
            mutate_byte
        } else {
            if i < URL_ENCODED_LEN { view.encoded_byte(i) } else { 48 }
        }
        decoder = decoder.step(i, b)
        i = i + 1
    }
    decoder.finish(len, fallback, bounds)
}

fn decode_hash_view(
    _ hash: Utf8View,
    _ fallback: PersistedView,
    _ bounds: PersistedBounds,
) -> DecodedPersistedView {
    let traced_len = URL_ENCODED_LEN - 1 + ingot::trace::TRACE_SUFFIX_LEN
    let mut length = hash.len()
    if length == traced_len {
        let start = URL_ENCODED_LEN - 1
        if hash.byte(index: start) != 126 || hash.byte(index: start + 1) != 103
            || hash.byte(index: start + 2) != 58 {
            return DecodedPersistedView { view: fallback, valid: false }
        }
        let mut i: u32 = 3
        while i < ingot::trace::TRACE_SUFFIX_LEN {
            let byte = hash.byte(index: start + i)
            let valid = if (i - 3) % 9 == 8 { byte == 46 }
                else { (byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102) }
            if !valid { return DecodedPersistedView { view: fallback, valid: false } }
            i += 1
        }
        length = URL_ENCODED_LEN - 1
    }
    if length != URL_V1_ENCODED_LEN - 1 && length != URL_ENCODED_LEN - 1 {
        return DecodedPersistedView { view: fallback, valid: false }
    }
    let mut decoder: UrlDecodeState = UrlDecodeState::initial().step(0, 35)
    let mut i: u32 = 0
    while i < length {
        decoder = decoder.step(i + 1, hash.byte(index: i))
        i = i + 1
    }
    decoder.finish(length + 1, fallback, bounds)
}

fn write_u32_cell(address: u32, value: u32) {
    let cell: BrowserPtr<u32> = BrowserPtr::from_u32(address)
    cell.write(value)
}

fn write_u8_cell(address: u32, value: u8) {
    let cell: BrowserPtr<u8> = BrowserPtr::from_u32(address)
    cell.write(value)
}

/// Synchronize resident Mandelbrot view state with the `#v1:...` URL fragment and emit
/// the canonical `#v1:...` fragment into `event.out_ptr`.
/// Only the URL hash fragment is owned by view persistence; any query parameters on the URL
/// are ignored during decoding and preserved untouched by the host transport.
pub fn sync_url_state(
    _ state: MandelbrotViewState,
    _ event: own SurfaceLocationEvent,
) -> MandelbrotViewState {
    let mut next_state: MandelbrotViewState = state
    if event.apply_input {
        next_state.backing = BackingRequest::automatic()
        let fallback: PersistedView = default_persisted_view(state.camera.res)
        let bounds: PersistedBounds = policy_persisted_bounds()
        if event.input_len == 0 || event.input_ptr == 0 {
            next_state = fallback.apply_to(next_state)
        } else {
            let location = parse_location(BrowserString {
                ptr: event.input_ptr,
                len: event.input_len,
            })
            if !location.valid {
                next_state = fallback.apply_to(next_state)
            } else {
                let trace = location.query.single([116, 114, 97, 99, 101])
                next_state.trace.enabled = trace.valid && trace.present
                    && trace.value.equals_literal([49])
                let hash: Utf8View = location.hash.view()
                if hash.is_empty() {
                    next_state = fallback.apply_to(next_state)
                } else {
                    let decoded: DecodedPersistedView = decode_hash_view(hash, fallback, bounds)
                    next_state = decoded.view.apply_to(next_state)
                    next_state.backing = if decoded.valid {
                        BackingRequest::fixed(next_state.camera.res)
                    } else { BackingRequest::automatic() }
                }
            }
        }
    }
    let traced_len = URL_ENCODED_LEN + ingot::trace::TRACE_SUFFIX_LEN
    let length = if next_state.trace.enabled && event.out_cap >= traced_len {
        traced_len
    } else { URL_ENCODED_LEN }
    if event.out_ptr != 0 && event.out_cap >= length {
        let persisted: PersistedView = PersistedView::from_state(next_state)
        let mut i: u32 = 0
        while i < length {
            write_u8_cell(
                address: event.out_ptr + i,
                value: if i < URL_ENCODED_LEN { persisted.encoded_byte(i) }
                    else { next_state.trace.encoded_byte(i - URL_ENCODED_LEN) },
            )
            i = i + 1
        }
        if event.out_len_ptr != 0 {
            write_u32_cell(address: event.out_len_ptr, value: length)
        }
    } else {
        if event.out_len_ptr != 0 {
            write_u32_cell(address: event.out_len_ptr, value: 0)
        }
    }
    next_state
}
