            >
        )
    {
        reduce_composition_tree_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.fri_scratch, invocation)
    }

    fn initialize_fri_schedule(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<1, 1, 1>>)
    {
        initialize_fri_schedule_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            FRI_SCRATCH_WORDS,
            ProofFriSchedule,
        >(self.proof, self.fri_scratch, invocation)
    }

    fn fri_squeeze_challenge(self)
        uses (
            Prove<
                Threads<1, 1, 1>,
                Cycle<FriRoundCycle, Once<1, 1, 1>, FRI_ROUNDS>,
            >
        )
    {
        fri_squeeze_challenge_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.fri_scratch)
    }

    fn fri_fold_and_commit_leaves(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<HASH_WORKGROUP_THREADS, 1, 1>,
                Cycle<
                    FriRoundCycle,
                    Taper<Once<LDE_DISPATCH_X, 1, 1>, 1, 0, 0, 0>,
                    FRI_ROUNDS,
                >,
            >
        )
    {
        fri_fold_and_commit_leaves_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.fri_scratch, self.tamper, invocation)
    }

    fn fri_reduce_layer_tree(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<HASH_WORKGROUP_THREADS, 1, 1>,
                Cycle<
                    FriRoundCycle,
                    Taper<
                        Repeat<
                            COMPOSITION_TREE_DISPATCH_X,
                            1,
                            1,
                            {FRI_ROUNDS - 1},
                        >,
                        1,
                        0,
                        0,
                        1,
                    >,
                    FRI_ROUNDS,
                >,
            >
        )
    {
        fri_reduce_layer_tree_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            FRI_SCRATCH_WORDS,
        >(self.fri_scratch, invocation)
    }

    fn fri_bind_round_transcript(self)
        uses (
            Prove<
                Threads<1, 1, 1>,
                Cycle<FriRoundCycle, Once<1, 1, 1>, FRI_ROUNDS>,
            >
        )
    {
        fri_bind_round_transcript_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.fri_scratch)
    }

    fn sample_fri_queries(self)
        uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>)
    {
        sample_fri_queries_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
        >(self.proof)
    }

    fn extract_fri_queries(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<HASH_WORKGROUP_THREADS, 1, 1>,
                Once<QUERY_EXTRACT_DISPATCH_X, 1, 1>,
            >
        )
    {
        extract_fri_queries_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.fri_scratch, invocation)
    }

    fn finalize_proof_status(self)
        uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>)
    {
        finalize_proof_status_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.fri_scratch, self.tamper)
    }

    fn display(self, px: i32, py: i32) -> i32 uses (Display) {
        display_chunk<TRACE, LDE, FRI_ROUNDS, PROOF_WORDS>(
            self.proof,
            self.tamper,
            self.res,
            px,
            py,
        )
    }
}
