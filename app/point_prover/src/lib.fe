//! 1024-row batched WebGPU Mandelbrot chunk prover (`T = 1024`, `L = 4096`, `FRI_ROUNDS = 12`).
//!
//! Dynamic viewer capacity profile (bound 1023, fixed domain 1024).
//! Original reference example: `EscapesByQ12::new(1076, 12, 1024)` (`c = 1076/4096 + (12/4096)i`, escaping at
//! `terminal_step = 1002`, `trace_length = 1003`, `padded_length = 1024`).

use std::webgpu::{
    ComputeInvocation,
    ComputeSurface as Prove,
    CycledDispatch as Cycle,
    FixedDispatch as Once,
    FragmentSurface as Display,
    GpuProgram as Program,
    RepeatedDispatch as Repeat,
    ResponsiveBacking,
    StandardSurfaceRecovery,
    StorageBuffer as ProofTape,
    SurfaceQuality,
    SurfaceRecovery,
    TaperedDispatch as Taper,
    WebGpuBackend,
    Workgroup as Threads,
}
use std::conal::{Pair, RBin}
use std::web::view::{Extent, Param, Surface}
use fri_structure::FriSchedule
use mandelbrot_proof_chunk_webgpu::{
    AIR_COLUMN_COUNT,
    BabyBear,
    EXTENSION_WORDS,
    FRI_VARIANTS,
    HASH_WORKGROUP_THREADS,
    LDE_WORKGROUP_THREADS,
    chunk_query_evaluations,
    chunk_query_path_siblings,
    commit_auxiliary_lde_leaves_chunk,
    commit_composition_leaves_chunk,
    commit_main_lde_leaves_chunk,
    commit_trace_leaves_chunk,
    derive_air_transcript_and_challenge_chunk,
    derive_auxiliary_witness_chunk,
    derive_main_orbit_chunk_capacity,
    display_chunk,
    evaluate_air_first_row_chunk,
    evaluate_air_imaginary_quotient_chunk,
    evaluate_air_imaginary_square_chunk,
    evaluate_air_last_row_chunk,
    evaluate_air_local_step_chunk,
    evaluate_air_magnitude_terminal_chunk,
    evaluate_air_orbit_coordinates_chunk,
    evaluate_air_pair_rows_chunk,
    evaluate_air_real_quotient_chunk,
    evaluate_air_real_square_chunk,
    extract_fri_queries_chunk,
    finalize_proof_status_chunk,
    forward_batched_stage_grid_lane,
    fri_bind_round_transcript_chunk,
    fri_fold_and_commit_leaves_chunk,
    fri_reduce_layer_tree_chunk,
    fri_scratch_chunk_layout,
    fri_squeeze_challenge_chunk,
    initialize_fri_schedule_chunk,
    inverse_batched_stage_grid_lane,
    prepare_batched_coset_extension,
    prepare_batched_stage_grid,
    project_air_composition_chunk,
    proof_chunk_layout,
    reduce_air_lde_trees_chunk,
    reduce_composition_tree_chunk,
    reduce_trace_trees_chunk,
    sample_fri_queries_chunk,
    validate_batched_stage_grid,
}
use fmath::to_i32
use poseidon_baby_bear::DIGEST_FIELDS

use mandelbrot_proof_profile::{TRACE, LDE, TRACE_LOG, FRI_ROUNDS, BOUND as CLAIM_BOUND}

type ProofLdeInputPlan = RBin<Pair, TRACE_LOG>
type ProofLdeOutputPlan = RBin<Pair, FRI_ROUNDS>
type ProofFriSchedule = FriSchedule<1, FRI_ROUNDS>

const AIR_TRACE_WORDS: usize = AIR_COLUMN_COUNT * TRACE
const AIR_LDE_WORDS: usize = AIR_COLUMN_COUNT * LDE
const INPUT_LANES: usize = TRACE / 2
const OUTPUT_LANES: usize = LDE / 2
const INPUT_GRID_LANES: usize = AIR_COLUMN_COUNT * INPUT_LANES
const OUTPUT_GRID_LANES: usize = AIR_COLUMN_COUNT * OUTPUT_LANES
const INPUT_DISPATCH_X: usize = (INPUT_GRID_LANES + LDE_WORKGROUP_THREADS - 1)
    / LDE_WORKGROUP_THREADS
const OUTPUT_DISPATCH_X: usize = (OUTPUT_GRID_LANES + LDE_WORKGROUP_THREADS - 1)
    / LDE_WORKGROUP_THREADS

const TRACE_DISPATCH_X: usize = (TRACE + HASH_WORKGROUP_THREADS - 1) / HASH_WORKGROUP_THREADS
const TRACE_LEAF_DISPATCH_X: usize = (2 * TRACE + 1 + HASH_WORKGROUP_THREADS - 1)
    / HASH_WORKGROUP_THREADS
const LDE_DISPATCH_X: usize = (LDE + HASH_WORKGROUP_THREADS - 1) / HASH_WORKGROUP_THREADS
const COMPOSITION_TREE_DISPATCH_X: usize = (LDE / 2 + HASH_WORKGROUP_THREADS - 1)
    / HASH_WORKGROUP_THREADS
const QUERY_EXTRACT_WORDS: usize = FRI_VARIANTS
    * (chunk_query_evaluations(FRI_ROUNDS) * EXTENSION_WORDS
        + chunk_query_path_siblings(FRI_ROUNDS) * DIGEST_FIELDS)
const QUERY_EXTRACT_DISPATCH_X: usize = (QUERY_EXTRACT_WORDS + HASH_WORKGROUP_THREADS - 1)
    / HASH_WORKGROUP_THREADS

const PROOF_WORDS: usize = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS).total_words as usize
const FRI_SCRATCH_WORDS: usize = fri_scratch_chunk_layout(TRACE, LDE, FRI_ROUNDS)
    .total_words as usize

pub struct FriRoundCycle {}

struct ProofParams { tamper: Param, res: Param, point_re: Param, point_im: Param }

const fn proof_params() -> ProofParams {
    ProofParams {
        tamper: Param::range(min: 0.0, max: 1.0, init: 0.0),
        res: Param::extent_x(),
        point_re: Param::range(min: -8192.0, max: 4095.0, init: 1076.0),
        point_im: Param::range(min: -6144.0, max: 6143.0, init: 12.0),
    }
}

actor MandelbrotPointProver uses (
    Program<WebGpuBackend>,
    SurfaceQuality<ResponsiveBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
) {
    proof: ProofTape<u32, PROOF_WORDS>,
    lde_inverse_values: ProofTape<u32, AIR_TRACE_WORDS>,
    lde_inverse_progress: ProofTape<u32, INPUT_GRID_LANES>,
    lde_values: ProofTape<u32, AIR_LDE_WORDS>,
    lde_progress: ProofTape<u32, OUTPUT_GRID_LANES>,
    fri_scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    tamper: f32,
    res: f32,
    point_re: f32,
    point_im: f32,

    const fn view() -> Surface<ProofParams> {
        Surface {
            extent: Extent::square(512),
            params: proof_params(),
        }
    }

    fn derive_main_orbit(self) uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        derive_main_orbit_chunk_capacity<TRACE, LDE, FRI_ROUNDS, PROOF_WORDS>(
            self.proof,
            to_i32(self.point_re),
            to_i32(self.point_im),
            CLAIM_BOUND,
        )
    }

    fn derive_auxiliary_witness(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<TRACE_DISPATCH_X, 1, 1>>)
    {
        derive_auxiliary_witness_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.fri_scratch, invocation)
    }

    fn prepare_lde_inverse(self, invocation: ComputeInvocation)
        uses (Prove<Threads<LDE_WORKGROUP_THREADS, 1, 1>, Once<INPUT_DISPATCH_X, 1, 1>>)
    {
        let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
        prepare_batched_stage_grid<
            AIR_COLUMN_COUNT,
            TRACE,
            INPUT_LANES,
            PROOF_WORDS,
            AIR_TRACE_WORDS,
            INPUT_GRID_LANES,
        >(
            self.proof,
            layout.air_trace,
            self.lde_inverse_values,
            self.lde_inverse_progress,
            invocation,
        )
    }

    fn advance_lde_inverse(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<LDE_WORKGROUP_THREADS, 1, 1>,
                Repeat<INPUT_DISPATCH_X, 1, 1, TRACE_LOG>,
            >
        )
    {
        inverse_batched_stage_grid_lane<
            AIR_COLUMN_COUNT,
            TRACE,
            INPUT_LANES,
            AIR_TRACE_WORDS,
            INPUT_GRID_LANES,
            BabyBear,
            ProofLdeInputPlan,
        >(
            self.lde_inverse_values,
            self.lde_inverse_progress,
            invocation,
        )
    }

    fn prepare_lde_forward(self, invocation: ComputeInvocation)
        uses (Prove<Threads<LDE_WORKGROUP_THREADS, 1, 1>, Once<OUTPUT_DISPATCH_X, 1, 1>>)
    {
        let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
        let prepared = prepare_batched_coset_extension<
            AIR_COLUMN_COUNT,
            TRACE,
            LDE,
            INPUT_LANES,
            OUTPUT_LANES,
            AIR_TRACE_WORDS,
            INPUT_GRID_LANES,
            AIR_LDE_WORDS,
            OUTPUT_GRID_LANES,
            BabyBear,
            ProofLdeInputPlan,
            ProofLdeOutputPlan,
        >(
            self.lde_inverse_values,
            self.lde_inverse_progress,
            self.lde_values,
            self.lde_progress,
            BabyBear::from_u32(7),
            invocation,
        )
        if prepared.active && prepared.lane == 0 {
            self.proof.store(
                index: layout.air_lde_valid + prepared.batch,
                value: if prepared.valid { 1 } else { 0 },
            )
        }
    }

    fn advance_lde_forward(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<LDE_WORKGROUP_THREADS, 1, 1>,
                Repeat<OUTPUT_DISPATCH_X, 1, 1, FRI_ROUNDS>,
            >
        )
    {
        forward_batched_stage_grid_lane<
            AIR_COLUMN_COUNT,
            LDE,
            OUTPUT_LANES,
            AIR_LDE_WORDS,
            OUTPUT_GRID_LANES,
            BabyBear,
            ProofLdeOutputPlan,
        >(
            self.lde_values,
            self.lde_progress,
            invocation,
        )
    }

    fn finish_lde(self, invocation: ComputeInvocation)
        uses (Prove<Threads<LDE_WORKGROUP_THREADS, 1, 1>, Once<OUTPUT_DISPATCH_X, 1, 1>>)
    {
        let layout = proof_chunk_layout(TRACE, LDE, FRI_ROUNDS)
        let validated = validate_batched_stage_grid<
            AIR_COLUMN_COUNT,
            LDE,
            OUTPUT_LANES,
            OUTPUT_GRID_LANES,
            ProofLdeOutputPlan,
        >(
            self.lde_progress,
            invocation,
        )
        if validated.active {
            let valid =
                self.proof.load(index: layout.air_lde_valid + validated.batch) == 1
                    && validated.valid
            self.proof.store(
                index: layout.air_lde_valid + validated.batch,
                value: if valid { 1 } else { 0 },
            )
        }
    }

    fn commit_trace_leaves(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<HASH_WORKGROUP_THREADS, 1, 1>,
                Once<TRACE_LEAF_DISPATCH_X, 1, 1>,
            >
        )
    {
        commit_trace_leaves_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.fri_scratch, invocation)
    }

    fn reduce_trace_trees(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<HASH_WORKGROUP_THREADS, 1, 1>,
                Repeat<TRACE_DISPATCH_X, 1, 1, TRACE_LOG>,
            >
        )
    {
        reduce_trace_trees_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            TRACE_LOG,
            PROOF_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.fri_scratch, invocation)
    }

    fn commit_main_lde_leaves(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<LDE_DISPATCH_X, 1, 1>>)
    {
        commit_main_lde_leaves_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            AIR_LDE_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.lde_values, self.fri_scratch, invocation)
    }

    fn commit_auxiliary_lde_leaves(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<LDE_DISPATCH_X, 1, 1>>)
    {
        commit_auxiliary_lde_leaves_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            AIR_LDE_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.lde_values, self.fri_scratch, invocation)
    }

    fn reduce_air_lde_trees(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<HASH_WORKGROUP_THREADS, 1, 1>,
                Repeat<LDE_DISPATCH_X, 1, 1, FRI_ROUNDS>,
            >
        )
    {
        reduce_air_lde_trees_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.fri_scratch, invocation)
    }

    fn derive_air_transcript_and_challenge(self)
        uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>)
    {
        derive_air_transcript_and_challenge_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
        >(self.proof)
    }

    fn evaluate_air_local_step(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<LDE_DISPATCH_X, 1, 1>>)
    {
        evaluate_air_local_step_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            AIR_LDE_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.lde_values, self.fri_scratch, invocation)
    }

    fn evaluate_air_orbit_coordinates(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<LDE_DISPATCH_X, 1, 1>>)
    {
        evaluate_air_orbit_coordinates_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            AIR_LDE_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.lde_values, self.fri_scratch, invocation)
    }

    fn evaluate_air_real_square(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<LDE_DISPATCH_X, 1, 1>>)
    {
        evaluate_air_real_square_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            AIR_LDE_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.lde_values, self.fri_scratch, invocation)
    }

    fn evaluate_air_imaginary_square(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<LDE_DISPATCH_X, 1, 1>>)
    {
        evaluate_air_imaginary_square_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            AIR_LDE_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.lde_values, self.fri_scratch, invocation)
    }

    fn evaluate_air_real_quotient(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<LDE_DISPATCH_X, 1, 1>>)
    {
        evaluate_air_real_quotient_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            AIR_LDE_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.lde_values, self.fri_scratch, invocation)
    }

    fn evaluate_air_imaginary_quotient(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<LDE_DISPATCH_X, 1, 1>>)
    {
        evaluate_air_imaginary_quotient_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            AIR_LDE_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.lde_values, self.fri_scratch, invocation)
    }

    fn evaluate_air_magnitude_terminal(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<LDE_DISPATCH_X, 1, 1>>)
    {
        evaluate_air_magnitude_terminal_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            AIR_LDE_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.lde_values, self.fri_scratch, invocation)
    }

    fn evaluate_air_pair_rows(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<LDE_DISPATCH_X, 1, 1>>)
    {
        evaluate_air_pair_rows_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            AIR_LDE_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.lde_values, self.fri_scratch, invocation)
    }

    fn evaluate_air_first_row(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<LDE_DISPATCH_X, 1, 1>>)
    {
        evaluate_air_first_row_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            AIR_LDE_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.lde_values, self.fri_scratch, invocation)
    }

    fn evaluate_air_last_row(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<LDE_DISPATCH_X, 1, 1>>)
    {
