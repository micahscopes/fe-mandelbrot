            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            AIR_LDE_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.lde_values, self.fri_scratch, invocation)
    }

    fn project_air_composition(self, invocation: ComputeInvocation)
        uses (Prove<Threads<HASH_WORKGROUP_THREADS, 1, 1>, Once<LDE_DISPATCH_X, 1, 1>>)
    {
        project_air_composition_chunk<
            TRACE,
            LDE,
            FRI_ROUNDS,
            PROOF_WORDS,
            FRI_SCRATCH_WORDS,
        >(self.proof, self.fri_scratch, invocation)
    }

    fn commit_composition_leaves(self, invocation: ComputeInvocation)
